; ARC member writer. Static scratch makes these entries non-reentrant.
ARK_WRITE_CODE MACRO
ARK_BUILD_HEADER:
        LD A,(IX+AS_MEMBER+AM_METHOD)
        CP 2
        JR Z,ARW_METHOD_OK
        CP 4
        JR Z,ARW_METHOD_OK
        CP 8
        JR Z,ARW_METHOD_OK
        LD A,AS_UNSUPPORTED
        SCF
        RET
ARW_METHOD_OK:
        ; Validate canonical space-padded 8+3 before changing AS_ENTRY.
        PUSH IX
        POP DE
        LD HL,AS_MEMBER+AM_NAME
        ADD HL,DE
        LD B,8
        XOR A
        LD (ARW_BASE_END),A
        LD (ARW_BASE_LENGTH),A
        LD (ARW_DOT),A
ARW_BASE_CHECK:
        LD A,(HL)
        LD (ARW_CHAR),A
        INC HL
        CP ' '
        JR NZ,ARW_BASE_CHAR
        LD A,1
        LD (ARW_BASE_END),A
        JR ARW_BASE_NEXT
ARW_BASE_CHAR:
        LD A,(ARW_BASE_END)
        OR A
        JP NZ,ARW_BAD_NAME
        LD A,(ARW_CHAR)
        CALL ARW_CHECK_CHAR
        JP C,ARW_BAD_NAME
        LD A,(ARW_BASE_LENGTH)
        INC A
        LD (ARW_BASE_LENGTH),A
ARW_BASE_NEXT:
        DJNZ ARW_BASE_CHECK
        LD A,(ARW_BASE_LENGTH)
        OR A
        JP Z,ARW_BAD_NAME
        LD A,0
        LD (ARW_EXT_END),A
        LD B,3
ARW_EXT_CHECK:
        LD A,(HL)
        LD (ARW_CHAR),A
        INC HL
        CP ' '
        JR NZ,ARW_EXT_CHAR
        LD A,1
        LD (ARW_EXT_END),A
        JR ARW_EXT_NEXT
ARW_EXT_CHAR:
        LD A,(ARW_EXT_END)
        OR A
        JP NZ,ARW_BAD_NAME
        LD A,(ARW_CHAR)
        CALL ARW_CHECK_CHAR
        JP C,ARW_BAD_NAME
        LD A,1
        LD (ARW_DOT),A
ARW_EXT_NEXT:
        DJNZ ARW_EXT_CHECK
        ; Commit only after validation. The zero-fill supplies the name NUL,
        ; zero-initialized metadata defaults and reserved header bytes.
        PUSH IX
        POP HL
        LD DE,AS_ENTRY
        ADD HL,DE
        LD B,ARW_HEADER_SIZE
        XOR A
ARW_CLEAR_HEADER:
        LD (HL),A
        INC HL
        DJNZ ARW_CLEAR_HEADER
        LD (IX+AS_ENTRY),01AH
        LD A,(IX+AS_MEMBER+AM_METHOD)
        LD (IX+AS_ENTRY+1),A
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_NAME
        ADD HL,DE
        PUSH IX
        POP DE
        LD BC,AS_ENTRY+2
        EX DE,HL
        ADD HL,BC
        EX DE,HL
        LD B,8
ARW_COPY_BASE:
        LD A,(HL)
        CP ' '
        JR Z,ARW_COPY_EXT_START
        CALL ARW_UPPER
        LD (DE),A
        INC DE
        INC HL
        DJNZ ARW_COPY_BASE
ARW_COPY_EXT_START:
        LD A,(IX+AS_MEMBER+AM_NAME+8)
        CP ' '
        JR Z,ARW_COPY_DONE
        LD A,'.'
        LD (DE),A
        INC DE
        PUSH IX
        POP HL
        LD BC,AS_MEMBER+AM_NAME+8
        ADD HL,BC
        LD B,3
ARW_COPY_EXT:
        LD A,(HL)
        CP ' '
        JR Z,ARW_COPY_DONE
        CALL ARW_UPPER
        LD (DE),A
        INC DE
        INC HL
        DJNZ ARW_COPY_EXT
ARW_COPY_DONE:
        ; ARC new-format header fields: size, DOS date/time, CRC, logical size.
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_STORED
        ADD HL,DE
        PUSH HL
        PUSH IX
        POP HL
        LD DE,AS_ENTRY+15
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,4
        LDIR
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_DATES
        ADD HL,DE
        PUSH HL
        PUSH IX
        POP HL
        LD DE,AS_ENTRY+19
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,4
        LDIR
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_CRC
        ADD HL,DE
        PUSH HL
        PUSH IX
        POP HL
        LD DE,AS_ENTRY+23
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,2
        LDIR
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_LENGTH
        ADD HL,DE
        PUSH HL
        PUSH IX
        POP HL
        LD DE,AS_ENTRY+25
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,4
        LDIR
        LD A,ARW_HEADER_SIZE
        OR A
        RET
; Stream one prepared member. The source and output callbacks transfer the
; exact AS_COUNT bytes and report AS_ACTUAL; the caller handles disk records.
ARK_WRITE_MEMBER:
        LD A,(IX+AS_READ)
        OR (IX+AS_READ+1)
        JP Z,ARW_CONFIG
        LD A,(IX+AS_BUFFER)
        OR (IX+AS_BUFFER+1)
        JP Z,ARW_CONFIG
        LD L,(IX+AS_BUFFER)
        LD H,(IX+AS_BUFFER+1)
        LD (ARW_BUFFER_PTR),HL
        LD A,(IX+AS_MEMBER+AM_WRITE_CB)
        OR (IX+AS_MEMBER+AM_WRITE_CB+1)
        JP Z,ARW_CONFIG
        CALL ARK_BUILD_HEADER
        RET C
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        LD HL,AS_ENTRY
        PUSH IX
        POP DE
        ADD HL,DE
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        LD (IX+AS_COUNT),ARW_HEADER_SIZE
        LD (IX+AS_COUNT+1),0
        CALL ARW_CALL_WRITE
        JP C,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL)
        CP ARW_HEADER_SIZE
        JP NZ,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL+1)
        OR A
        JP NZ,ARW_OUTPUT_ERROR
        CALL ARW_ADVANCE_OUTPUT
        JP C,ARW_RANGE
        LD HL,AS_MEMBER+AM_STORED
        PUSH IX
        POP DE
        ADD HL,DE
        PUSH HL
        LD DE,AS_MEMBER+AM_REMAIN
        PUSH IX
        POP HL
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,4
        LDIR
        LD HL,AS_MEMBER+AM_OFFSET
        PUSH IX
        POP DE
        ADD HL,DE
        PUSH HL
        LD DE,AS_MEMBER+AM_SOURCE_OFFSET
        PUSH IX
        POP HL
        ADD HL,DE
        EX DE,HL
        POP HL
        LD BC,4
        LDIR
ARW_MEMBER_LOOP:
        LD A,(IX+AS_MEMBER+AM_REMAIN)
        OR (IX+AS_MEMBER+AM_REMAIN+1)
        OR (IX+AS_MEMBER+AM_REMAIN+2)
        OR (IX+AS_MEMBER+AM_REMAIN+3)
        JP Z,ARW_MEMBER_DONE
        ; Min(remaining,128), represented in the public 16-bit count.
        LD A,(IX+AS_MEMBER+AM_REMAIN+2)
        OR (IX+AS_MEMBER+AM_REMAIN+3)
        JR NZ,ARW_MEMBER_FULL
        LD A,(IX+AS_MEMBER+AM_REMAIN+1)
        OR A
        JR NZ,ARW_MEMBER_FULL
        LD A,(IX+AS_MEMBER+AM_REMAIN)
        CP 129
        JR NC,ARW_MEMBER_FULL
        LD (IX+AS_COUNT),A
        JR ARW_MEMBER_COUNT_READY
ARW_MEMBER_FULL:
        LD A,128
        LD (IX+AS_COUNT),A
ARW_MEMBER_COUNT_READY:
        XOR A
        LD (IX+AS_COUNT+1),A
        LD L,(IX+AS_MEMBER+AM_SOURCE_OFFSET)
        LD H,(IX+AS_MEMBER+AM_SOURCE_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_SOURCE_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_SOURCE_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        LD HL,(ARW_BUFFER_PTR)
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        CALL ARW_CALL_READ
        JP C,ARW_READ_ERROR
        LD A,(IX+AS_ACTUAL)
        CP (IX+AS_COUNT)
        JP NZ,ARW_READ_SHORT
        LD A,(IX+AS_ACTUAL+1)
        CP (IX+AS_COUNT+1)
        JP NZ,ARW_READ_SHORT
        CALL ARW_ADVANCE_SOURCE
        JP C,ARW_RANGE
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        LD HL,(ARW_BUFFER_PTR)
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        CALL ARW_CALL_WRITE
        JP C,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL)
        CP (IX+AS_COUNT)
        JP NZ,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL+1)
        CP (IX+AS_COUNT+1)
        JP NZ,ARW_OUTPUT_ERROR
        CALL ARW_ADVANCE_OUTPUT
        JP C,ARW_RANGE
        CALL ARW_SUBTRACT_REMAIN
        JP C,ARW_RANGE
        JP ARW_MEMBER_LOOP
ARW_MEMBER_DONE:
        XOR A
        RET
; Copy the current ARC member without interpreting its encoded method. The
; reader has already validated the header, name, and complete stored extent.
ARK_COPY_MEMBER:
        LD A,(IX+AS_PHASE)
        CP AS_SELECTED
        JP NZ,ARW_CONFIG
        LD A,(IX+AS_BUFFER)
        OR (IX+AS_BUFFER+1)
        JP Z,ARW_CONFIG
        LD A,(IX+AS_MEMBER+AM_WRITE_CB)
        OR (IX+AS_MEMBER+AM_WRITE_CB+1)
        JP Z,ARW_CONFIG
        LD L,(IX+AS_BUFFER)
        LD H,(IX+AS_BUFFER+1)
        LD (ARW_BUFFER_PTR),HL
        LD A,(IX+AS_ENTRY+1)
        CP 1
        LD A,ARW_HEADER_SIZE
        JR NZ,ARW_COPY_HEADER_READY
        LD A,25
ARW_COPY_HEADER_READY:
        LD (ARW_COPY_HEADER),A
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        PUSH IX
        POP HL
        LD DE,AS_ENTRY
        ADD HL,DE
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        LD A,(ARW_COPY_HEADER)
        LD (IX+AS_COUNT),A
        XOR A
        LD (IX+AS_COUNT+1),A
        CALL ARW_CALL_WRITE
        JP C,ARW_COPY_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL)
        CP (IX+AS_COUNT)
        JP NZ,ARW_COPY_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL+1)
        OR A
        JP NZ,ARW_COPY_OUTPUT_ERROR
        CALL ARW_ADVANCE_OUTPUT
        JP C,ARW_COPY_RANGE
ARW_COPY_LOOP:
        LD A,(IX+AS_LEFT)
        OR (IX+AS_LEFT+1)
        OR (IX+AS_LEFT+2)
        OR (IX+AS_LEFT+3)
        JR Z,ARW_RETAIN_DONE
        LD DE,(ARW_BUFFER_PTR)
        LD BC,128
        CALL ARK_RAW
        JP C,ARW_COPY_READER_ERROR
        LD A,B
        OR C
        JP Z,ARW_COPY_TRUNC
        LD (IX+AS_COUNT),C
        LD (IX+AS_COUNT+1),B
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        CALL ARW_CALL_WRITE
        JP C,ARW_COPY_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL)
        CP (IX+AS_COUNT)
        JP NZ,ARW_COPY_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL+1)
        CP (IX+AS_COUNT+1)
        JP NZ,ARW_COPY_OUTPUT_ERROR
        CALL ARW_ADVANCE_OUTPUT
        JP C,ARW_COPY_RANGE
        JP ARW_COPY_LOOP
ARW_RETAIN_DONE:
        XOR A
        JR ARW_COPY_RETURN
ARW_COPY_READER_ERROR:
        ; Keep the reader's format/I/O/cancel status for caller recovery.
        JR ARW_COPY_RETURN
ARW_COPY_TRUNC:
        LD A,AS_TRUNC
        SCF
        JR ARW_COPY_RETURN
ARW_COPY_OUTPUT_ERROR:
        LD A,AS_OUTPUT
        SCF
        JR ARW_COPY_RETURN
ARW_COPY_RANGE:
        LD A,AS_RANGE
        SCF
ARW_COPY_RETURN:
        LD HL,(ARW_BUFFER_PTR)
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        RET
; Append the ARC 1Ah/00h terminator at the current output offset.
ARK_WRITE_END:
        LD A,(IX+AS_MEMBER+AM_WRITE_CB)
        OR (IX+AS_MEMBER+AM_WRITE_CB+1)
        JP Z,ARW_CONFIG
        LD (IX+AS_ENTRY),01AH
        XOR A
        LD (IX+AS_ENTRY+1),A
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
        LD (IX+AS_OFFSET),L
        LD (IX+AS_OFFSET+1),H
        LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+2)
        LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+3)
        LD (IX+AS_OFFSET+2),L
        LD (IX+AS_OFFSET+3),H
        PUSH IX
        POP HL
        LD DE,AS_ENTRY
        ADD HL,DE
        LD (IX+AS_BUFFER),L
        LD (IX+AS_BUFFER+1),H
        LD (IX+AS_COUNT),2
        LD (IX+AS_COUNT+1),0
        CALL ARW_CALL_WRITE
        JP C,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL)
        CP 2
        JP NZ,ARW_OUTPUT_ERROR
        LD A,(IX+AS_ACTUAL+1)
        OR A
        JP NZ,ARW_OUTPUT_ERROR
        CALL ARW_ADVANCE_OUTPUT
        JP C,ARW_RANGE
        XOR A
        RET
ARW_CALL_READ:
        PUSH IX
        POP HL
        LD DE,AS_READ
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        JP (HL)
ARW_CALL_WRITE:
        PUSH IX
        POP HL
        LD DE,AS_MEMBER+AM_WRITE_CB
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        JP (HL)
ARW_ADVANCE_SOURCE:
        LD HL,AS_MEMBER+AM_SOURCE_OFFSET
        PUSH IX
        POP DE
        ADD HL,DE
        JR ARW_ADVANCE32
ARW_ADVANCE_OUTPUT:
        LD HL,AS_MEMBER+AM_OUTPUT_OFFSET
        PUSH IX
        POP DE
        ADD HL,DE
ARW_ADVANCE32:
        LD A,(IX+AS_COUNT)
        ADD A,(HL)
        LD (HL),A
        INC HL
        LD A,(IX+AS_COUNT+1)
        ADC A,(HL)
        LD (HL),A
        INC HL
        LD A,0
        ADC A,(HL)
        LD (HL),A
        INC HL
        LD A,0
        ADC A,(HL)
        LD (HL),A
        JR C,ARW_RANGE
        OR A
        RET
ARW_SUBTRACT_REMAIN:
        LD HL,AS_MEMBER+AM_REMAIN
        PUSH IX
        POP DE
        ADD HL,DE
        LD A,(IX+AS_COUNT)
        LD B,A
        LD A,(HL)
        SUB B
        LD (HL),A
        INC HL
        LD A,(IX+AS_COUNT+1)
        LD B,A
        LD A,(HL)
        SBC A,B
        LD (HL),A
        INC HL
        LD A,(HL)
        SBC A,0
        LD (HL),A
        INC HL
        LD A,(HL)
        SBC A,0
        LD (HL),A
        RET NC
        JP ARW_RANGE
ARW_CONFIG:
        LD A,AS_CONFIG
        SCF
        RET
ARW_READ_ERROR:
        LD A,AS_IO
        SCF
        RET
ARW_READ_SHORT:
        LD A,AS_TRUNC
        SCF
        RET
ARW_OUTPUT_ERROR:
        LD A,AS_OUTPUT
        SCF
        RET
ARW_RANGE:
        LD A,AS_RANGE
        SCF
        RET
ARW_BAD_NAME:
        LD A,AS_FORMAT
        SCF
        RET
; A=one canonical filename character. AF/HL/BC are scratch.
ARW_CHECK_CHAR:
        CP 21H
        JR C,ARW_CHAR_BAD
        CP 7FH
        JR NC,ARW_CHAR_BAD
        CP '.'
        JR Z,ARW_CHAR_BAD
        PUSH HL
        PUSH BC
        LD HL,ARW_BAD_CHARS
        LD B,14
ARW_CHAR_SCAN:
        CP (HL)
        JR Z,ARW_CHAR_REJECT
        INC HL
        DJNZ ARW_CHAR_SCAN
        POP BC
        POP HL
        OR A
        RET
ARW_CHAR_REJECT:
        POP BC
        POP HL
ARW_CHAR_BAD:
        SCF
        RET
ARW_UPPER:
        CP 'a'
        RET C
        CP 'z'+1
        RET NC
        SUB 32
        RET
ARW_BAD_CHARS: DB '<>,;:=?*[]/\|"'
ARW_BASE_END: DB 0
ARW_BASE_LENGTH: DB 0
ARW_EXT_END: DB 0
ARW_DOT: DB 0
ARW_CHAR: DB 0
ARW_BUFFER_PTR: DW 0
ARW_COPY_HEADER: DB 0
        ENDM
