; ********************************************************************************
; *                   BetterCP/M Disk and CPX Control Overlay                    *
; *                                                                              *
; * Resident control overlay executed from the idle physical-sector buffer. Disk *
; * configuration, formatting, CPX control, and profile queries must avoid any   *
; * filesystem sector read that would overwrite the executing overlay.           *
; ********************************************************************************

        INCLUDE layout.inc
        INCLUDE disklinks.inc
        INCLUDE cpxlinks.inc
        INCLUDE bioslinks.inc
        INCLUDE hardware.inc
        CSEG
        .PHASE  LY_CFG
        JP CF_PHYS
        JP CF_LOG
        JP CF_FORMAT
        JP BF_CPXCTL
        JP CF_GETPH
        JP CF_GETLOG
        JP CF_FAST

DC_PHBAD:                               ; reject invalid physical profile
        JP DC_INVALID

; ================================================================================
; =                         Disk Configuration Services                          =
; =                                                                              =
; = Validates and commits physical and logical disk-profile changes while the    =
; = overlay occupies the otherwise idle physical-sector buffer.                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Physical Profile Update
; -------------------------------------------------------------------------------

CF_PHYS:                                ; set physical disk profile
        LD A,(IX+0)
        CALL DC_PHY
        JR NC,DC_PHBAD
        LD (DC_DEST),HL
        LD A,(IX+1)
        CP 5
        JR Z,DC_INCHOK
        CP 8
        JP NZ,DC_UNSUPPORTED

DC_INCHOK:                              ; accept physical density code
        LD A,(IX+2)
        DEC A
        CP 80
        JR NC,DC_PHBAD
        LD A,(IX+3)
        DEC A
        CP 2
        JR NC,DC_PHBAD
        LD A,(IX+4)
        CP 4
        JR NC,DC_PHBAD
        LD A,(IX+5)
        CP 17
        JR NC,DC_PHBAD
        PUSH IX
        POP HL
        INC HL
        LD DE,(DC_DEST)
        LD BC,6
        LDIR
        JP CF_COMMIT

; -------------------------------------------------------------------------------
; Logical Profile Update
; -------------------------------------------------------------------------------

CF_LOG:                                 ; set logical disk profile
        LD A,(IX+0)
        CALL DC_LOG
        JP NC,DC_INVALID
        LD DE,16
        ADD HL,DE
        LD (DC_DEST),HL
        LD A,(IX+1)
        CP 0FFH
        JR NZ,DC_VALIDATE
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD HL,(DC_DEST)
        LD (HL),0FFH
        CALL DC_RESET
        JP DC_OK

; -------------------------------------------------------------------------------
; Logical Profile Validation
; -------------------------------------------------------------------------------

DC_VALIDATE:                            ; validate logical disk profile
        CALL DC_PHY
        JP NC,DC_INVALID
        LD (DC_PHYADDR),HL
        ; A is the fixed bootstrap filesystem until system-disk migration exists.
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD A,(IX+17)
        OR A
        JP Z,DC_INVALID
        CP 81
        JP NC,DC_INVALID
        INC HL
        LD A,(HL)
        CP (IX+17)
        JP C,DC_UNSUPPORTED
        INC HL
        LD A,(IX+20)
        AND 060H
        CP 060H
        JP Z,DC_UNSUPPORTED
        BIT 6,(IX+20)
        JR Z,DC_ONESIDE
        LD A,(HL)
        CP 2
        JP NZ,DC_UNSUPPORTED

DC_ONESIDE:                             ; validate single-sided profile
        LD A,(IX+20)
        AND 020H                        ; reserved for the bootstrap cylinder profile
        JP NZ,DC_UNSUPPORTED
        LD A,(IX+20)
        AND 00FH
        JR Z,DC_FDFOK
        PUSH IX
        LD BC,000B7H                  ; production FDF Function 183, operation 0
        CALL 5
        POP IX
        LD DE,04644H
        OR A
        SBC HL,DE
        JP NZ,DC_UNSUPPORTED

DC_FDFOK:                               ; accept FDF capability
        LD A,(IX+18)
        OR A
        JP Z,DC_INVALID
        CP 33
        JP NC,DC_UNSUPPORTED
        LD B,A
        LD A,(IX+19)
        CP 4
        JP NC,DC_UNSUPPORTED
        LD C,A
        LD HL,0
        LD L,B
        OR A
        JR Z,DC_SPT

DC_SPTSHIFT:                            ; scale sectors per track
        ADD HL,HL
        DEC A
        JR NZ,DC_SPTSHIFT

DC_SPT:                                 ; validate logical sector geometry
        LD A,(IX+3)
        CP H
        JR NZ,DC_MIXED
        LD A,(IX+2)
        CP L
        JR NZ,DC_MIXED
        LD (IX+53),0                    ; uniform geometry uses no optional size map
        JR DC_GEOMOK

; -------------------------------------------------------------------------------
; Mixed-Sector Geometry
; -------------------------------------------------------------------------------

DC_MIXED:                               ; validate mixed-sector geometry
  ; Validate a packed per-sector size map, or expand the old MM SUPER form.
        LD BC,002B7H                  ; production FDF Function 183, operation 2
        CALL 5
        LD DE,04644H
        OR A
        SBC HL,DE
        JP NZ,DC_INVALID

DC_GEOMOK:                              ; continue validated geometry
        ; Up to 512 entries; BDOS walks records through one sector buffer.
        LD A,(IX+10)
        CP 2
        JP NC,DC_UNSUPPORTED
        LD A,(IX+8)
        CP 4
        JP NC,DC_UNSUPPORTED
        LD A,(IX+14)
        OR A
        JP NZ,DC_INVALID
        LD A,(IX+13)
        CP 33
        JP NC,DC_UNSUPPORTED
        LD A,(IX+4)
        CP 3
        JP C,DC_INVALID
        CP 8
        JP NC,DC_INVALID
        LD B,A
        LD A,1

DC_BLMSH:                               ; derive block mask
        ADD A,A
        DJNZ DC_BLMSH
        DEC A
        CP (IX+5)
        JP NZ,DC_INVALID
        ; Directory records occupy the first allocation blocks.
        LD L,(IX+9)
        LD H,(IX+10)
        INC HL
        SRL H
        RR L
        SRL H
        RR L
        LD A,L
        LD C,A
        LD A,(IX+5)
        INC A
        LD B,A
        LD A,C
        LD C,0

; -------------------------------------------------------------------------------
; Directory Allocation Mask
; -------------------------------------------------------------------------------

DC_DIRBL:                               ; derive directory allocation mask
        SET 7,C
        SUB B
        JR C,DC_DIRMASK
        JR Z,DC_DIRMASK
        SRL C
        JR DC_DIRBL

DC_DIRMASK:                             ; validate directory allocation mask
        LD A,(IX+11)
        AND C
        CP C
        JP NZ,DC_INVALID
        ; EXM follows allocation-entry width and block size.
        LD A,(IX+4)
        SUB 3
        LD B,A
        LD A,(IX+8)
        OR A
        LD A,B
        JR Z,DC_EXMSZ
        OR A
        JP Z,DC_INVALID
        DEC A

DC_EXMSZ:                               ; derive extent mask size
        LD B,A
        LD A,1
        INC B

DC_EXMSH:                               ; build extent mask
        DJNZ DC_EXMADD
        JR DC_EXMDONE

DC_EXMADD:                              ; extend extent mask
        ADD A,A
        JR DC_EXMSH

DC_EXMDONE:                             ; validate extent mask
        DEC A
        CP (IX+6)
        JP C,DC_INVALID
        LD A,(IX+6)
        INC A
        AND (IX+6)                      ; a smaller 2^n-1 EXM is valid (part-used map)
        JP NZ,DC_INVALID
        ; Allocation cannot extend past the available logical records.
        LD L,(IX+17)
        LD H,0
        LD A,(IX+20)
        AND 060H
        CP 040H
        JR NZ,DC_CAPTRK
        ADD HL,HL

; -------------------------------------------------------------------------------
; Media Capacity Validation
; -------------------------------------------------------------------------------

DC_CAPTRK:                              ; compute usable track count
        LD E,(IX+15)
        LD D,(IX+16)
        OR A
        SBC HL,DE
        JP C,DC_INVALID
        LD A,H
        OR L
        JP Z,DC_INVALID
        LD B,L
        LD E,(IX+2)
        LD D,(IX+3)
        LD HL,0

DC_CAPMUL:                              ; compute media record capacity
        ADD HL,DE
        DJNZ DC_CAPMUL
        LD (DC_CAP),HL
        LD L,(IX+7)
        LD H,(IX+8)
        INC HL
        LD B,(IX+4)

DC_ALSHIFT:                             ; compute allocation capacity
        ADD HL,HL
        JP C,DC_INVALID
        DJNZ DC_ALSHIFT
        LD DE,(DC_CAP)
        OR A
        SBC HL,DE
        JR Z,DC_CAPOK
        JP NC,DC_INVALID

DC_CAPOK:                               ; accept allocation capacity
        ; Validate sector IDs are unique (arbitrary bases are supported).
        PUSH IX
        POP HL
        LD DE,21
        ADD HL,DE
        LD B,(IX+18)

; -------------------------------------------------------------------------------
; Sector-ID Validation
; -------------------------------------------------------------------------------

DC_SKEW:                                ; validate sector-ID uniqueness
        LD A,(HL)
        PUSH BC
        PUSH HL
        INC HL
        DEC B
        JR Z,DC_SKDONE

DC_SKCMP:                               ; compare sector IDs
        CP (HL)
        JR Z,DC_SKBAD
        INC HL
        DJNZ DC_SKCMP

DC_SKDONE:                              ; finish sector-ID comparison
        POP HL
        POP BC
        INC HL
        DJNZ DC_SKEW
        PUSH IX
        POP HL
        INC HL
        LD DE,(DC_DEST)
        LD BC,64
        LDIR

; -------------------------------------------------------------------------------
; Commit Configuration
; -------------------------------------------------------------------------------

CF_COMMIT:                              ; commit configuration change
        CALL DC_RESET
        JP DC_OK

DC_SKBAD:                               ; reject duplicate sector ID
        POP HL
        POP BC
        JP DC_INVALID
  ; 07-Sep-2026: caller has restored our complete 1K control image.
  ; DE points at its valid 80-byte request in TPA, as for BDOS 181/5.
  ; Keep normal geometry, drive-zero protection and stream checks below.

; ================================================================================
; =                               Disk Formatting                                =
; =                                                                              =
; = Validates a format request, reselects the target drive, and streams caller-  =
; = supplied track data to the floppy controller (Model 4 polled, Model II DMA). =
; ================================================================================
; -------------------------------------------------------------------------------
; Format Request Setup
; -------------------------------------------------------------------------------

CF_FAST:                                ; enter fast format request
        PUSH IX
        PUSH DE
        POP IX

CF_FORMAT:                              ; format selected track
        CALL DC_RESET                   ; even a rejected request must clear cached context
        LD A,(IX+0)
        OR A
        JP Z,DC_UNSUPPORTED
        LD (BIO_DRIVE),A
        LD HL,0
        LD (BIO_TRACK),HL
        LD (BIO_SECTOR),HL
        CALL DC_MAP
        JP NZ,DC_INVALID
        LD A,(B_PDrive)
        CP 1                            ; never format bootstrap physical drive through alias
        JP Z,DC_UNSUPPORTED
        LD A,(IX+1)
        LD (BIO_PCYL),A
        LD (DC_IDTRK),A
        LD A,(IX+0)
        CALL DC_LOG
        LD DE,32
        ADD HL,DE
        LD A,(IX+1)
        CP (HL)
        JP NC,DC_INVALID
        LD A,(IX+2)
        CP 2
        JP NC,DC_INVALID
        LD (B_PSide),A
        OR A
        JR Z,DC_FBUFFER
        LD A,(DC_FLAGS)
        AND 060H
        JP Z,DC_INVALID

DC_FBUFFER:                             ; validate format buffer
        LD L,(IX+5)
        LD H,(IX+6)
        LD A,H
        OR A
        JP Z,DC_INVALID
        LD (DC_BUFFER),HL
        LD E,(IX+3)
        LD D,(IX+4)
        LD A,D
        OR E
        JP Z,DC_INVALID
        ADD HL,DE
        JP C,DC_INVALID
        LD DE,LY_TPA
        OR A
        SBC HL,DE
        JP NC,DC_INVALID
        CALL DC_SEEK
        JP NZ,DC_RETURN
  ; Ordinary calls load the overlay from A; DUP may supply its saved copy.
  ; A long restore/seek on the target can exhaust its motor timer.
  ; Re-select at the same cylinder before WRITE TRACK. Reuse the common
  ; seek service: this second call has no head travel, but renews selection.
        CALL DC_SEEK
        JP NZ,DC_RETURN
        IFDEF DMAPORT
  ; Model II: 500 kbps leaves no time for byte polling. The Z80 DMA feeds
  ; WRITE TRACK from the caller's stream; INTRQ (PIO A bit 0) marks the end.
        LD HL,(DC_BUFFER)
        LD (DC_DMAT+11),HL              ; port B (memory) address
        LD E,(IX+3)
        LD D,(IX+4)
        DEC DE                          ; DMA length is count - 1
        LD (DC_DMAT+6),DE
        LD HL,DC_DMAT
        LD BC,(DC_DMAW-DC_DMAT)*256+DMAPORT ; program with B -> A turnaround
        OTIR
        LD A,DMA_ENABLE
        OUT (DMAPORT),A
        LD A,0F0H
        OUT (FDCCOMMAND),A
        LD DE,0
        LD B,8                          ; several revolutions at most
DC_FWAIT:
        IN A,(PIOA)
        RRCA
        JR C,DC_FSTATUS
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_FWAIT
        DJNZ DC_FWAIT

DC_FFAIL:                               ; handle format failure
        CALL DC_ERR
        JP DC_RETURN

DC_FSTATUS:                             ; return format status
        LD A,DMA_RESET
        OUT (DMAPORT),A
        IN A,(FDCSTATUS)
        AND 0FCH
        JP DC_RETURN
        ELSE
        LD HL,(DC_BUFFER)
        LD B,(IX+3)
        LD A,(IX+4)
        LD C,A
        LD A,B
        OR A
        LD A,C
        JR Z,DC_FCOUNT
        INC A

DC_FCOUNT:                              ; compute format block count
        LD (DC_NBLK),A
        LD C,FDCDATA
        LD A,0F0H
        OUT (FDCCOMMAND),A

; -------------------------------------------------------------------------------
; Track Stream Transfer
; -------------------------------------------------------------------------------

DC_FBYTE:                               ; stream format bytes
        LD DE,0

DC_FPOLL:                               ; poll floppy controller
        IN A,(FDCSTATUS)
        AND 2
        JR NZ,DC_FDATA
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_FPOLL
        IN A,(FDCSTATUS)
        AND 1
        JR Z,DC_FSTATUS
        JR DC_FFAIL

DC_FDATA:                               ; write next format byte
        OUTI
        JR NZ,DC_FBYTE
        LD A,(DC_NBLK)
        DEC A
        LD (DC_NBLK),A
        JR NZ,DC_FBYTE
        ; The index pulse must complete before the stream is exhausted.

DC_FFAIL:                               ; handle format failure
        CALL DC_ERR
        JP DC_RETURN

; -------------------------------------------------------------------------------
; Format Completion
; -------------------------------------------------------------------------------

DC_FSTATUS:                             ; return format status
        IN A,(FDCSTATUS)
        AND 0FCH
        JP DC_RETURN

        ENDIF

CPTCOUNT EQU LY_SYS+094H
CPTFLAGS EQU LY_SYS+095H              ; bit 0: startup command already consumed
CPTABLE EQU LY_SYS+096H

; ================================================================================
; =                             CPX Profile Control                              =
; =                                                                              =
; = Implements version-1 name-based enumeration, load, and unload over the       =
; = ordered persistent CPX reconstruction table.                                 =
; ================================================================================
; -------------------------------------------------------------------------------
; CPX Request Dispatch
; -------------------------------------------------------------------------------

BF_CPXCTL:                              ; control CPX profile
        PUSH    DE                      ; preserve the public request address
        EX      DE,HL
        LD      A,(HL)
        CP      1                       ; request-block version
        JP      NZ,BCX_BAD
        INC     HL
        LD      A,(HL)                  ; operation
        INC     HL                      ; enumeration index
        INC     HL                      ; result/detail byte
        INC     HL                      ; normalized eight-byte stem
        PUSH    HL
        POP     IX
        OR      A
        JR      Z,BCX_ENUM
        DEC     A
        JR      Z,BCX_LOAD
        DEC     A
        JP      NZ,BCX_BAD
        LD      A,(IX+0)
        CP      ' '
        JP      Z,BCX_BAD
        CALL    BCX_FIND
        JR      NC,BCX_OK               ; absent unload is idempotent

; -------------------------------------------------------------------------------
; Ordered Profile Removal
; -------------------------------------------------------------------------------

BCX_UNLOAD:                             ; unload selected CPX
        LD      A,(CPTCOUNT)
        SUB     C
        DEC     A
        JR      Z,BCX_UCOUNT
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      C,A
        LD      B,0
        PUSH    HL
        LD      DE,8
        ADD     HL,DE
        POP     DE
        LDIR

BCX_UCOUNT:                             ; publish shortened profile
        LD      A,(CPTCOUNT)
        DEC     A
        LD      (CPTCOUNT),A
        JR      BCX_OK

; -------------------------------------------------------------------------------
; Ordered Profile Enumeration and Addition
; -------------------------------------------------------------------------------

BCX_ENUM:                               ; return indexed active CPX name
        LD      A,(IX-2)
        LD      B,A
        LD      A,(CPTCOUNT)
        CP      B
        JR      Z,BCX_END
        JR      C,BCX_END
        LD      A,B
        ADD     A,A
        ADD     A,A
        ADD     A,A
        LD      L,A
        LD      H,0
        LD      DE,CPTABLE
        ADD     HL,DE
        PUSH    IX
        POP     DE
        LD      BC,8
        LDIR
        LD      A,1
        JP      BCX_DONE

BCX_END:                                ; report end of enumeration
        XOR     A
        JP      BCX_DONE

BCX_LOAD:                               ; append caller-normalized nonblank name
        LD      A,(IX+0)
        CP      ' '
        JR      Z,BCX_BAD
        CALL    BCX_FIND
        JR      C,BCX_OK                ; duplicate load is idempotent
        LD      A,(CPTCOUNT)
        CP      4
        JR      NC,BCX_BAD
        EX      DE,HL                   ; DE=free table record
        PUSH    IX
        POP     HL
        LD      BC,8
        LDIR
        LD      A,(CPTCOUNT)
        INC     A
        LD      (CPTCOUNT),A

BCX_OK:                                 ; report successful mutation
        XOR     A
        JR      BCX_DONE

; -------------------------------------------------------------------------------
; Name Lookup
; -------------------------------------------------------------------------------

BCX_FIND:                               ; return matching record/index or append slot
        LD      A,(CPTCOUNT)
        LD      B,A
        LD      HL,CPTABLE
        LD      C,0

BCX_FLOOP:                              ; compare one table record
        LD      A,B
        OR      A
        RET     Z                       ; absent: carry clear, HL=append slot
        PUSH    BC
        PUSH    HL
        PUSH    IX
        POP     DE
        LD      B,8

BCX_FBYTE:                              ; compare one stem byte
        LD      A,(DE)
        CP      (HL)
        JR      NZ,BCX_FMISS
        INC     DE
        INC     HL
        DJNZ    BCX_FBYTE
        POP     HL
        POP     BC
        SCF
        RET

BCX_FMISS:                              ; advance to next table record
        POP     HL
        LD      DE,8
        ADD     HL,DE
        POP     BC
        INC     C
        DJNZ    BCX_FLOOP
        OR      A                       ; clear carry
        RET

BCX_BAD:                                ; reject invalid CPX request
        LD      A,0FFH

BCX_DONE:                               ; restore public request address
        POP     DE
        JP      EX_RETURN

; ================================================================================
; =                         Configuration Query Services                         =
; =                                                                              =
; = Returns the active physical or logical disk-profile descriptor to the caller =
; = through the common configuration request buffer.                             =
; ================================================================================
; -------------------------------------------------------------------------------
; Physical Profile Query
; -------------------------------------------------------------------------------

CF_GETPH:                               ; return physical profile
        LD A,(IX+0)
        CALL DC_PHY
        JP NC,DC_INVALID
        LD BC,6
        JR DC_GETCOPY

; -------------------------------------------------------------------------------
; Logical Profile Query
; -------------------------------------------------------------------------------

CF_GETLOG:                              ; return logical profile
        LD A,(IX+0)
        CALL DC_LOG
        JP NC,DC_INVALID
        LD DE,16
        ADD HL,DE
        LD BC,64

DC_GETCOPY:                             ; copy profile to caller
        PUSH IX
        POP DE
        INC DE
        LDIR
        JP DC_OK

DC_CAP: DW 0                            ; media-capacity scratch
DC_DEST: DW 0                           ; configuration destination pointer
        .DEPHASE
        END
