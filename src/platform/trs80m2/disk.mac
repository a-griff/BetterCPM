        INCLUDE layout.inc

; MEMORY_SAVINGS_V1: qualified shared helpers; preserve public call contracts.
        INCLUDE bioslinks.inc
        INCLUDE hardware.inc

; ********************************************************************************
; *                      BetterCP/M Model II Disk Control                       *
; *                                                                              *
; * Resident Model II 8" floppy engine   shared by BDOS disk configuration, BIOS  *
; * runtime transfers, and raw bootstrap I/O. Runtime geometry is translated here *
; * into controller-level drive, cylinder, side, sector, and transfer parameters. *
; ********************************************************************************

        CSEG
        .PHASE  LY_DISK
        JP DC_ENTRY
        JP DC_MAP
        JP DC_SELECT
        JP DC_READ
        JP DC_WRITE
        JP DC_RAW

; ================================================================================
; =                            Disk Control Interface                            =
; =                                                                              =
; = Provides the resident entry vectors and BDOS-facing request dispatcher for raw =
; = I/O, profile configuration, formatting, and configuration queries.           =
; ================================================================================
; -------------------------------------------------------------------------------
; Resident Entry Vectors
; -------------------------------------------------------------------------------

DC_RAW:                                 ; raw physical-I/O entry
        ; The bootstrap adapter uses the SAME physical I/O engine as BDOS.
        LD (BIO_PCYL),A
        LD (DC_IDTRK),A
        LD A,B
        LD (B_PSide),A
        LD A,C
        LD (BIO_PSEC),A
        LD A,1
        LD (B_PDrive),A
        LD A,2
        LD (DC_SIZE),A
        LD A,080H
        LD (DC_FLAGS),A
        PUSH HL
        LD HL,DC_PHYS
        LD (DC_PHYADDR),HL
        POP HL
        JP DC_READ

DC_SETPH:                               ; set physical profile entry
        XOR A
        JR DC_CTL

DC_SETLOG:                              ; set logical profile entry
        LD A,3
        JR DC_CTL

DC_FORMAT:                              ; format-track entry
        LD A,6

DC_CTL:                                 ; configuration-control entry
        PUSH AF
        CALL LY_BIOS+57
        POP BC
        OR A
        JR NZ,DC_RETURN
        LD H,0
        LD L,B
        LD DE,LY_CFG
        ADD HL,DE
        JP (HL)

; -------------------------------------------------------------------------------
; BDOS Request Dispatch
; -------------------------------------------------------------------------------

DC_ENTRY:                               ; dispatch disk-control request
        LD A,B
        OR A
        JR NZ,DC_REQUEST
        LD HL,DC_INFO
        RET

DC_REQUEST:                             ; dispatch selected control operation
        PUSH IX
        PUSH DE
        POP IX
        LD A,D
        OR A
        JR Z,DC_INVALID
        LD HL,80
        ADD HL,DE
        JR C,DC_INVALID
        LD DE,LY_TPA
        OR A
        SBC HL,DE
        JR NC,DC_INVALID
        LD A,B
        CP 1
        JR Z,DC_GETPH
        CP 2
        JR Z,DC_SETPH
        CP 3
        JR Z,DC_GETLOG
        CP 4
        JR Z,DC_SETLOG
        CP 5
        JR Z,DC_FORMAT

DC_INVALID:                             ; return invalid-request status
        LD A,1
        JR DC_RETURN

DC_UNSUPPORTED:                         ; return unsupported-request status
        LD A,2

DC_RETURN:                              ; restore caller context and return
        LD L,A
        LD H,0
        POP IX
        RET

DC_OK:                                  ; return success
        XOR A
        JR DC_RETURN

  ; Physical records: size in inches, cylinders, sides, WD step code,
  ; motor spin-up in 1/4 seconds, head settle in milliseconds.

; ================================================================================
; =                      Physical and Logical Disk Profiles                      =
; =                                                                              =
; = Resolves physical and logical disk descriptors, resets shared disk context,  =
; = and selects the active logical drive binding.                                =
; ================================================================================
; -------------------------------------------------------------------------------
; Physical Profile Lookup
; -------------------------------------------------------------------------------

DC_PHY:                                 ; locate physical profile
        CP 4
        RET NC
        ADD A,A
        LD E,A
        ADD A,A
        ADD A,E
        LD E,A
        LD D,0
        LD HL,DC_PHYS
        ADD HL,DE
        SCF
        RET

DC_GETPH:                               ; return physical profile
        LD A,12
        JR DC_CTL
  ; Four logical records, 80 bytes each. DPH + binding.
  ; BDOS rebuilds the shared allocation vector on every context switch.

; -------------------------------------------------------------------------------
; Logical Profile Lookup
; -------------------------------------------------------------------------------

DC_LOG:                                 ; locate logical profile
        CP 4
        RET NC
        LD HL,LY_TAB
        LD DE,80
        OR A
        JR NZ,DC_LOGL
        SCF
        RET

DC_LOGL:                                ; locate logical profile entry
        ADD HL,DE
        DEC A
        JR NZ,DC_LOGL
        SCF
        RET

DC_GETLOG:                              ; return logical profile
        LD A,15
        JR DC_CTL

; -------------------------------------------------------------------------------
; Context Invalidation
; -------------------------------------------------------------------------------

DC_RESET:                               ; invalidate disk contexts
        ; Conservatively invalidate every alias and active BDOS disk context.
        PUSH IX
        LD DE,0FFFFH
        LD C,37
        CALL LY_BDOS
        POP IX
        RET

; -------------------------------------------------------------------------------
; Logical Drive Selection
; -------------------------------------------------------------------------------

DC_SELECT:                              ; select logical drive
        LD A,C
        LD (BIO_DRIVE),A
        CALL DC_LOG
        JR NC,DC_NOLOG
        PUSH HL
        LD DE,16
        ADD HL,DE
        LD A,(HL)
        CP 4
        POP HL
        RET C

DC_NOLOG:                               ; reject unbound logical drive
        LD HL,0
        RET

; ================================================================================
; =                         Logical-to-Physical Mapping                          =
; =                                                                              =
; = Maps CP/M logical records through runtime geometry to Model II physical drive, =
; = cylinder, side, sector, quarter-sector, and transfer-size parameters.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Geometry Mapping
; -------------------------------------------------------------------------------

DC_MAP:                                 ; map logical record to physical transfer
        PUSH IX
        LD A,(BIO_DRIVE)
        CALL DC_LOG
        JP NC,DC_MAPBAD
        LD DE,16
        ADD HL,DE
        PUSH HL
        POP IX
        LD A,(IX+0)
        CALL DC_PHY
        JP NC,DC_MAPBAD
        LD (DC_PHYADDR),HL
        LD A,(IX+0)
        LD B,A
        INC B
        LD A,080H

DC_MASK:                                ; decode geometry flags
        RLCA
        DJNZ DC_MASK
        LD (B_PDrive),A
        LD HL,(BIO_SECTOR)
        LD E,(IX+1)
        LD D,(IX+2)
        OR A
        SBC HL,DE
        JP NC,DC_MAPBAD
        LD A,(IX+19)
        AND 00FH
        OR (IX+52)
        JR Z,DC_COMMON
  ; Optional conventions live in FDF.RSX. CALL 5 follows the current chain;
  ; no saved RSX pointer can outlive a rebuild or an unload.
        LD DE,(BIO_TRACK)
        LD HL,(BIO_SECTOR)
        LD BC,001B7H                  ; production FDF Function 183, operation 1
        CALL 5
        BIT 7,B
        JP Z,DC_MAPBAD
        LD A,H
        LD (DC_IDTRK),A
        LD A,L
        LD (BIO_PCYL),A
        LD A,D
        LD (B_PSide),A
        LD A,E
        LD (BIO_PSEC),A
        LD A,B
        AND 7
        LD (BIO_QUART),A
        LD A,B
        RRCA
        RRCA
        RRCA
        AND 3
        JR DC_SETSIZE

; -------------------------------------------------------------------------------
; Common Mapping Geometry
; -------------------------------------------------------------------------------

DC_COMMON:                              ; apply common geometry mapping
        LD HL,(BIO_TRACK)
        LD A,H
        OR A
        JP NZ,DC_MAPBAD
        XOR A
        LD (B_PSide),A
        LD A,(BIO_TRACK)
        BIT 5,(IX+19)                   ; built-in cylinder-track 790K profile
        JR NZ,DC_CYL
        BIT 6,(IX+19)
        JR Z,DC_CYL
        SRL A
        PUSH AF
        LD A,0
        ADC A,0
        LD (B_PSide),A
        POP AF

DC_CYL:                                 ; derive physical cylinder
        CP (IX+16)
        JR NC,DC_MAPBAD
        LD (BIO_PCYL),A
        LD (DC_IDTRK),A
        OR A                            ; Model II: cylinder 0 side 0 is the
        JR NZ,DC_NOTFM                  ; FM boot track, 26 x 128 in ID order
        LD A,(B_PSide)
        OR A
        JR Z,DC_FM0
DC_NOTFM:
        LD HL,(BIO_SECTOR)
        LD B,(IX+18)
        LD C,L
        LD A,1
        INC B
DC_QMASK:
        DJNZ DC_QSHIFT
        JR DC_QDONE
DC_QSHIFT:
        ADD A,A
        SRL H
        RR L
        JR DC_QMASK
DC_QDONE:
        DEC A
        AND C
        LD (BIO_QUART),A

DC_DIVDONE:                             ; finish sector division
        LD A,L
        CP (IX+17)
        JR C,DC_SECOK
        SUB (IX+17)
        LD B,A
        LD A,1
        LD (B_PSide),A
        LD A,B

DC_SECOK:                               ; accept translated sector
        LD E,A
        LD D,0
        PUSH IX
        POP HL
        ADD HL,DE
        LD DE,20
        ADD HL,DE
        LD A,(HL)
        LD (BIO_PSEC),A

DC_MAPPED:                              ; publish mapped transfer
        LD A,(IX+18)

DC_SETSIZE:                             ; set transfer size
        LD (DC_SIZE),A
        LD A,(IX+19)
        LD (DC_FLAGS),A
        POP IX
        XOR A
        RET

DC_FM0:                                 ; map cylinder 0 record to FM sector
        LD (BIO_QUART),A                ; A = 0
        LD A,(BIO_SECTOR)               ; below SPT already, so one byte
        CP 26
        JR NC,DC_MAPBAD
        INC A
        LD (BIO_PSEC),A
        XOR A                           ; 128-byte sectors; DC_SEEK selects FM
        LD (DC_SIZE),A
        LD A,(IX+19)
        LD (DC_FLAGS),A
        POP IX
        XOR A
        RET

DC_MAPBAD:                              ; reject invalid mapping
        POP IX
        LD A,1
        OR A
        RET

  ; One physical transfer engine serves runtime geometry and raw boot reads.

; ================================================================================
; =                       Physical Sector Transfer Engine                        =
; =                                                                              =
; = Performs shared physical reads and writes with bounded retry, controller-polarity =
; = handling, buffer inversion, and byte-level WD controller transfers.          =
; ================================================================================
; -------------------------------------------------------------------------------
; Read and Write Entry
; -------------------------------------------------------------------------------

DC_READ:                                ; read physical sector
        LD A,080H
        JR DC_IO

DC_WRITE:                               ; write physical sector
        LD A,0A0H

DC_IO:                                  ; enter common physical transfer
        LD (DC_COMMAND),A
        LD (DC_BUFFER),HL
  ; Keep write data in controller polarity for ALL attempts. Restore the
  ; caller's bytes on either success or failure; never invert each retry.
        CP 0A0H
        CALL Z,DC_INVBUF
        LD A,3                          ; first attempt plus two retries

; -------------------------------------------------------------------------------
; Bounded Transfer Retry
; -------------------------------------------------------------------------------

DC_RETRY:                               ; retry failed physical transfer
        PUSH AF
        CALL DC_TRY
        POP BC                          ; B retains the remaining attempt count
        OR A
        JR Z,DC_FINISH
        BIT 6,A                         ; write protection will not improve on retry
        JR NZ,DC_FINISH
        DEC B
        JR Z,DC_FINISH
        PUSH BC
        CALL DC_ERR                     ; abort command and distrust head position
        POP AF                          ; remaining count was in B, now in A
        JR DC_RETRY

DC_FINISH:                              ; finish transfer attempt
        OR A                            ; BIT above must not disguise a final error
        PUSH AF                         ; retain the last controller result
        LD A,(DC_COMMAND)
        CP 0A0H
        CALL Z,DC_INVBUF
  ; Callers (WBOOT reload, RSX loads) chain sectors through HL, which the
  ; Model 4 byte loop left just past the data. The DMA does not, so set it.
        LD HL,(DC_BUFFER)
        CALL DA_LEN
        ADD HL,DE
        POP AF
        RET
  ; Formerly DC_IO returned after a single failed transfer. A CRC error,
  ; lost byte or missed sector now gets a bounded fresh seek and transfer.

; -------------------------------------------------------------------------------
; Controller Transfer Setup
; -------------------------------------------------------------------------------

DC_TRY:                                 ; prepare controller transfer
        CALL DC_SEEK
        RET NZ
        LD A,(BIO_PSEC)
        OUT (FDCSECTOR),A
  ; Model II: the Z80 DMA moves the data, paced by FDC DRQ on DMA READY.
  ; Completion is FDC INTRQ on PIO port A bit 0 (Pickles & Trout method).
        LD HL,(DC_BUFFER)
        LD (DC_DMAT+11),HL              ; port B (memory) address
        CALL DA_LEN
        DEC DE                          ; DMA length is count - 1
        LD (DC_DMAT+6),DE
        LD HL,DC_DMAT
        LD C,DMAPORT
        LD B,DC_DMAN                    ; read program
        LD A,(DC_COMMAND)
        CP 080H
        JR Z,DC_DPROG
        LD B,DC_DMAN+2                  ; write: turn the DMA around B -> A
DC_DPROG:
        OTIR
        LD A,DMA_ENABLE
        OUT (DMAPORT),A
        LD A,(DC_COMMAND)
        OUT (FDCCOMMAND),A
        LD B,3                          ; DE = count - 1 here: about 2 s
DC_DWT:
        IN A,(PIOA)
        RRCA
        JR C,DC_DEND
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_DWT
        DJNZ DC_DWT                     ; timeout: the next program resets the DMA
        JR DC_ERR

DC_DEND:                                ; command complete: stop the DMA
        LD A,DMA_RESET
        OUT (DMAPORT),A
        IN A,(FDCSTATUS)
        AND 0DCH
        RET NZ
        LD A,(DC_COMMAND)
        CP 080H
        JR NZ,DC_IODONE
        CALL DC_INVBUF

DC_IODONE:                              ; complete physical transfer
        XOR A
        RET

; DMA program: reset; WR4 interrupt control 0; reinitialize status;
; WR0 port A -> B, port A = FDC data, length; WR1 port A I/O fixed;
; WR2 port B memory incrementing; WR4 byte mode, port B address;
; WR5 READY active high; LOAD. Writes append WR0 B -> A and LOAD.
DC_DMAT:
        DB DMA_RESET,091H,000H,08BH,06DH,FDCDATA
        DW 0
        DB 03CH,010H,08DH
        DW 0
        DB 08AH,0CFH
DC_DMAN EQU $-DC_DMAT
        DB 001H,0CFH
DC_DMAW:                                ; end of the write program

; -------------------------------------------------------------------------------
; Write-Buffer Polarity
; -------------------------------------------------------------------------------

DC_INVBUF:                              ; invert write buffer
        LD A,(DC_FLAGS)
        AND 010H
        RET Z
        LD HL,(DC_BUFFER)
        CALL DA_LEN

DC_INVERT:                              ; invert next buffer byte
        LD A,(HL)
        CPL
        LD (HL),A
        INC HL
        DEC DE
        LD A,D
        OR E
        JR NZ,DC_INVERT
        RET


; -------------------------------------------------------------------------------
; Controller Completion
; -------------------------------------------------------------------------------

DC_WAIT:                                ; wait for controller completion
        LD BC,0

DC_WAITL:                               ; poll controller busy state
        IN A,(FDCSTATUS)
        BIT 0,A
        JR Z,DC_ZERO
        DEC BC
        LD A,B
        OR C
        JR NZ,DC_WAITL

; -------------------------------------------------------------------------------
; Controller Error Status
; -------------------------------------------------------------------------------

DC_ERR:                                 ; return controller error
        LD A,0D1H
        LD (DC_LAST),A                  ; failed seek/restore leaves position untrusted
        OUT (FDCCOMMAND),A
        LD A,1
        OR A
        RET

DC_ZERO:                                ; return zero status
        XOR A
        RET

; ================================================================================
; =                     Drive Selection and Head Positioning                     =
; =                                                                              =
; = Selects and spins up the physical drive, restores or seeks the shared WD track =
; = register, applies settle delays, and preserves safe drive-change semantics.  =
; ================================================================================
; -------------------------------------------------------------------------------
; Drive Selection and Seek
; -------------------------------------------------------------------------------

DC_SEEK:                                ; select drive and position head
        CALL DC_WAIT
        RET NZ
        LD A,(B_PSide)                  ; Model II latch: active-low drive,
        OR A                            ; bit 6 = side 0, bit 7 = MFM
        LD B,SEL_SIDE0
        JR Z,DC_SSIDE
        LD B,0
DC_SSIDE:
        LD HL,BIO_PCYL                  ; cylinder 0 side 0 is always the FM
        OR (HL)                         ; boot track, whatever the format
        JR Z,DC_SFM
        LD A,(DC_FLAGS)
        AND 080H
        OR B
        LD B,A
DC_SFM:
        LD A,(B_PDrive)
        XOR SEL_NONE
        AND SEL_NONE
        OR B
        OUT (FDCSELECT),A
        LD A,(B_PDrive)
        LD B,A
        LD A,(DC_LAST)
        CP B
        JR Z,DC_SAME
        LD A,B
        LD (DC_LAST),A
        ; Restore on a drive change because the WD track register is shared.
        ; 8-inch drives spin continuously: no spin-up wait on the Model II.

; -------------------------------------------------------------------------------
; Track-Zero Restore
; -------------------------------------------------------------------------------

DC_RESTORE:                             ; restore drive to track zero
        XOR A
        LD (DC_LASTCYL),A
        LD HL,(DC_PHYADDR)
        LD DE,3
        ADD HL,DE
        LD A,(HL)
        OR 008H
        OUT (FDCCOMMAND),A
        CALL DC_WAIT
        RET NZ
        IN A,(FDCSTATUS)
        AND 010H
        JP NZ,DC_ERR

; -------------------------------------------------------------------------------
; Cylinder Seek
; -------------------------------------------------------------------------------

DC_SEEKTO:                              ; seek to requested cylinder
        LD A,(DC_LASTCYL)
        OUT (FDCTRACK),A
        LD A,(BIO_PCYL)
        OUT (FDCDATA),A
        LD HL,(DC_PHYADDR)
        LD DE,3
        ADD HL,DE
        LD A,(HL)
        OR 018H
        OUT (FDCCOMMAND),A
        CALL DC_WAIT
        RET NZ
        IN A,(FDCSTATUS)
        AND 010H
        JP NZ,DC_ERR
        LD A,(BIO_PCYL)
        LD (DC_LASTCYL),A
  ; DC_WAIT preserves HL, still at the step-rate byte. Advance to settle.
        INC HL
        INC HL
        LD A,(HL)
        CALL DC_DELAY
  ; Only a previously selected drive can take this shortcut. A drive change
  ; must still restore, seek and settle even when its destination is track 0.

DC_SAME:                                ; reuse current cylinder
        LD HL,DC_LASTCYL
        LD A,(BIO_PCYL)
        CP (HL)
        JR NZ,DC_SEEKTO

DC_IDONLY:                              ; update controller track identity
        LD A,(DC_IDTRK)
        OUT (FDCTRACK),A
        XOR A
        RET
  ; Approximately 1ms at Model 4 4MHz. All waits are bounded.

; -------------------------------------------------------------------------------
; Head-Settle Delay
; -------------------------------------------------------------------------------

DC_DELAY:                               ; delay for head settling
        OR A
        RET Z

DC_DMS:                                 ; convert settle time to loop count
  ; 235 * (NOP + DJNZ) is about 4000 clocks at 4 MHz. Keep A intact
  ; instead of shuffling it through D on every turn of the delay loop.
        LD B,235

DC_DLOOP:                               ; execute millisecond delay
        NOP
        DJNZ DC_DLOOP
        DEC A
        JR NZ,DC_DMS
        RET

  ; Format one physical track with caller-supplied WD write-track stream.
  ; request: logical,cylinder,side,length word,buffer word.

; ================================================================================
; =                          Disk-Control Working State                          =
; =                                                                              =
; = Defines format request metadata and the persistent physical-transfer state used =
; = by mapping, seeking, retry, and controller I/O.                              =
; ================================================================================
; -------------------------------------------------------------------------------
; Format Request Descriptor
; -------------------------------------------------------------------------------

DA_LEN:
        LD DE,128
        LD A,(DC_SIZE)
        OR A
        RET Z
DC_INVSH:
        SLA E
        RL D
        DEC A
        JR NZ,DC_INVSH
        RET

DC_INFO:                                ; format request descriptor
        DB 'B','D','C','F',5,4,4,64
        DW DC_PHYS,LY_TAB
        DW LY_BUF                       ; complete last physical read, logical polarity
        DW LY_CFG+18                    ; ABI 5: cached control image format entry

; -------------------------------------------------------------------------------
; Physical Transfer State
; -------------------------------------------------------------------------------

DC_PHYS:                                ; physical profile table
        REPT 4
        DB 8,77,1,0,0,15
        ENDM

DC_IDTRK: DB 0                          ; requested ID track
DC_LASTCYL: DB 0                        ; last selected cylinder
DC_LAST: DB 0FFH                        ; last selected physical drive
DC_PHYADDR: DW DC_PHYS                  ; physical-profile pointer
DC_NBLK: DB 0                           ; transfer block count (CONFIG format)
DC_COMMAND: DB 0                        ; controller command
DC_BUFFER: DW 0                         ; transfer buffer pointer
DC_SIZE: DB 2                           ; physical transfer size
DC_FLAGS: DB 080H                       ; active geometry flags
        .DEPHASE
        END
