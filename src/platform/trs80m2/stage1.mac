        INCLUDE layout.inc

; ********************************************************************************
; *                 BetterCP/M TRS-80 Model II Stage One                         *
; *                                                                              *
; * System package records 4-7, stored in FM sectors 5-8 of cylinder 0. The     *
; * Model II ROM loads the whole FM track at 0E00H, so this record set lands at  *
; * 1000H with the 'BOOT' signature the ROM requires. The ROM first calls the    *
; * 'DIAG' stub at 1404H (written when the disk is formatted), which jumps to    *
; * 1004H; the ROM's own final jump also enters 1004H.                           *
; *                                                                              *
; * Loads the 13 resident-system sectors from cylinder 1, sets IOBYTE and enters *
; * BIOS BOOT. See docs/platform/TRS-80 Model II 8-inch System Disk.md.          *
; ********************************************************************************

        INCLUDE hardware.inc

SYSIMAGE        EQU     LY_SYS
SYSBOOT         EQU     LY_BIOS+0       ; BIOS BOOT initializes the console
SYSSECTORS      EQU     LY_SECTS
M2_READ_ONLY    EQU     1

        CSEG
        .PHASE  BT_BOOT

        DB      'BOOT'                  ; ROM signature at 1000H; entry at 1004H

STAGE1:
        DI
        XOR     A
        OUT     (ROMCTL),A              ; boot ROM out of 0000-07FF
        LD      SP,BT_STACK
        LD      A,CTL_RUN               ; page 1 high RAM, video at F800H
        OUT     (CPUCTL),A
  ; True cold entry owns IOBYTE. 95h: CON=CRT, RDR=PTR, PUN=PTP, LST=LPT.
  ; CONFIG /IOBYTE patches the operand after IO_COLD in the system package.
IO_COLD:
        LD      A,095H
        LD      (0003H),A
        LD      DE,SYSTABLE
        LD      HL,SYSIMAGE
        LD      B,SYSSECTORS

SYSLOAD:                                ; load next resident-system sector
        PUSH    BC
        EX      DE,HL
        LD      A,(HL)                  ; cylinder
        INC     HL
        LD      B,(HL)                  ; side
        INC     HL
        LD      C,(HL)                  ; sector
        INC     HL
        EX      DE,HL
        PUSH    DE
        CALL    M2_READ                 ; HL advances past the sector
        POP     DE
        POP     BC
        JR      NZ,SYSERROR
        DJNZ    SYSLOAD
  ; A is zero here. A true cold start has no interrupted lookup to recover;
  ; leave warm reconstruction's recovery state untouched.
        LD      (0048H),A
        JP      SYSBOOT

SYSERROR:                               ; show the controller status and stop
        PUSH    AF
        LD      HL,ERRMSG
        LD      DE,VIDEOBASE+11*VIDEOCOLS+28
        LD      BC,ERRLEN
        LDIR
        POP     AF
        PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        CALL    HEXNIB
        POP     AF
        CALL    HEXNIB
SYSHALT:
        JR      SYSHALT

HEXNIB: AND     0FH
        ADD     A,90H
        DAA
        ADC     A,40H
        DAA
        LD      (DE),A
        INC     DE
        RET

ERRMSG: DB      'BetterCP/M load error '
ERRLEN  EQU     $-ERRMSG

SYSTABLE:                               ; resident-system sector table
  ; @resident-sector-table@

B_PDrive: DB    1                       ; the system always loads from drive 0

        INCLUDE m2disk.inc

        IF      $ GT BT_BOOT+512
        DB      STAGE1_OVERFLOW         ; undefined: forces an assembly error
        ENDIF
        .DEPHASE
        END
