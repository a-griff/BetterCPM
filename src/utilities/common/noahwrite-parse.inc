; Increment 3 parser extensions. Entire tail is validated before file activity.
NW_OPTION:
 PUSH HL
 PUSH BC
 LD HL,NW_ADD_WORD
 CALL NW_TOKEN_IS
 JR Z,NW_OPT_ADD
 LD HL,NW_REMOVE_WORD
 CALL NW_TOKEN_IS
 JR Z,NW_OPT_REMOVE
 LD HL,NW_COMPACT_WORD
 CALL NW_TOKEN_IS
 JR Z,NW_OPT_COMPACT
 LD HL,NW_FORMAT_LBR_WORD
 CALL NW_TOKEN_IS
 JP Z,NW_OPT_FORMAT_LBR
 LD HL,NW_FORMAT_ARK_WORD
 CALL NW_TOKEN_IS
 JP Z,NW_OPT_FORMAT_ARK
 LD A,(NS_TOKEN_LEN)
 CP 11
 JP C,NW_OPT_UNKNOWN
 LD HL,NW_CAP_WORD
 LD DE,(NS_TOKEN_PTR)
 LD B,10
NW_CAP_PREFIX:
 LD A,(DE)
 CP (HL)
 JP NZ,NW_OPT_UNKNOWN
 INC DE
 INC HL
 DJNZ NW_CAP_PREFIX
 CALL NW_CAP_DECIMAL
 JP C,NW_OPT_BAD
 LD A,(NW_CAP_SET)
 OR A
 JR Z,NW_OPT_CAP_SAVE
 LD HL,NW_CAP
 LD DE,NW_CAP_CANDIDATE
 LD B,4
NW_CAP_REPEAT:
 LD A,(DE)
 CP (HL)
 JR NZ,NW_OPT_BAD
 INC DE
 INC HL
 DJNZ NW_CAP_REPEAT
 JR NW_OPT_YES
NW_OPT_CAP_SAVE:
 LD HL,NW_CAP_CANDIDATE
 LD DE,NW_CAP
 LD BC,4
 LDIR
 LD A,1
 LD (NW_CAP_SET),A
 JR NW_OPT_YES
NW_OPT_ADD:
 LD C,3
 JR NW_OPT_MODE
NW_OPT_REMOVE:
 LD C,4
NW_OPT_MODE:
 LD A,(NS_MODE_SET)
 OR A
 JR Z,NW_OPT_SET_MODE
 LD A,(NH_MODE)
 CP C
 JR Z,NW_OPT_YES
 CP 5
 JR NZ,NW_OPT_BAD
NW_OPT_SET_MODE:
 LD A,C
 LD (NH_MODE),A
 LD A,1
 LD (NS_MODE_SET),A
 JR NW_OPT_YES
NW_OPT_COMPACT:
 LD A,(NS_MODE_SET)
 OR A
 JR Z,NW_OPT_CMP_NEW
 LD A,(NH_MODE)
 CP 3
 JR C,NW_OPT_BAD
 JR NW_OPT_CMP_FLAG
NW_OPT_CMP_NEW:
 LD A,5
 LD (NH_MODE),A
 LD A,1
 LD (NS_MODE_SET),A
NW_OPT_CMP_FLAG:
 LD A,1
 LD (NW_COMPACT),A
 JR NW_OPT_YES
NW_OPT_FORMAT:
NW_OPT_FORMAT_ARK:
 LD C,2
 JR NW_OPT_FORMAT_SET
NW_OPT_FORMAT_LBR:
 LD C,1
NW_OPT_FORMAT_SET:
 LD A,(NW_FORMAT)
 OR A
 JR Z,NW_OPT_FORMAT_SAVE
 CP C
 JP NZ,NW_OPT_BAD
NW_OPT_FORMAT_SAVE:
 LD A,C
 LD (NW_FORMAT),A
NW_OPT_YES:
 POP BC
 POP HL
 LD A,1
 OR A
 RET
NW_OPT_UNKNOWN:
 POP BC
 POP HL
 XOR A
 RET
NW_OPT_BAD:
 POP BC
 POP HL
 SCF
 RET
NW_TOKEN_IS:
 PUSH HL
 LD DE,(NS_TOKEN_PTR)
 LD A,(NS_TOKEN_LEN)
 JP NH_MATCH
; DE points to decimal digits after /CAPACITY=. At most six digits, <=262139.
NW_CAP_DECIMAL:
 LD A,(NS_TOKEN_LEN)
 SUB 10
 CP 7
 JP NC,NS_BAD
 LD B,A
 LD HL,0
 LD C,0
NW_DECIMAL_DIGIT:
 LD A,(DE)
 INC DE
 SUB '0'
 CP 10
 JP NC,NS_BAD
 LD (NW_DIGIT),A
 PUSH DE
 LD D,H
 LD E,L
 LD A,C
 LD (NW_HIGH),A
 ADD HL,HL
 RL C
 ADD HL,HL
 RL C
 ADD HL,DE
 JR NC,NW_DECIMAL_HIGH
 INC C
NW_DECIMAL_HIGH:
 LD A,(NW_HIGH)
 ADD A,C
 LD C,A
 ADD HL,HL
 RL C
 LD A,(NW_DIGIT)
 LD E,A
 LD D,0
 ADD HL,DE
 JR NC,NW_DECIMAL_NEXT
 INC C
NW_DECIMAL_NEXT:
 POP DE
 DJNZ NW_DECIMAL_DIGIT
 LD A,C
 CP 4
 JP NC,NS_BAD
 CP 3
 JR NZ,NW_DECIMAL_OK
 LD DE,0FFFCH
 PUSH HL
 OR A
 SBC HL,DE
 POP HL
 JP NC,NS_BAD
NW_DECIMAL_OK:
 LD (NW_CAP_CANDIDATE),HL
 LD A,C
 LD (NW_CAP_CANDIDATE+2),A
 XOR A
 LD (NW_CAP_CANDIDATE+3),A
 RET

NW_PARSE_CHECK:
 LD A,(NW_COMPACT)
 OR A
 JR Z,NW_PARSE_MODE_CHECK
 LD A,(NH_MODE)
 CP 3
 JP C,NS_BAD
NW_PARSE_MODE_CHECK:
 LD A,(NH_MODE)
 CP 3
 JR Z,NW_PARSE_ADD_COUNT
 CP 4
 JR Z,NW_PARSE_REMOVE_COUNT
 CP 5
 JR Z,NW_PARSE_COMPACT_COUNT
 LD A,(NW_CAP_SET)
 LD B,A
 LD A,(NW_FORMAT)
 OR B
 JP NZ,NS_BAD
 OR A
 RET
NW_PARSE_REMOVE_COUNT:
 LD A,(NS_OPERANDS)
 CP 2
 JP NZ,NS_BAD
 LD A,(NW_CAP_SET)
 OR A
 JR Z,NW_PARSE_NO_FORMAT
 LD A,(NW_COMPACT)
 OR A
 JP Z,NS_BAD
NW_PARSE_NO_FORMAT:
 LD A,(NW_FORMAT)
 OR A
 JP NZ,NS_BAD
 RET
NW_PARSE_COMPACT_COUNT:
 LD A,(NS_OPERANDS)
 CP 1
 JP NZ,NS_BAD
 JR NW_PARSE_NO_FORMAT
NW_PARSE_ADD_COUNT:
 LD A,(NS_OPERANDS)
 CP 2
 JP NZ,NS_BAD
 OR A
 RET
NW_PARSE_ADD:
 ; Existing FS parse describes the target. It must resolve to one exact DU/name.
 LD A,(NS_ATTR_MASK)
 CP 255
 JP NZ,NS_BAD
 LD HL,(FS_FILE)
 LD A,(FS_FLEN)
 LD B,A
 XOR A
 CALL FP_VALIDATE
 RET C
 LD BC,0
 CALL DU_NEXT
 JP C,NS_BAD
 LD A,D
 LD (NW_TARGET),A
 LD A,E
 LD (NW_TARGET+1),A
 CALL DU_NEXT
 JP NC,NS_BAD
 LD HL,NS_ARCH_FCB+1
 LD DE,NW_TARGET+2
 LD BC,11
 LDIR
 LD HL,(NS_MEMBER_ARG)
 LD A,(NS_MEMBER_LEN)
 LD B,A
 LD A,(NS_OLD_DRIVE)
 LD D,A
 LD A,(NS_OLD_USER)
 LD E,A
 CALL FS_PARSE
 RET C
 LD HL,(FS_FILE)
 LD A,(FS_FLEN)
 LD B,A
 CALL NS_LEXICAL
 RET C
 CALL NS_DOMAIN
 RET C
 LD HL,DU_MAP
 LD DE,NS_ARCH_MAP
 LD BC,64
 LDIR
 LD HL,FS_FCB
 LD DE,NS_ARCH_FCB
 LD BC,36
 LDIR
 LD A,(FS_MASK)
 LD (NS_ATTR_MASK),A
 OR A
 RET
NW_ADD_WORD: DB '/ADD',0
NW_REMOVE_WORD: DB '/REMOVE',0
NW_COMPACT_WORD: DB '/COMPACT',0
NW_CAP_WORD: DB '/CAPACITY='
NW_FORMAT_LBR_WORD: DB '/FORMAT=LBR',0
NW_FORMAT_ARK_WORD: DB '/FORMAT=ARK',0
