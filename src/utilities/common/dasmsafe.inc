; Automatic commands stage a table snapshot; a refused operation rolls it back.
D_ANALYSIS_BEGIN:
 LD A,(ASCBLD)
 LD B,A
 LD A,(BUILD)
 OR B
 RET Z
 LD HL,(SYMEND)
 LD (D_ANALYSIS_SYMEND),HL
 LD HL,(PC)
 LD (D_ANALYSIS_PC),HL
 LD HL,SYMTAB
 LD DE,D_STAGE
 LD BC,1000H
 LDIR
 LD HL,CTLTBL
 LD DE,D_STAGE+1000H
 LD BC,0600H
 LDIR
 LD A,1
 LD (D_ANALYSIS_ACTIVE),A
 RET
D_ANALYSIS_ROLLBACK:
 LD A,(D_ANALYSIS_ACTIVE)
 OR A
 RET Z
 XOR A
 LD (D_ANALYSIS_ACTIVE),A
 LD HL,D_STAGE
 LD DE,SYMTAB
 LD BC,1000H
 LDIR
 LD HL,D_STAGE+1000H
 LD DE,CTLTBL
 LD BC,0600H
 LDIR
 LD HL,(D_ANALYSIS_SYMEND)
 LD (SYMEND),HL
 LD HL,(D_ANALYSIS_PC)
 LD (PC),HL
 RET

