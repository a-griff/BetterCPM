 LD (NS_ERRORS),A
 LD DE,NC_ADD_FAIL_TEXT
 CALL NH_PRINT
 CALL NX_CLEANUP
 CALL NC_ADD_CLEANUP
 XOR A
 LD (NC_PREP_MODE),A
 LD A,AS_IO
 SCF
 RET
NC_ADD_RAW_ID:
 LD HL,(NC_ADD_INDEX)
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 ADD HL,DE
 LD DE,NS_TABLE
