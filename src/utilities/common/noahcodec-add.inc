 SRL H
 RR L
 LD (NC_ADD_FCB+33),HL
 XOR A
 LD (NC_ADD_FCB+35),A
 LD DE,NC_META_DMA
 LD C,26
 CALL AC_BDOS
 LD DE,NC_ADD_FCB
 LD C,33
 CALL AC_BDOS
 OR A
 JP NZ,NC_META_BAD
 LD A,(NC_META_SLOT)
 LD E,A
 LD D,0
 LD HL,NC_META_DMA
 ADD HL,DE
 LD DE,NC_META_ROW
 LD A,(NC_META_WRITE)
 OR A
 JR Z,NC_META_TRANSFER
 EX DE,HL
NC_META_TRANSFER:
 LD BC,64
 LDIR
 LD A,(NC_META_WRITE)
 OR A
 JR Z,NC_META_CLOSE
 LD HL,NC_META_DMA
 LD DE,NR_CHECK
 LD BC,128
 LDIR
 LD DE,NC_ADD_FCB
 LD C,34
 CALL AC_BDOS
 OR A
 JP NZ,NC_META_BAD
 LD DE,NC_ADD_FCB
 LD C,33
 CALL AC_BDOS
 OR A
 JP NZ,NC_META_BAD
 LD HL,NC_META_DMA
 LD DE,NR_CHECK
 LD B,128
NC_META_COMPARE:
 LD A,(DE)
 CP (HL)
