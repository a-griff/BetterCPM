 LD DE,0
 CALL LBR_CRC16
 LD HL,(NC_META_ROW+62)
 OR A
 SBC HL,DE
 JP NZ,NC_ADD_ERROR
 CALL NC_ADD_RAW_ID
 LD DE,NC_META_ROW
 LD B,13
NC_META_CHECK_ID:
 LD A,(DE)
 CP (HL)
 JP NZ,NC_ADD_ERROR
 INC DE
 INC HL
 DJNZ NC_META_CHECK_ID
 OR A
 RET
NC_META_BAD:
