 LD A,H
 OR L
 JR Z,NC_ADD_COPY_DONE
 LD DE,NC_META_DMA
 LD C,26
 CALL AC_BDOS
 LD DE,NC_STAGE_FCB
 LD C,20
 CALL AC_BDOS
 OR A
 JP NZ,NC_ADD_COPY_BAD
 LD HL,NC_META_DMA
 LD B,128
NC_ADD_CRC_BYTES:
 LD A,(HL)
 PUSH HL
 PUSH BC
 CALL NR_CRC_BYTE
 POP BC
 POP HL
 INC HL
 DJNZ NC_ADD_CRC_BYTES
 LD HL,NC_ADD_POS
 LD DE,NC_ADD_FCB+33
 LD BC,3
 LDIR
 LD DE,NC_ADD_FCB
 LD C,34
 CALL AC_BDOS
 OR A
 JP NZ,NC_ADD_COPY_BAD
 LD DE,NR_CHECK
 LD C,26
 CALL AC_BDOS
 LD DE,NC_ADD_FCB
 LD C,33
 CALL AC_BDOS
 OR A
 JP NZ,NC_ADD_COPY_BAD
 LD HL,NC_META_DMA
 LD DE,NR_CHECK
 LD B,128
NC_ADD_VERIFY:
 LD A,(DE)
 CP (HL)
 JP NZ,NC_ADD_COPY_BAD
 INC HL
 INC DE
 DJNZ NC_ADD_VERIFY
 LD HL,NC_ADD_POS
 LD B,3
 CALL NR_INC
 JP C,NC_ADD_COPY_BAD
 LD HL,(NC_ADD_LEFT)
 DEC HL
 LD (NC_ADD_LEFT),HL
 CALL NX_POLL
 JP C,NC_ADD_COPY_BAD
 JP NC_ADD_COPY
NC_ADD_COPY_DONE:
 CALL NC_ADD_CLOSE_FILE
 JP C,NC_ADD_STAGE_BAD
 LD DE,NC_STAGE_FCB
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NC_ADD_ERROR
 ; A row contains original identity, original physical-byte digest, length,
 ; padding and aggregate position. Never expose this scratch format as an API.
 LD HL,NC_META_ROW
 LD DE,NC_META_ROW+1
 LD BC,63
 LD (HL),0
 LDIR
 CALL NC_ADD_RAW_ID
 LD DE,NC_META_ROW
 LD BC,13
 LDIR
 LD HL,NC_ORIGINAL_HASH
 LD BC,4
 LDIR
 LD HL,(NC_ADD_LENGTH)
 LD (NC_META_ROW+17),HL
 LD A,(NC_EXPECT)
 NEG
 AND 127
 LD (NC_META_ROW+19),A
 LD HL,NC_ADD_BEGIN
 LD DE,NC_META_ROW+20
 LD BC,3
 LDIR
 LD A,1
 LD (NC_META_ROW+23),A
 LD HL,NR_CRC
 LD DE,NC_META_ROW+24
 LD BC,4
 LDIR
 LD HL,NC_ORIGINAL_LENGTH
 LD DE,NC_META_ROW+30
 LD BC,4
 LDIR
 LD HL,(NC_ORIGINAL_CRC)
 LD (NC_META_ROW+34),HL
 LD HL,NC_EXPECT
 LD DE,NC_META_ROW+36
 LD BC,4
 LDIR
 LD HL,NC_META_ROW
 LD BC,62
 LD DE,0
 CALL LBR_CRC16
 LD (NC_META_ROW+62),DE
 CALL NC_META_UPDATE
 RET
NC_ADD_COPY_BAD:
 CALL NC_ADD_CLOSE_FILE
NC_ADD_STAGE_BAD:
 LD DE,NC_STAGE_FCB
 LD C,16
 CALL AC_BDOS
NC_ADD_ERROR:
 LD A,AS_IO
 SCF
 RET
NC_ADD_CREATE:
 CALL NC_ADD_GEOMETRY
 CALL NX_TEMP_PAIR
 RET C
 LD HL,NX_TEMP
 LD DE,NC_ADD_FCB
 LD BC,12
 LDIR
 LD HL,NC_STAGE
 LD DE,NX_TEMP
 LD BC,12
 LDIR
 LD HL,NC_ADD_FCB
 LD DE,NC_ADD_SPOOL
 LD BC,12
 LDIR
 LD HL,NC_ADD_FCB+12
 LD DE,NC_ADD_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,NC_ADD_FCB
 LD C,22
 CALL AC_BDOS
 CP 255
 JP Z,NC_ADD_ERROR
 LD A,1
 LD (NC_ADD_LIVE),A
 LD (NC_ADD_OPEN),A
 LD HL,(NS_COUNT)
 INC HL
 SRL H
 RR L
 LD (NC_ADD_POS),HL
 XOR A
 LD (NC_ADD_POS+2),A
 LD (NC_ADD_POS+3),A
 LD (NC_ADD_LEFT),HL
 LD HL,NC_META_DMA
 LD DE,NC_META_DMA+1
 LD BC,127
 LD (HL),0
 LDIR
NC_ADD_PREFIX:
 LD DE,NC_META_DMA
 LD C,26
 CALL AC_BDOS
 LD DE,NC_ADD_FCB
 LD C,21
 CALL AC_BDOS
 OR A
 JP NZ,NC_ADD_PREFIX_FAIL
 LD HL,(NC_ADD_LEFT)
 DEC HL
 LD (NC_ADD_LEFT),HL
 LD A,H
 OR L
 JR NZ,NC_ADD_PREFIX
 JP NC_ADD_CLOSE_FILE
NC_ADD_PREFIX_FAIL:
 CALL NC_ADD_CLOSE_FILE
 JP NC_ADD_ERROR
 ; The target drive can differ from the invocation drive. Get its DPB using
 ; standard CP/M functions, then restore the entry drive immediately.
NC_ADD_GEOMETRY:
 LD C,25
 CALL AC_BDOS
 LD (NC_ADD_ENTRY_DRIVE),A
 LD A,(NH_DEST)
 LD E,A
 LD C,14
 CALL AC_BDOS
 PUSH IX
 PUSH IY
 LD C,31
 CALL 5
 LD DE,4
 ADD HL,DE
 LD A,(HL)
 LD (NC_ADD_EXM),A
 POP IY
 POP IX
 LD A,(NC_ADD_ENTRY_DRIVE)
 LD E,A
 LD C,14
 JP AC_BDOS
; Preserve the high-water FCB for the physical extent holding this metadata
; row. A random write to an earlier logical extent can lower its directory EX
; on some CP/M implementations. Restore the complete, already allocated map
; and high-water EX/RC before CLOSE; no payload allocation occurs in metadata.
NC_META_HIGH_WATER:
 LD A,(NC_ADD_EXM)
 LD L,A
 LD H,0
 LD B,7
NC_META_MASK_SHIFT:
 ADD HL,HL
 DJNZ NC_META_MASK_SHIFT
 LD A,L
 OR 127
 LD L,A
 LD DE,(NC_ADD_INDEX)
 SRL D
 RR E
 LD A,L
 OR E
 LD L,A
 LD A,H
 OR D
 LD H,A
 LD DE,(NC_ADD_POS)
 DEC DE
 LD A,(NC_ADD_POS+2)
 OR A
 JR NZ,NC_META_HIGH_READY
 PUSH HL
 OR A
 SBC HL,DE
 POP HL
 JR C,NC_META_HIGH_READY
 EX DE,HL
NC_META_HIGH_READY:
 LD (NC_ADD_FCB+33),HL
 XOR A
 LD (NC_ADD_FCB+35),A
 LD DE,NR_CHECK
 LD C,26
 CALL AC_BDOS
 LD DE,NC_ADD_FCB
 LD C,33
 CALL AC_BDOS
 OR A
 JP NZ,NC_ADD_ERROR
 LD HL,NC_ADD_FCB
 LD DE,NC_META_SAVED_FCB
 LD BC,36
 LDIR
 OR A
 RET
 ; DE is an already-open aggregate FCB. Read the last committed record so
 ; CLOSE describes the current complete physical extent, including when this
 ; handle was used only for prefix metadata or an earlier source's payload.
NC_ADD_TAIL:
 PUSH DE
 LD HL,33
 ADD HL,DE
 EX DE,HL
 LD HL,NC_ADD_POS
 LD BC,3
 LDIR
 POP DE
 PUSH DE
 LD HL,33
 ADD HL,DE
 LD A,(HL)
 SUB 1
 LD (HL),A
 INC HL
 LD A,(HL)
 SBC A,0
 LD (HL),A
 INC HL
 LD A,(HL)
 SBC A,0
 LD (HL),A
 LD DE,NR_CHECK
 LD C,26
 CALL AC_BDOS
 POP DE
 LD C,33
 CALL AC_BDOS
 OR A
 RET Z
 LD A,AS_IO
 SCF
 RET
NC_ADD_OPEN_FILE:
 LD HL,NC_ADD_SPOOL
 LD DE,NC_ADD_FCB
 LD BC,12
 LDIR
 LD HL,NC_ADD_FCB+12
 LD DE,NC_ADD_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,NC_ADD_FCB
 LD C,15
 CALL AC_BDOS
 CP 255
 JP Z,NC_ADD_ERROR
 LD A,1
 LD (NC_ADD_OPEN),A
 OR A
 RET
NC_ADD_CLOSE_FILE:
 LD A,(NC_ADD_OPEN)
 OR A
 RET Z
 LD DE,NC_ADD_FCB
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NC_ADD_ERROR
 XOR A
 LD (NC_ADD_OPEN),A
