 RET
NC_ADD_APPEND:
 LD HL,NX_TEMP
 LD DE,NC_STAGE
 LD BC,12
 LDIR
 LD A,(NC_ADD_LIVE)
 OR A
 CALL Z,NC_ADD_CREATE
 RET C
 CALL NW_TARGET_USER
 LD HL,NC_STAGE
 LD DE,NC_STAGE_FCB
 LD BC,12
 LDIR
 LD HL,NC_STAGE_FCB+12
 LD DE,NC_STAGE_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,NC_STAGE_FCB
 LD C,15
 CALL AC_BDOS
 CP 255
 JP Z,NC_ADD_ERROR
 LD DE,NC_STAGE_FCB
 LD C,35
 CALL AC_BDOS
 LD A,(NC_STAGE_FCB+35)
 OR A
 JP NZ,NC_ADD_STAGE_BAD
 LD HL,(NC_STAGE_FCB+33)
 LD (NC_ADD_LENGTH),HL
 LD (NC_ADD_LEFT),HL
 LD HL,NC_ADD_POS
 LD DE,NC_ADD_BEGIN
 LD BC,3
 LDIR
 CALL NC_ADD_OPEN_FILE
 JP C,NC_ADD_STAGE_BAD
 LD HL,NR_CRC
 LD B,4
NC_ADD_CRC_RESET:
