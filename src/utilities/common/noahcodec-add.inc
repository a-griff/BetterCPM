NC_META_READ:
 XOR A
 LD (NC_META_WRITE),A
 JR NC_META_IO
NC_META_UPDATE:
 LD A,1
 LD (NC_META_WRITE),A
NC_META_IO:
 CALL NW_TARGET_USER
 CALL NC_ADD_OPEN_FILE
 RET C
 CALL NC_META_HIGH_WATER
 JP C,NC_META_BAD
 LD HL,(NC_ADD_INDEX)
 LD A,L
 AND 1
 ADD A,A
 ADD A,A
 ADD A,A
 ADD A,A
 ADD A,A
 ADD A,A
