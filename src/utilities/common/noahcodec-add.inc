; Compressed ADD phase plan is disk-backed: one private scratch LBR-independent
; file, 64-byte rows followed by verified encoded records. Frozen original IDs
; remain in NS_TABLE. Transformed IDs and writer plans share inactive codec RAM.
NC_ADD_PREPARE:
 XOR A
 LD (NC_ADD_ACTIVE),A
 LD (NC_ADD_LIVE),A
 LD (NC_ADD_OPEN),A
 LD HL,0
 LD (NC_ADD_INDEX),HL
 LD (NC_ADD_COUNT),HL
 LD A,1
 LD (NC_PREP_MODE),A
NC_ADD_NEXT:
 LD HL,(NC_ADD_INDEX)
 LD DE,(NS_COUNT)
 OR A
 SBC HL,DE
 JP Z,NC_ADD_READY
 CALL NC_ADD_RAW_ID
 LD (NS_CURRENT),HL
 LD DE,NW_TARGET
 LD B,13
NC_ADD_SELF:
 LD A,(DE)
 CP (HL)
 JR NZ,NC_ADD_CANDIDATE
 INC DE
 INC HL
 DJNZ NC_ADD_SELF
 LD A,2
 LD HL,(NC_ADD_INDEX)
 CALL NA_SET
 LD DE,NW_SELF_TEXT
 CALL NH_PRINT
 JR NC_ADD_ADVANCE
NC_ADD_CANDIDATE:
 CALL NC_SOURCE
 LD A,(NC_RESULT)
 CP 1
 JR NZ,NC_ADD_SKIP
 CALL NC_ADD_APPEND
 JP C,NC_ADD_ABORT
 LD HL,(NC_ADD_COUNT)
 INC HL
 LD (NC_ADD_COUNT),HL
NC_ADD_SKIP:
 LD A,(NC_RESULT)
 CP 1
 JR Z,NC_ADD_STATUS
 LD A,2
 JR C,NC_ADD_STATUS
 LD A,(NH_ERROR)
 CP AS_CANCEL
 LD A,0
 JR Z,NC_ADD_STATUS
 LD A,3
NC_ADD_STATUS:
 LD HL,(NC_ADD_INDEX)
 CALL NA_SET
 LD A,(NC_RESULT)
 CP 2
 JR NZ,NC_ADD_SKIP_CLEANUP
 LD A,1
 LD (NS_ERRORS),A
NC_ADD_SKIP_CLEANUP:
 CALL NX_CLEANUP
 LD A,(NH_ABORTED)
 LD B,A
 LD A,(NS_STOP)
 OR B
 JP NZ,NC_ADD_ABORT
 LD A,(NC_RESULT)
 CP 1
 JR Z,NC_ADD_ADVANCE
 LD A,1
 LD (NS_WARNINGS),A
NC_ADD_ADVANCE:
 LD HL,(NC_ADD_INDEX)
 INC HL
 LD (NC_ADD_INDEX),HL
 JP NC_ADD_NEXT
NC_ADD_READY:
 XOR A
 LD (NC_PREP_MODE),A
 LD HL,(NC_ADD_COUNT)
 LD A,H
 OR L
 RET Z
 LD A,(NC_ARC_PREP)
 OR A
 JR NZ,NC_ADD_ACTIVATE
 CALL NW_CHECK_ID_MEMORY
 JR NC,NC_ADD_ID_MEMORY_OK
 LD DE,NW_MEMORY_TEXT
 CALL NH_PRINT
 JP NC_ADD_ABORT
NC_ADD_ID_MEMORY_OK:
 LD HL,(NS_COUNT)
 LD D,H
 LD E,L
 ADD HL,HL
 ADD HL,DE
 ADD HL,HL
 ADD HL,HL
 ADD HL,DE
 LD B,H
 LD C,L
 LD HL,NS_TABLE
 LD DE,NC_ADD_IDS
 LDIR
 LD HL,0
 LD (NC_ADD_INDEX),HL
NC_ADD_NAMES:
 CALL NC_ADD_RAW_ID
 LD DE,NS_TABLE
 OR A
 SBC HL,DE
 LD DE,NC_ADD_IDS+10
 ADD HL,DE
 CALL NC_NAME_MARK
 LD HL,(NC_ADD_INDEX)
 INC HL
 LD (NC_ADD_INDEX),HL
 LD DE,(NS_COUNT)
 OR A
 SBC HL,DE
 JR NZ,NC_ADD_NAMES
NC_ADD_ACTIVATE:
 LD A,1
 LD (NC_ADD_ACTIVE),A
 OR A
 RET
NC_ADD_ABORT:
 LD A,(NH_ABORTED)
 OR A
 JR NZ,NC_ADD_ABORT_REPORT
 LD A,3
 LD HL,(NC_ADD_INDEX)
 CALL NA_SET
NC_ADD_ABORT_REPORT:
