; Supplemental ARK controller. All code/scratch lives in the inactive LBR
; writer-plan/identity arena; no additional resident buffers or TPA are needed.
 JP ARK_OPEN
 JP NK_ARCHIVE
 JP ARK_NEXT
 JP NK_READ
 JP NK_MEMBER
 JP NK_REPORT
 JP NK_TRAILER
 JP NK_STAMP
 JP NK_RESET
; Stable writer API slots follow the original nine reader/controller entries.
NAW_BUILD_HEADER: JP ARK_BUILD_HEADER
NAW_WRITE_MEMBER: JP ARK_WRITE_MEMBER
NAW_WRITE_END: JP ARK_WRITE_END
NAW_COPY_MEMBER: JP ARK_COPY_MEMBER
NAW_AUDIT: JP NK_DUPLICATE_AUDIT
 ARK_CODE
; Validate every member boundary and reject duplicate canonical names before
; a write transaction can stage output. The second context is private scratch.
NK_DUPLICATE_AUDIT:
 CALL ARK_OPEN
 RET C
NK_DUP_OUTER:
 CALL ARK_NEXT
 JR C,NK_DUP_END
 ; Verify every supported method while checking the staged archive. New and
 ; retained members therefore pass the reader's full length/CRC decoder before
 ; the caller is allowed to publish the file.
 LD A,(NH_CONTEXT+AS_MEMBER+AM_METHOD)
 CP 10
 JR NC,NK_DUP_TEST_DONE
 CALL NK_TEST
 RET C
NK_DUP_TEST_DONE:
 LD HL,NH_CONTEXT
 LD DE,NK_SECOND
 LD BC,AS_PHASE
 LDIR
 PUSH IX
 LD IX,NK_SECOND
 CALL ARK_OPEN
 POP IX
 RET C
NK_DUP_INNER:
 PUSH IX
 LD IX,NK_SECOND
 CALL ARK_NEXT
 POP IX
 JR C,NK_DUP_INNER_END
 LD HL,NH_CONTEXT+AS_MEMBER+AM_ID
 LD DE,NK_SECOND+AS_MEMBER+AM_ID
 LD B,4
NK_DUP_ID:
 LD A,(DE)
 CP (HL)
 JR NZ,NK_DUP_NAME
 INC DE
 INC HL
 DJNZ NK_DUP_ID
 JR NK_DUP_OUTER
NK_DUP_NAME:
 LD HL,NH_CONTEXT+AS_MEMBER
 LD DE,NK_SECOND+AS_MEMBER
 LD B,11
NK_DUP_NAME_LOOP:
 LD A,(DE)
 CP (HL)
 JR NZ,NK_DUP_INNER
 INC DE
 INC HL
 DJNZ NK_DUP_NAME_LOOP
 LD A,AS_DUPLICATE
 SCF
 RET
NK_DUP_INNER_END:
 CP AS_END
 JR Z,NK_DUP_OUTER
 SCF
 RET
NK_DUP_END:
 CP AS_END
 RET Z
 SCF
 RET
NK_ARCHIVE:
 LD A,(NH_MODE)
 OR A
 JP Z,NH_LIST_START
 ; No directory CRC in ARC. Counters count selected members only.
 LD HL,NH_AUDIT
 LD DE,NH_AUDIT+1
 LD BC,LA_SIZE-1
 LD (HL),0
 LDIR
 CALL ARK_OPEN
 JP C,NH_FAILED
NK_AUDIT_NEXT:
 CALL ARK_NEXT
 JR C,NK_AUDIT_END
 ; Validate every normalized name against all preceding headers, including
 ; unselected/unsupported members, before extraction creates any output.
 LD HL,NH_CONTEXT
 LD DE,NK_SECOND
 LD BC,AS_PHASE
 LDIR
 PUSH IX
 LD IX,NK_SECOND
 CALL ARK_OPEN
 POP IX
 JP C,NK_AUDIT_FAIL
NK_PRIOR:
 PUSH IX
 LD IX,NK_SECOND
 CALL ARK_NEXT
 POP IX
 JP C,NK_AUDIT_FAIL
 LD HL,NH_CONTEXT+AS_MEMBER+AM_ID
 LD DE,NK_SECOND+AS_MEMBER+AM_ID
 LD B,4
NK_ID_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,NK_COMPARE_NAME
 INC DE
 INC HL
 DJNZ NK_ID_COMPARE
 JR NK_FILTER
NK_COMPARE_NAME:
 LD HL,NH_CONTEXT+AS_MEMBER
 LD DE,NK_SECOND+AS_MEMBER
 LD B,11
NK_NAME_COMPARE:
 LD A,(DE)
 CP (HL)
 JR NZ,NK_PRIOR
 INC DE
 INC HL
 DJNZ NK_NAME_COMPARE
 LD A,AS_DUPLICATE
 JR NK_AUDIT_FAIL
NK_FILTER:
 CALL NS_MEMBER_MATCH
 JR Z,NK_SELECTED
 LD HL,NH_AUDIT+LA_NOT_SELECTED
 CALL NX_INC_COUNT
 JR NK_AUDIT_NEXT
NK_SELECTED:
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 10
 JR NC,NK_UNCHECKED
 CALL NK_TEST
 JR C,NK_AUDIT_FAIL
 LD HL,NH_AUDIT+LA_CHECKED
 CALL NX_INC_COUNT
 JR NK_AUDIT_NEXT
NK_UNCHECKED:
 LD HL,NH_AUDIT+LA_UNCHECKED
 CALL NX_INC_COUNT
 LD A,1
 LD (NS_WARNINGS),A
 JR NK_AUDIT_NEXT
NK_AUDIT_END:
 CP AS_END
 JR NZ,NK_AUDIT_FAIL
 CALL NA_AUDIT
 LD A,(NH_MODE)
 CP 2
 JR NZ,NK_TEST_LIST
 CALL NK_TRAILER
 JP NX_EXTRACT
NK_TEST_LIST:
 CALL ARK_OPEN
 JP C,NH_FAILED
 JP NH_LIST_START
NK_AUDIT_FAIL:
 SCF
 CALL NA_AUDIT
 JP NH_FAILED
; Called before output authorization. Unsupported codecs are a bounded skip;
; they must never reach RAW/extraction as if their bytes were decoded.
NK_MEMBER:
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 10
 JR NC,NK_MEMBER_UNSUPPORTED
 CP 5
 JR NC,NK_MEMBER_READY
 CALL NK_TEST
 RET C
NK_MEMBER_READY:
 CALL NK_RESET
 XOR A
 RET
NK_MEMBER_UNSUPPORTED:
 CALL NK_UNSUPPORTED
 LD A,AS_UNSUPPORTED
 OR A
 RET
NK_UNSUPPORTED:
 LD HL,NH_CONTEXT+AS_MEMBER
 LD B,11
 CALL NH_PRINT_FIELD
 LD DE,NK_METHOD_TEXT
 CALL NH_PRINT
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CALL NH_HEX
 LD DE,NK_UNSUPPORTED_TEXT
 CALL NH_PRINT
 LD A,1
 LD (NS_WARNINGS),A
 RET
NK_REPORT:
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 10
 JR C,NK_REPORT_STORED
 CALL NK_UNSUPPORTED
 JP NH_LIST_CONTINUE
NK_REPORT_STORED:
 LD A,(NH_MODE)
 OR A
 JP Z,NH_LIST_CONTINUE
 LD DE,NH_CRC_VERIFIED
 CALL NH_PRINT
 JP NH_LIST_CONTINUE
NK_TRAILER:
 LD A,(IX+AS_UNUSED_SEEN)
 CP 2
 RET NZ
 LD A,1
 LD (NS_WARNINGS),A
 LD DE,NK_TRAILER_TEXT
 JP NH_PRINT
NK_METHOD_TEXT: DB ' ARK method ', '$'
NK_UNSUPPORTED_TEXT: DB ': unsupported; contents/CRC not tested.',13,10,'$'
NK_TRAILER_TEXT: DB 'ARK opaque trailer: unvalidated.',13,10,'$'
NK_STAMP:
 ; Raw DOS words are not LUDEF dates. There is no safe conversion/setter in
 ; this increment; explicitly report nonzero metadata without interpreting it.
 LD HL,NH_CONTEXT+AS_MEMBER+AM_DATES
 LD B,4
 XOR A
NK_STAMP_SCAN:
 OR (HL)
 INC HL
 DJNZ NK_STAMP_SCAN
 JP Z,NX_NEXT
 LD A,1
 LD (NS_WARNINGS),A
 LD DE,NK_STAMP_TEXT
 CALL NH_PRINT
 JP NX_NEXT
NK_STAMP_TEXT: DB 'ARK DOS timestamp not restored; metadata retained in source.',13,10,'$'
NK_SECOND: DS AS_CONTEXT_SIZE
