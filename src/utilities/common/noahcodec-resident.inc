; Resident codec bridge. The private stack and every return address survive
; window replacement; restore the verified controller before returning to it.
NR_CODEC:
 LD (NR_SELECTED),A
 OR A
 JR Z,NR_PHASE_SAFE
 LD A,(NC_ADD_ACTIVE)
 OR A
 JR Z,NR_PHASE_SAFE
 LD A,(NR_SELECTED)
 CP 7
 JR NZ,NR_PHASE_BUSY
 LD A,(NW_ARC_VERIFY)
 OR A
 JR NZ,NR_PHASE_SAFE
NR_PHASE_BUSY:
 LD A,6
 SCF
 RET
NR_PHASE_SAFE:
 PUSH IX
 PUSH IY
 LD E,255
 LD C,32
 CALL NR_BDOS
 LD (NR_PHASEUSER),A
 LD A,(NR_SELECTED)
 OR A
 CALL NZ,NR_LOAD
 JP C,NR_FATAL
 LD A,(NR_PHASEUSER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD HL,NR_CRC
 LD B,4
NR_HASH_RESET:
 LD (HL),255
 INC HL
 DJNZ NR_HASH_RESET
 XOR A
 LD (NR_CRC16),A
 LD (NR_CRC16+1),A
 LD (NR_INUSED),A
 LD (NR_OUTUSED),A
 LD (NR_INOPEN),A
 LD HL,NR_TOTAL
 LD B,11
NR_IO_RESET:
 LD (HL),0
 INC HL
 DJNZ NR_IO_RESET
 LD HL,NR_SOURCE
 LD DE,NR_INPUT
 LD BC,12
 LDIR
 LD HL,NR_INPUT+12
 LD DE,NR_INPUT+13
 LD BC,23
 LD (HL),0
 LDIR
 LD A,(NR_SOURCE_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_INPUT
 LD C,15
 CALL NR_BDOS
 CP 255
 JP Z,NR_CODEC_IOERR
 LD A,1
 LD (NR_INOPEN),A
 CALL NR_SOURCE_BOUNDS
 JP C,NR_CODEC_IOERR
 LD A,(NR_SELECTED)
 OR A
 JP Z,NR_CODEC_COPY
 LD A,(NR_SELECTED)
 CP 7
 JP Z,NR_PHASE_RUN
 LD IX,NR_CONTEXT
 LD HL,NR_CONTEXT
 LD DE,NR_CONTEXT+1
 LD BC,15
 LD (HL),0
 LDIR
 LD (IX+0),1
 LD HL,NR_READ
 LD (IX+6),L
 LD (IX+7),H
 LD HL,NR_WRITE
 LD (IX+8),L
 LD (IX+9),H
 LD HL,NR_REWIND
 LD (IX+10),L
 LD (IX+11),H
 LD HL,(NR_DESCRIPTOR)
 LD DE,8
 ADD HL,DE
 LD E,(HL)
 INC HL
 LD D,(HL)
 EX DE,HL
 LD DE,2048
 OR A
 SBC HL,DE
 LD (IX+14),L
 LD (IX+15),H
 LD HL,NR_NAME
 LD DE,NR_CONTEXT+64
 LD BC,128
 LDIR
NR_PHASE_RUN:
 CALL NR_WINDOW
 JR C,NR_CODEC_FINISH
 CALL NR_WINDOW+3
 JR C,NR_CODEC_FINISH
 CALL NR_WINDOW+6
 JR C,NR_CODEC_FINISH
 CALL NR_FINAL_RECORD
 JP NR_CODEC_FINISH
NR_CODEC_COPY:
 CALL NR_READ
 JR C,NR_COPY_END
 CALL NR_WRITE
 JR C,NR_CODEC_FINISH
 JR NR_CODEC_COPY
NR_COPY_END:
 OR A
 JR NZ,NR_COPY_ERROR
 CALL NR_FINAL_RECORD
 JP NR_CODEC_FINISH
NR_COPY_ERROR:
 SCF
NR_CODEC_FINISH:
 LD (NR_STATUS),A
 LD A,0
 ADC A,0
 LD (NR_CARRY),A
 LD A,(NR_SELECTED)
 CP 3
 JR NZ,NR_COPY_CR_NAME
 LD HL,NR_CONTEXT+32
 JR NR_SAVE_NAME
NR_COPY_CR_NAME:
 CP 5
 JR NZ,NR_CODEC_CLOSE
 LD HL,NR_CONTEXT+64
NR_SAVE_NAME:
 LD DE,NR_NAME
 LD BC,128
 LDIR
NR_CODEC_CLOSE:
 LD A,(NR_INOPEN)
 OR A
 JR Z,NR_CODEC_RELOAD
 LD A,(NR_SOURCE_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_INPUT
 LD C,16
 CALL NR_BDOS
 CP 255
 JR NZ,NR_INPUT_CLOSED
 LD A,1
 LD (NR_CARRY),A
 LD A,7
 LD (NR_STATUS),A
 JR NR_CODEC_RELOAD
NR_INPUT_CLOSED:
 XOR A
 LD (NR_INOPEN),A
NR_CODEC_RELOAD:
 LD HL,NR_CRC
 LD DE,NR_DIGEST
 LD BC,4
 LDIR
 LD A,(NR_SELECTED)
 OR A
 JR Z,NR_NO_RELOAD
 LD A,1
 CALL NR_LOAD
 JP C,NR_FATAL
 LD A,(NR_SELECTED)
 CP 7
 JR NZ,NR_NO_RELOAD
 LD A,6
 CALL NR_LOAD
 JP C,NR_FATAL
NR_NO_RELOAD:
 LD A,(NR_PHASEUSER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 POP IY
 POP IX
 LD A,(NR_CARRY)
 OR A
 LD A,(NR_STATUS)
 RET Z
 SCF
 RET
NR_CODEC_IOERR:
 LD A,7
 SCF
 JP NR_CODEC_FINISH
NR_REWIND:
 XOR A
 LD (NR_INUSED),A
 LD HL,NR_CONSUMED
 LD B,7
NR_REWIND_ZERO:
 LD (HL),0
 INC HL
 DJNZ NR_REWIND_ZERO
 RET
NR_READ:
 LD HL,NR_CONSUMED
 LD DE,NR_LIMIT
 LD B,4
NR_INPUT_END_CHECK:
 LD A,(DE)
 CP (HL)
 JR NZ,NR_INPUT_MORE
 INC HL
 INC DE
 DJNZ NR_INPUT_END_CHECK
 XOR A
 SCF
 RET
NR_INPUT_MORE:
 LD A,(NR_INUSED)
 OR A
 JR NZ,NR_INPUT_BYTE
 CALL NR_IO_POLL
 RET C
 LD HL,NR_INREC
 LD DE,NR_INPUT+33
 LD BC,3
 LDIR
 LD A,(NR_SOURCE_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_INBUF
 LD C,26
 CALL NR_BDOS
 LD DE,NR_INPUT
 LD C,33
 CALL NR_BDOS
 OR A
 JP NZ,NR_CALLBACK_ERROR
 LD HL,NR_INREC
 LD B,3
 CALL NR_INC
 RET C
 LD HL,NR_INBUF
 LD (NR_INPTR),HL
 LD A,128
 LD (NR_INUSED),A
NR_INPUT_BYTE:
 LD HL,NR_CONSUMED
 LD B,4
 CALL NR_INC
 RET C
 LD HL,(NR_INPTR)
 LD A,(HL)
 INC HL
 LD (NR_INPTR),HL
 LD HL,NR_INUSED
 DEC (HL)
 OR A
 RET
NR_WRITE:
 LD (NR_BYTE),A
 LD HL,NR_TOTAL
 LD B,4
 CALL NR_INC
 RET C
 LD A,(NR_BYTE)
 CALL NR_CRC16_BYTE
 LD A,(NR_BYTE)
 CALL NR_CRC_BYTE
 LD A,(NR_SINK)
 OR A
 RET Z
 LD A,(NR_OUTUSED)
 LD E,A
 LD D,0
 LD HL,NR_OUTBUF
 ADD HL,DE
 LD A,(NR_BYTE)
 LD (HL),A
 LD HL,NR_OUTUSED
 INC (HL)
 LD A,(HL)
 CP 128
 JR Z,NR_RECORD_OUTPUT
 OR A
 RET
NR_RECORD_OUTPUT:
 CALL NR_IO_POLL
 RET C
 LD A,(NR_DESTUSER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD A,(NR_SINK)
 CP 2
 LD DE,NR_OUTBUF
 JR NZ,NR_OUTPUT_DMA
 LD DE,NR_CHECK
NR_OUTPUT_DMA:
 LD C,26
 CALL NR_BDOS
 LD DE,(NR_OUTFCB)
 LD C,21
 LD A,(NR_SINK)
 CP 2
 JR NZ,NR_OUTPUT_CALL
 LD C,20
NR_OUTPUT_CALL:
 CALL NR_BDOS
 OR A
 JP NZ,NR_CALLBACK_ERROR
 LD A,(NR_SINK)
 CP 2
 JR NZ,NR_OUTPUT_CLEAR
 LD HL,NR_OUTBUF
 LD DE,NR_CHECK
 LD B,128
NR_OUTPUT_COMPARE:
 LD A,(DE)
 CP (HL)
 JP NZ,NR_CALLBACK_ERROR
 INC HL
 INC DE
 DJNZ NR_OUTPUT_COMPARE
NR_OUTPUT_CLEAR:
 XOR A
 LD (NR_OUTUSED),A
 RET
NR_FINAL_RECORD:
 LD A,(NR_OUTUSED)
 OR A
 JR Z,NR_OUTPUT_EOF
 LD E,A
 LD D,0
 LD HL,NR_OUTBUF
 ADD HL,DE
 LD A,128
 SUB E
 LD B,A
 LD A,26
NR_PAD_OUTPUT:
 LD (HL),A
 INC HL
 DJNZ NR_PAD_OUTPUT
 CALL NR_RECORD_OUTPUT
 RET C
NR_OUTPUT_EOF:
 LD A,(NR_SINK)
 CP 2
 JR Z,NR_CHECK_EOF
 XOR A
 RET
NR_CHECK_EOF:
 LD DE,NR_CHECK
 LD C,26
 CALL NR_BDOS
 LD DE,(NR_OUTFCB)
 LD C,20
 CALL NR_BDOS
 CP 1
 JP NZ,NR_CALLBACK_ERROR
 XOR A
 RET
NR_INC:
 OR A
NR_INC_LOOP:
 INC (HL)
 RET NZ
 INC HL
 DJNZ NR_INC_LOOP
NR_CALLBACK_ERROR:
 LD A,1
 SCF
 RET
NR_IO_POLL:
 LD E,255
 LD C,6
 CALL NR_BDOS
 CP 3
 JR Z,NR_IO_CANCEL
 OR A
 RET
NR_IO_CANCEL:
 LD A,1
 LD (NH_ABORTED),A
 SCF
 RET

; The logical limit may exclude only the last record's padding, never whole
; unvalidated records. Check physical size again on every reopened pass.
NR_SOURCE_BOUNDS:
 LD DE,NR_INPUT
 LD C,35
 CALL NR_BDOS
 LD HL,NR_LIMIT
 LD A,(NR_SELECTED)
 CP 7
 JR NZ,NR_BOUND_READY
 LD HL,NH_CONTEXT+AS_FILE_SIZE
NR_BOUND_READY:
 LD DE,NR_EXPECT_SIZE
 LD BC,4
 LDIR
 LD HL,NR_EXPECT_SIZE
 LD A,(HL)
 ADD A,127
 LD (HL),A
 INC HL
 LD B,3
NR_SIZE_CARRY:
 LD A,(HL)
 ADC A,0
 LD (HL),A
 INC HL
 DJNZ NR_SIZE_CARRY
 JP C,NR_CALLBACK_ERROR
 LD B,7
NR_SIZE_SHIFT:
 LD HL,NR_EXPECT_SIZE+3
 SRL (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DEC HL
 RR (HL)
 DJNZ NR_SIZE_SHIFT
 LD HL,NR_EXPECT_SIZE
 LD DE,NR_INPUT+33
 LD B,3
NR_SIZE_COMPARE:
 LD A,(DE)
 CP (HL)
 JP NZ,NR_CALLBACK_ERROR
 INC DE
 INC HL
 DJNZ NR_SIZE_COMPARE
 OR A
 RET
NR_CLEAN_INPUT:
 LD A,(NR_INOPEN)
 CP 1
 RET NZ
 LD A,(NR_SOURCE_USER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NR_INPUT
 LD C,16
 CALL NR_BDOS
 CP 255
 JR Z,NR_CLEAN_INPUT_DONE
 XOR A
 LD (NR_INOPEN),A
NR_CLEAN_INPUT_DONE:
 LD A,(NH_DUSER)
 LD E,A
 LD C,32
 JP NR_BDOS
NR_RECOVERY_CLOSE:
 CALL NR_CLOSE
 CALL NR_CLEAN_INPUT
 LD A,(NH_DUSER)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD A,(NX_TEMP_OPEN)
 CP 1
 LD DE,NX_TEMP
 CALL Z,NR_CLOSE_FCB
 LD A,(NX_VERIFY_OPEN)
 CP 1
 LD DE,NX_VERIFY
 CALL Z,NR_CLOSE_FCB
 LD A,(NC_ADD_OPEN)
 CP 1
 LD DE,NC_ADD_FCB
 CALL Z,NR_CLOSE_FCB
 LD A,(NH_ADAPTER+44)
 CP 1
 RET NZ
 LD A,(NH_ADAPTER+176)
 LD E,A
 LD C,32
 CALL NR_BDOS
 LD DE,NH_ADAPTER
NR_CLOSE_FCB:
 LD C,16
 JP NR_BDOS
NR_RECOVERY_NAMES:
 LD A,(NX_LIVE)
 CP 1
 LD HL,NX_TEMP
 CALL Z,NR_RECOVERY_NAME
 LD A,(NC_SPOOL_LIVE)
 CP 1
 LD HL,NC_SPOOL
 CALL Z,NR_RECOVERY_NAME
 LD A,(NC_ADD_LIVE)
 CP 1
 LD HL,NC_ADD_SPOOL
 CALL Z,NR_RECOVERY_NAME
 RET
NR_RECOVERY_NAME:
 LD DE,NR_RETAIN_TEXT
 CALL NR_PRINT
 LD A,(HL)
 ADD A,'A'-1
 LD E,A
 LD C,2
 CALL NR_BDOS
 LD DE,NR_USER_TEXT
 CALL NR_PRINT
 LD A,(NH_DUSER)
 CALL NR_HEX
 LD E,':'
 LD C,2
 CALL NR_BDOS
 INC HL
 LD B,11
NR_RECOVERY_FIELD:
 LD E,(HL)
 LD C,2
 CALL NR_BDOS
 INC HL
 DJNZ NR_RECOVERY_FIELD
 LD DE,NR_NEWLINE
 JP NR_PRINT
NR_HEX:
 PUSH AF
 RRCA
 RRCA
 RRCA
 RRCA
 CALL NR_NIBBLE
 POP AF
NR_NIBBLE:
 AND 15
 ADD A,'0'
 CP '9'+1
 JR C,NR_DIGIT
 ADD A,7
NR_DIGIT:
 LD E,A
 LD C,2
 JP NR_BDOS
; Z if a proposed output is the exact currently resolved companion identity.
NR_IS_MODULE:
 LD A,(NH_DUSER)
 LD B,A
 LD A,(NR_OVL_USER)
 CP B
 RET NZ
 LD A,(HL)
 LD B,A
 LD A,(NR_FCB)
 CP B
 RET NZ
 INC HL
 LD DE,NR_OVL_NAME
 LD B,11
NR_MODULE_NAME:
 LD A,(DE)
 CP (HL)
 RET NZ
 INC DE
 INC HL
 DJNZ NR_MODULE_NAME
 RET

; CRC-16/ARC of the actual emitted bytes. The raw preflight uses module zero,
; providing an input-derived checksum before an ARC encoder ever runs.
NR_CRC16_BYTE:
 LD HL,NR_CRC16
 XOR (HL)
 LD (HL),A
 LD B,8
NR_CRC16_BIT:
 LD HL,NR_CRC16+1
 SRL (HL)
 DEC HL
 RR (HL)
 JR NC,NR_CRC16_NEXT
 LD A,(HL)
 XOR 1
 LD (HL),A
 INC HL
 LD A,(HL)
 XOR 0A0H
 LD (HL),A
NR_CRC16_NEXT:
 DJNZ NR_CRC16_BIT
 RET
