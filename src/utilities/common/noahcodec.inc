; Compression policy in the controller; codec phases never call this code.
NC_OPTION:
 PUSH HL
 PUSH BC
 LD HL,NC_SQ_WORD
 CALL NW_TOKEN_IS
 JR Z,NC_OPT_SQ
 LD HL,NC_CR_WORD
 CALL NW_TOKEN_IS
 JR Z,NC_OPT_CR
 LD HL,NC_EX_WORD
 CALL NW_TOKEN_IS
 JR Z,NC_OPT_EXPAND
 POP BC
 POP HL
 XOR A
 RET
NC_OPT_SQ:
 LD C,2
 JR NC_OPT_CODEC
NC_OPT_CR:
 LD C,4
NC_OPT_CODEC:
 LD A,(NC_EXPAND)
 OR A
 JR NZ,NC_OPT_BAD
 LD A,(NC_REQUEST)
 OR A
 JR Z,NC_OPT_SAVE
 CP C
 JR NZ,NC_OPT_BAD
NC_OPT_SAVE:
 LD A,C
 LD (NC_REQUEST),A
 JR NC_OPT_OK
NC_OPT_EXPAND:
 LD A,(NC_REQUEST)
 OR A
 JR NZ,NC_OPT_BAD
 LD A,1
 LD (NC_EXPAND),A
NC_OPT_OK:
 POP BC
 POP HL
 LD A,1
 OR A
 RET
NC_OPT_BAD:
 POP BC
 POP HL
 SCF
 RET
NC_PARSE_MODE:
 LD A,(NC_REQUEST)
 OR A
 JR Z,NC_PARSE_EXPAND
 LD A,(NS_MODE_SET)
 OR A
 JR Z,NC_SET_ENCODE
 LD A,(NH_MODE)
 CP 3
 JP NZ,NS_BAD
 RET
NC_SET_ENCODE:
 LD A,(NC_REQUEST)
 CP 2
 LD A,6
 JR Z,NC_SET_MODE
 LD A,7
 JR NC_SET_MODE
NC_PARSE_EXPAND:
 LD A,(NC_EXPAND)
 OR A
 RET Z
 LD A,(NS_MODE_SET)
 OR A
 LD A,8
 JR Z,NC_SET_MODE
 LD A,(NH_MODE)
 CP 2
 JP NZ,NS_BAD
 RET
NC_SET_MODE:
 LD (NH_MODE),A
 LD A,(NW_COMPACT)
 OR A
 JP NZ,NS_BAD
 LD A,1
 LD (NS_MODE_SET),A
 RET
NC_PARSE_DEST:
 LD A,(NS_OPERANDS)
 CP 1
 RET Z
 LD HL,(NS_MEMBER_ARG)
 LD A,(NS_MEMBER_LEN)
 LD B,A
 LD A,(NS_OLD_DRIVE)
 LD D,A
 LD A,(NS_OLD_USER)
 LD E,A
 CALL DU_PARSE
 RET C
 LD A,B
 OR A
 JP NZ,NS_BAD
 CALL NS_DOMAIN
 RET C
 LD BC,0
 CALL DU_NEXT
 JP C,NS_BAD
 LD A,D
 LD (NH_DEST),A
 LD A,E
 LD (NH_DUSER),A
 CALL DU_NEXT
 JP NC,NS_BAD
 OR A
 RET
NC_SOURCE:
 CALL NC_RESET
 LD HL,(NS_CURRENT)
 LD A,(HL)
 INC A
 LD (NR_SOURCE),A
 INC HL
 LD A,(HL)
 LD (NR_SOURCE_USER),A
 INC HL
 LD DE,NR_SOURCE+1
 LD BC,11
 LDIR
 LD A,(NH_DUSER)
 LD (NR_DESTUSER),A
 CALL NW_TARGET_USER
 LD HL,NR_SOURCE
 LD DE,NX_FINAL
 LD BC,12
 LDIR
 LD A,(NH_DEST)
 INC A
 LD (NX_FINAL),A
 CALL NC_PLAIN_NAME
 CALL NC_SOURCE_SIZE
 JP C,NC_FAILED
 LD A,(NC_REQUEST)
 LD (NC_MODULE),A
 CP 4
 JR NZ,NC_SOURCE_MODULE_READY
 LD A,(NC_ARC_PREP)
 OR A
 JR Z,NC_SOURCE_MODULE_READY
 LD A,8
 LD (NC_MODULE),A
NC_SOURCE_MODULE_READY:
 LD A,(NC_MODULE)
 OR A
 JR NZ,NC_PREFLIGHT
 CALL NC_RECOGNIZE
 JP C,NC_FAILED
NC_PREFLIGHT:
 XOR A
 LD (NR_SINK),A
 CALL NR_CODEC
 JP C,NC_FAILED
 LD HL,NR_DIGEST
 LD DE,NC_ORIGINAL_HASH
 LD BC,4
 LDIR
 LD HL,NR_TOTAL
 LD DE,NC_ORIGINAL_LENGTH
 LD BC,4
 LDIR
 LD HL,(NR_CRC16)
 LD (NC_ORIGINAL_CRC),HL
 CALL NC_RUN
 JP C,NC_FAILED
 CALL NC_SAVE_EXPECTED
 LD A,(NC_REQUEST)
 OR A
 JR Z,NC_DECODED_NAME
 CALL NC_COMPRESSED_NAME
 JR NC,NC_AUTHORIZE
 JP NC_FAILED
NC_DECODED_NAME:
 LD A,(NC_MODULE)
 OR A
 JR Z,NC_ORDINARY
 CALL NC_HEADER_NAME
 JP C,NC_FAILED
 JR NC_AUTHORIZE
NC_ORDINARY:
 LD DE,NC_ORDINARY_TEXT
 CALL NH_PROGRESS
 LD HL,(NS_CURRENT)
 LD A,(HL)
 LD B,A
 LD A,(NH_DEST)
 CP B
 JR NZ,NC_AUTHORIZE
 INC HL
 LD A,(NH_DUSER)
 CP (HL)
 JP Z,NC_UNCHANGED
NC_AUTHORIZE:
 LD A,(NC_PREP_MODE)
 OR A
 JR NZ,NC_STAGE_OUTPUT
 CALL NO_AUTHORIZE
 JP C,NC_FAILED
 OR A
 JP Z,NC_UNCHANGED
NC_STAGE_OUTPUT:
 CALL NX_TEMP_PAIR
 JP C,NC_FAILED
 LD A,1
 LD (NX_ATTEMPTED),A
 LD DE,NX_TEMP
 LD C,22
 CALL AC_BDOS
 CP 255
 JP Z,NC_IO_FAILED
 LD A,1
 LD (NX_TEMP_OPEN),A
 LD (NX_LIVE),A
 LD (NR_SINK),A
 LD HL,NX_TEMP
 LD (NR_OUTFCB),HL
 CALL NC_RUN
 JP C,NC_FAILED
 CALL NC_COMPARE_EXPECTED
 JP C,NC_FAILED
 LD DE,NX_TEMP
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NC_CLOSE_FAILED
 XOR A
 LD (NX_TEMP_OPEN),A
 LD HL,NX_TEMP
 LD DE,NX_VERIFY
 LD BC,12
 LDIR
 LD DE,NX_VERIFY
 LD C,15
 CALL AC_BDOS
 CP 255
 JP Z,NC_IO_FAILED
 LD A,1
 LD (NX_VERIFY_OPEN),A
 LD A,2
 LD (NR_SINK),A
 LD HL,NX_VERIFY
 LD (NR_OUTFCB),HL
 CALL NC_RUN
 JP C,NC_FAILED
 CALL NC_COMPARE_EXPECTED
 JP C,NC_FAILED
 LD DE,NX_VERIFY
 LD C,16
 CALL AC_BDOS
 CP 255
 JP Z,NC_CLOSE_FAILED
 XOR A
 LD (NX_VERIFY_OPEN),A
 CALL NX_POLL
 JP C,NC_FAILED
 XOR A
 LD (NR_SINK),A
 CALL NR_CODEC
 JP C,NC_FAILED
 LD HL,NR_DIGEST
 LD DE,NC_ORIGINAL_HASH
 CALL NW_EQUAL4
 JP NZ,NC_IO_FAILED
 CALL NC_GROW_NOTE
 LD A,(NC_PREP_MODE)
 OR A
 JR Z,NC_PUBLISH_OUTPUT
 LD A,1
 LD (NC_RESULT),A
 LD A,(NS_QUIET)
 OR A
 RET NZ
 CALL NC_PRINT_SOURCE
 LD DE,NC_STORED_TEXT
 CALL NH_PRINT
 LD HL,NX_FINAL+1
 LD B,11
 CALL NH_PRINT_FIELD
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 RET
NC_PUBLISH_OUTPUT:
 CALL NO_PUBLISH
 JP C,NC_FAILED
 LD A,1
 LD (NC_RESULT),A
 LD HL,NX_FINAL
 LD DE,NC_DONE_TEXT
 CALL NH_PROGRESS_FCB
 JR NC_FINISH
NC_UNCHANGED:
 LD A,1
 LD (NS_WARNINGS),A
 LD DE,NC_UNCHANGED_TEXT
 CALL NH_PRINT
 JR NC_FINISH
NC_CLOSE_FAILED:
 LD A,1
 LD (NX_KEEP),A
NC_IO_FAILED:
 LD A,AS_IO
NC_FAILED:
 PUSH AF
 LD A,2
 LD (NC_RESULT),A
 POP AF
 LD (NH_ERROR),A
 LD A,1
 LD (NS_ARC_FAILED),A
 CALL NC_PRINT_SOURCE
 LD A,(NH_ABORTED)
 OR A
 JR Z,NC_REPORT_FAILURE
 LD DE,NX_CANCEL_TEXT
 CALL NH_PRINT
 JP NC_FINISH
NC_REPORT_FAILURE:
 LD DE,NC_FAILED_TEXT
 CALL NH_PRINT
 LD A,(NH_ERROR)
 CALL NH_HEX
 LD DE,NH_NEWLINE
 CALL NH_PRINT
 ; Restart only after confirmed source/stage cleanup, never over member
 ; spools, retained files or a publication/rollback boundary.
 LD A,(NC_RETURN_MODE)
 OR A
 JP NZ,NC_FINISH
 CALL NR_CLEAN_INPUT
 LD A,(NR_INOPEN)
 OR A
 JP NZ,NC_FINISH
 CALL NX_RETRY_CLEANUP
 JP C,NC_FINISH
 CALL NI_FAILURE
 JP C,NC_FINISH
 CP 'R'
 JP Z,NC_SOURCE
NC_FINISH:
 CALL NR_CLEAN_INPUT
 LD A,(NR_INOPEN)
 OR A
 JR Z,NC_INPUT_SAFE
 LD A,1
 LD (NS_STOP),A
 LD (NS_ARC_FAILED),A
 LD A,2
 LD (NC_RESULT),A
 CALL NC_PRINT_SOURCE
 LD DE,NC_INPUT_CLOSE_TEXT
 CALL NH_PRINT
NC_INPUT_SAFE:
 LD A,(NC_PREP_MODE)
 OR A
 RET NZ
 CALL NX_CLEANUP
 LD A,(NC_RETURN_MODE)
 OR A
 RET NZ
 LD A,(NC_RESULT)
 CP 1
 LD A,2
 JR NZ,NC_DISPOSITION
 DEC A
NC_DISPOSITION:
 LD (NS_DISPOSITION),A
 JP NS_ARCHIVE_DONE
NC_RESET:
 CALL NA_RESET_NAMES
 XOR A
 LD (NS_ARC_FAILED),A
 LD (NC_RESULT),A
 LD (NW_ACTIVE),A
 LD (NW_PROMPT),A
 LD (NX_TEMP_OPEN),A
 LD (NX_VERIFY_OPEN),A
 LD (NX_LIVE),A
 LD (NX_KEEP),A
 LD (NX_ATTEMPTED),A
 LD (NX_PUBLICATION),A
 LD HL,NX_FINAL
 LD DE,NX_FINAL+1
 LD BC,36*6-1
 LD (HL),0
 LDIR
 RET
NC_RUN:
 LD A,(NC_ARC_PREP)
 LD (NR_ARC_MODE),A
 LD A,(NC_MODULE)
 CALL NR_CODEC
 PUSH AF
 XOR A
 LD (NR_ARC_MODE),A
 POP AF
 RET
NC_SAVE_EXPECTED:
 LD HL,NR_TOTAL
 LD DE,NC_EXPECT
 LD BC,4
 LDIR
 LD HL,NR_DIGEST
 LD BC,4
 LDIR
 RET
NC_COMPARE_EXPECTED:
 LD HL,NR_TOTAL
 LD DE,NC_EXPECT
 CALL NW_EQUAL4
 JP NZ,LW_TRUNC
 LD HL,NR_DIGEST
 LD DE,NC_EXPECT+4
 CALL NW_EQUAL4
 JP NZ,LW_TRUNC
 LD A,(NC_REQUEST)
 OR A
 RET NZ
 LD A,(NC_MODULE)
 OR A
 RET Z
 LD HL,NX_FINAL
 LD DE,NC_NAME_SAVE
 LD BC,12
 LDIR
 CALL NC_HEADER_NAME
 RET C
 LD HL,NX_FINAL
 LD DE,NC_NAME_SAVE
 LD B,12
NC_COMPARE_NAME:
 LD A,(DE)
 CP (HL)
 JP NZ,LW_TRUNC
 INC DE
 INC HL
 DJNZ NC_COMPARE_NAME
 OR A
 RET
; Determine a bounded physical record length and inspect the first record.
NC_SOURCE_SIZE:
 LD HL,NR_SOURCE
 LD DE,NR_INPUT
 LD BC,12
 LDIR
 LD HL,NR_INPUT+12
 LD DE,NR_INPUT+13
 LD BC,23
 LD (HL),0
 LDIR
 LD A,(NR_SOURCE_USER)
 LD E,A
 LD C,32
 CALL AC_BDOS
 LD DE,NR_INPUT
 LD C,15
 CALL AC_BDOS
 CP 255
 JP Z,NC_SIZE_BAD
 LD A,1
 LD (NR_INOPEN),A
 LD DE,NR_INPUT
 LD C,35
 CALL AC_BDOS
 LD HL,(NR_INPUT+33)
 LD A,(NR_INPUT+35)
 LD C,A
 LD B,0
 LD D,7
NC_SIZE_SHIFT:
 ADD HL,HL
 RL C
 RL B
 DEC D
 JR NZ,NC_SIZE_SHIFT
 LD (NR_LIMIT),HL
 LD A,C
 LD (NR_LIMIT+2),A
 LD A,B
 LD (NR_LIMIT+3),A
 LD HL,NR_INBUF
 LD (HL),0
 INC HL
 LD (HL),0
 LD DE,NR_INBUF
 LD C,26
 CALL AC_BDOS
 XOR A
 LD (NR_INPUT+33),A
 LD (NR_INPUT+34),A
 LD (NR_INPUT+35),A
 LD DE,NR_INPUT
 LD C,33
 CALL AC_BDOS
 LD (NC_READ_RESULT),A
 LD DE,NR_INPUT
 LD C,16
 CALL AC_BDOS
 CP 255
 JR Z,NC_SIZE_BAD
 XOR A
 LD (NR_INOPEN),A
 CALL NW_TARGET_USER
 LD A,(NC_READ_RESULT)
 CP 2
 JP NC,NC_IO_FAILED_RETURN
 OR A
 RET
NC_SIZE_BAD:
 CALL NW_TARGET_USER
NC_IO_FAILED_RETURN:
 LD A,AS_IO
 SCF
 RET
NC_RECOGNIZE:
 XOR A
 LD (NC_MODULE),A
 LD A,(NR_INBUF)
 CP 76H
 JR Z,NC_MAGIC_HEADER
 OR A
 RET
NC_MAGIC_HEADER:
 LD A,(NR_INBUF+1)
 CP 0FFH
 LD A,3
 JR Z,NC_RECOGNIZED
 LD A,(NR_INBUF+1)
 CP 0FEH
 LD A,5
 JR Z,NC_RECOGNIZED
 LD A,(NR_INBUF+1)
 CP 0FDH
 JP Z,NC_UNSUPPORTED
 XOR A
 RET
NC_RECOGNIZED:
 LD (NC_MODULE),A
 OR A
 RET
NC_UNSUPPORTED:
 LD A,AS_UNSUPPORTED
 SCF
 RET
NC_COMPRESSED_NAME:
 LD A,(NC_ARC_PREP)
 OR A
 JR Z,NC_STANDALONE_NAME
 OR A
 RET
NC_STANDALONE_NAME:
 LD HL,NX_FINAL+9
NC_NAME_MARK:
 LD A,(NC_REQUEST)
 LD C,'Q'
 CP 2
 JR Z,NC_EXT_MARK
 LD C,'Z'
NC_EXT_MARK:
 LD A,(HL)
 CP ' '
 JR NZ,NC_EXT_MIDDLE
 LD (HL),C
 INC HL
 INC HL
 LD (HL),C
 DEC HL
 DEC HL
NC_EXT_MIDDLE:
 INC HL
 LD (HL),C
 OR A
 RET
NC_PLAIN_NAME:
 LD HL,NR_NAME
 LD DE,NR_NAME+1
 LD BC,127
 LD (HL),0
 LDIR
 LD HL,NR_SOURCE+1
 LD DE,NR_NAME
 LD B,8
NC_NAME_BASE:
 LD A,(HL)
 CP ' '
 JR Z,NC_NAME_EXT
 LD (DE),A
 INC DE
 INC HL
 DJNZ NC_NAME_BASE
NC_NAME_EXT:
 LD HL,NR_SOURCE+9
 LD A,(HL)
 CP ' '
 RET Z
 LD A,'.'
 LD (DE),A
 INC DE
 LD B,3
NC_NAME_EXT_COPY:
 LD A,(HL)
 CP ' '
 RET Z
 LD (DE),A
 INC DE
 INC HL
 DJNZ NC_NAME_EXT_COPY
 RET
NC_HEADER_NAME:
 LD HL,NR_NAME
 LD B,0
NC_HEADER_LENGTH:
 LD A,(HL)
 OR A
 JR Z,NC_HEADER_BOUNDED
 INC HL
 INC B
 LD A,B
 CP 128
 JP NC,NC_UNSUPPORTED
 JR NC_HEADER_LENGTH
NC_HEADER_BOUNDED:
 LD A,(NC_MODULE)
 CP 5
 JR NZ,NC_PARSE_HEADER
 ; Historical Crunch headers reserve exactly three extension slots.
 LD HL,NR_NAME
 LD C,0
NC_CR_BASE:
 LD A,B
 OR A
 JR Z,NC_CR_READY
 LD A,(HL)
 INC HL
 INC C
 DEC B
 CP '.'
 JR NZ,NC_CR_BASE
 LD D,3
NC_CR_EXT:
 LD A,B
 OR A
 JR Z,NC_CR_TRIM
 INC HL
 INC C
 DEC B
 DEC D
 JR NZ,NC_CR_EXT
NC_CR_TRIM:
 DEC HL
 LD A,(HL)
 CP ' '
 JR NZ,NC_CR_READY
 DEC C
 JR NC_CR_TRIM
NC_CR_READY:
 LD B,C
NC_PARSE_HEADER:
 LD HL,NR_NAME
 PUSH BC
 CALL NS_LEXICAL
 POP BC
 JP C,NC_BAD_NAME
 LD HL,NR_NAME
 PUSH BC
 XOR A
 CALL FP_VALIDATE
 POP BC
 JP C,NC_BAD_NAME
 LD HL,NR_NAME
 LD DE,NX_FINAL
 CALL NH_PARSE_NAME
 RET NC
NC_BAD_NAME:
 LD A,AS_FORMAT
 SCF
 RET
NC_SQ_WORD: DB '/SQ',0
NC_CR_WORD: DB '/CR',0
NC_EX_WORD: DB '/EXPAND',0
NC_DONE_TEXT: DB ' verified codec output published.',13,10,'$'
NC_INPUT_CLOSE_TEXT: DB ' source close uncertain; batch stopped.',13,10,'$'
NC_FAILED_TEXT: DB ' codec operation failed; original retained. Error ','$'
NC_ORDINARY_TEXT: DB 'Not compressed; copying unchanged bytes.',13,10,'$'
NC_UNCHANGED_TEXT: DB 'No output published; unchanged.',13,10,'$'
NC_BATCH_TEXT: DB 'Files (hex): selected ','$'
NOAH_CODEC_DATA MACRO
NC_RETURN_MODE: DB 0
NC_RESULT: DB 0
NC_MEMBER_PENDING: DB 0
NC_SPOOL_LIVE: DB 0
NC_SPOOL: DS 36
NC_REQUEST: DB 0
NC_EXPAND: DB 0
NC_MODULE: DB 0
NC_READ_RESULT: DB 0
NC_ORIGINAL_HASH: DS 4
NC_ORIGINAL_LENGTH: DS 4
NC_ORIGINAL_CRC: DW 0
NC_EXPECT: DS 8
NC_NAME_SAVE: DS 12
 ENDM
; Inspect a selected member without abandoning its iterator or logical bounds.
NC_MEMBER_PROBE:
 XOR A
 LD (NC_MEMBER_PENDING),A
 LD A,(NC_EXPAND)
 OR A
 RET Z
 LD HL,NR_INBUF
 LD (HL),0
 INC HL
 LD (HL),0
 LD BC,2
 LD DE,NR_INBUF
 CALL LBR_READ
 JR NC,NC_MEMBER_RESET
 CP AS_END
 JR Z,NC_MEMBER_RESET
 SCF
 RET
NC_MEMBER_RESET:
 LD HL,NH_CONTEXT+AS_MEMBER+AM_OFFSET
 LD DE,NH_CONTEXT+AS_POSITION
 LD BC,4
 LDIR
 LD HL,NH_CONTEXT+AS_MEMBER+AM_LENGTH
 LD DE,NH_CONTEXT+AS_LEFT
 LD BC,4
 LDIR
 CALL NC_RECOGNIZE
 RET C
 LD A,(NC_MODULE)
 LD (NC_MEMBER_PENDING),A
 OR A
 RET
NC_MEMBER_PROCESS:
 LD A,(NA_REC_FLAGS)
 AND 0FBH
 LD (NA_REC_FLAGS),A
 ; The opaque member TMP has already been compared with the original member.
 LD HL,NX_TEMP
 LD DE,NC_SPOOL
 LD BC,12
 LDIR
 LD A,1
 LD (NC_SPOOL_LIVE),A
 LD (NC_RETURN_MODE),A
 CALL NC_RESET
 LD HL,NC_SPOOL
 LD DE,NR_SOURCE
 LD BC,12
 LDIR
 LD A,(NH_DUSER)
 LD (NR_SOURCE_USER),A
 LD (NR_DESTUSER),A
 LD HL,NH_CONTEXT+AS_MEMBER+AM_LENGTH
 LD DE,NR_LIMIT
 LD BC,4
 LDIR
 LD A,(NH_DEST)
 INC A
 LD (NX_FINAL),A
 CALL NC_PREFLIGHT
 CALL NC_DROP_SPOOL
 XOR A
 LD (NC_RETURN_MODE),A
 LD IX,NH_CONTEXT
 LD A,(NC_RESULT)
 CP 1
 JR Z,NC_MEMBER_DONE
 CP 2
 JR Z,NC_MEMBER_FAILED
 LD HL,NX_SKIPPED
 CALL NX_INC_COUNT
 JP NX_NEXT
NC_MEMBER_DONE:
 LD HL,NX_COMPLETED
 CALL NX_INC_COUNT
 JP NX_STAMP_CHECK
NC_MEMBER_FAILED:
 LD HL,NX_FAILED
 CALL NX_INC_COUNT
 JP NX_SUMMARY
NC_DROP_SPOOL:
 LD A,(NC_SPOOL_LIVE)
 OR A
 RET Z
 CALL NW_TARGET_USER
 LD DE,NC_SPOOL
 LD C,19
 CALL AC_BDOS
 CP 255
 JR Z,NC_SPOOL_RETAINED
 XOR A
 LD (NC_SPOOL_LIVE),A
 RET
NC_SPOOL_RETAINED:
 CALL NA_REC_SPOOL
 LD HL,NC_SPOOL
 CALL NX_PRINT_FCB
 LD DE,NC_RETAIN_TEXT
 CALL NH_PRINT
 LD A,1
 LD (NS_WARNINGS),A
 RET
NC_RETAIN_TEXT: DB ' temporary retained.',13,10,'$'

NC_PRINT_SOURCE:
 LD A,(NR_SOURCE)
 DEC A
 LD D,A
 LD A,(NR_SOURCE_USER)
 LD E,A
 CALL NS_PRINT_DU
 LD HL,NR_SOURCE+1
 LD B,8
 CALL NX_NAME_FIELD
 LD A,(HL)
 CP ' '
 RET Z
 LD E,'.'
 LD C,2
 CALL AC_BDOS
 LD B,3
 JP NX_NAME_FIELD
NC_STORED_TEXT: DB ' -> stored member ','$'
NC_GROW_TEXT: DB ' explicit compression increased the stored size.',13,10,'$'

NC_GROW_NOTE:
 LD A,(NC_REQUEST)
 OR A
 RET Z
 LD HL,NC_EXPECT+3
 LD DE,NR_LIMIT+3
 LD B,4
NC_SIZE_COMPARE:
 LD A,(DE)
 CP (HL)
 JR C,NC_SIZE_INCREASED
 RET NZ
 DEC DE
 DEC HL
 DJNZ NC_SIZE_COMPARE
 RET
NC_SIZE_INCREASED:
 CALL NC_PRINT_SOURCE
 LD DE,NC_GROW_TEXT
 JP NH_PRINT
