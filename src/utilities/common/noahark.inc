; ARK loads at NW_OVERLAY, separate from the reserved NW_ARC_PLANS table.
; It never replaces the running controller, its stack, or the frozen queue.
NH_FORMAT_OPEN:
 XOR A
 LD (NH_ARK),A
 LD (IX+AS_OFFSET),A
 LD (IX+AS_OFFSET+1),A
 LD (IX+AS_OFFSET+2),A
 LD (IX+AS_OFFSET+3),A
 LD HL,NX_BUFFER
 LD (IX+AS_BUFFER),L
 LD (IX+AS_BUFFER+1),H
 LD (IX+AS_COUNT),2
 LD (IX+AS_COUNT+1),A
 CALL AC_READ
 RET C
 LD A,(NX_BUFFER)
 CP 26
 JP NZ,LBR_OPEN
NH_ARK_LOAD:
 LD A,6
 CALL NR_LOAD
 JP C,NR_FATAL
 LD A,(NS_CUR_USER)
 LD E,A
 LD C,32
 CALL AC_BDOS
 LD A,1
 LD (NH_ARK),A
 LD HL,NH_READ_POLL
 LD (IX+AS_READ),L
 LD (IX+AS_READ+1),H
 JP NW_OVERLAY
NH_REOPEN:
 LD A,(NH_ARK)
 OR A
 JP Z,LBR_OPEN
 JP NW_OVERLAY
NH_NEXT:
 LD A,(NH_ARK)
 OR A
 JP Z,LBR_NEXT
 JP NW_OVERLAY+6
NH_READ:
 LD A,(NH_ARK)
 OR A
 JP Z,LBR_READ
 JP NW_OVERLAY+9
NH_MEMBER_PROBE:
 LD A,(NH_ARK)
 OR A
 JP Z,NC_MEMBER_PROBE
 XOR A
 LD (NC_MEMBER_PENDING),A
 JP NW_OVERLAY+12
