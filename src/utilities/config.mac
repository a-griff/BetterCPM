; ********************************************************************************
; *                          BetterCP/M CONFIG Utility                           *
; *                                                                              *
; * Transient disk-configuration utility. MM-style menus edit private working    *
; * records; only validated physical/logical definitions are committed to BIOS.  *
; * Installed defaults may then be written back to the system image.             *
; ********************************************************************************

        INCLUDE layout.inc
        INCLUDE profile.inc
        ASEG
        ORG 0100H
FDBMODE EQU 1
; CONFIG-private scratch A800h-ABFFh is disjoint from catalogue, track stream,
; save/rollback buffers and the 3E00h-3FFFh stack. Every buffer is initialized
; before use. The entry guard requires AC00h below the current BDOS boundary.
        CALL CF_PARSE                  ; valid quoted command text is not options
        JR C,CF_VGATE
        LD A,(CF_MODE)
        CP 2
        JR Z,CF_VDONE
        CP 4
        JR Z,CF_VDONE                  ; quoted format names are data
CF_VGATE:
        CALL UV_CHECK                  ; standalone identity before any disk access
CF_VDONE:
        LD SP,04000H
        IF BP_CHECKED EQ 1
        CALL P12CHECK
        ENDIF
        CALL CF_PARSE
        JP C,CF_USAGE
        LD HL,(6)
        LD DE,0AC00H                  ; private CONFIG scratch ends before AC00h
        OR A
        SBC HL,DE
        JP C,CF_NOMEM
        CALL INIT
        LD A,(CF_MODE)
        CP 8
        JP Z,IO_APPLY
        CP 3
        JP Z,CD_APPLY                  ; physical CLI needs no format catalogue
        CP 6
        JP Z,CE_APPLY
        CP 5
        JP Z,CL_UNBIND
        CP 1
        JP Z,CF_SHOW
        CALL FDBLOAD
        XOR A
        LD (STSTATE),A
        LD (STDIRTY),A
        LD A,(CF_MODE)
        CP 1
        JP Z,CF_SHOW
        CP 2
        JP Z,CF_START
        CP 4
        JP Z,CL_BIND
        CP 7
        JP Z,CF_DEFAULT

; ================================================================================
; =                               CONFIG Main Menu                               =
; =                                                                              =
; = Presents the transient BetterCP/M disk-configuration menu and dispatches physical, =
; = logical, workbench, format, and installed-default operations.                =
; ================================================================================
; -------------------------------------------------------------------------------
; Main Menu Dispatch
; -------------------------------------------------------------------------------

MAIN:   LD HL,TITLE                     ; enter CONFIG utility
        CALL HEADER
        LD HL,MAINMSG
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,DONE
        CP 'S'
        JP Z,SAVEMENU
        CP 'E'
        JP Z,EDITDRIVE
        CP 'A'
        JP Z,STARTMENU
        CP 'B'
        JP Z,IO_MENU
        CP 'C'
        JR Z,PHYSMENU
        CP 'D'
        JP Z,LOGMENU
        JR MAIN                    ; only implemented domains are offered

; ================================================================================
; =                         Physical Drive Configuration                         =
; =                                                                              =
; = Lists and edits authoritative physical-drive geometry, commits validated changes, =
; = and detaches logical bindings no longer supported by the new media limits.   =
; ================================================================================
; -------------------------------------------------------------------------------
; Physical Drive Menu
; -------------------------------------------------------------------------------

PHYSMENU:                               ; open physical-drive menu
        LD HL,PHYHEAD
        CALL HEADER
        XOR A
        LD (PHINDEX),A

; -------------------------------------------------------------------------------
; Physical Drive List
; -------------------------------------------------------------------------------

PHLIST: LD A,(PHINDEX)                  ; list physical-drive profiles
        CALL LABEL
        LD HL,PHLABEL
        CALL PUTS
        LD A,(PHINDEX)
        CALL DECOUT
        CALL CRLF
        LD A,(PHINDEX)
        INC A
        LD (PHINDEX),A
        CP 4
        JR C,PHLIST
        LD HL,PHCOUNT
        CALL PUTS
        CALL CHOICE
        CP 3
        JR Z,MAIN
        SUB 'A'
        CP 4
        JR NC,PHYSMENU
        LD (PHINDEX),A

; -------------------------------------------------------------------------------
; Physical Field Editor
; -------------------------------------------------------------------------------

PHEDIT: LD A,(PHINDEX)                  ; edit selected physical profile
        LD (PHREQ),A
        LD DE,PHREQ
        LD B,1
        CALL API
        JP NZ,PHERROR
        LD HL,PHEDITTL
        CALL HEADER
        LD HL,PHLABEL
        CALL PUTS
        LD A,(PHINDEX)
        CALL DECOUT
        CALL CRLF
        CALL CRLF
        LD A,(PHNOTICE)
        OR A
        JR Z,PHNONOTE
        XOR A
        LD (PHNOTICE),A
        LD HL,PHDETMSG
        CALL PUTS
        CALL CRLF

PHNONOTE:                               ; physical nonote
        XOR A
        LD (FIELD),A

PHFIELDS:
        CALL PHPRINT
        LD A,(FIELD)
        INC A
        LD (FIELD),A
        CP 6
        JR C,PHFIELDS
        LD HL,PHHELP
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,PHYSMENU
        SUB 'A'
        CP 6
        JR NC,PHEDIT
        LD (FIELD),A
        INC A
        LD L,A
        LD H,0
        LD DE,PHREQ
        ADD HL,DE
        LD A,(HL)
        LD (OLDVAL),A
        LD A,(FIELD)
        OR A
        JR Z,INCHES
        CP 1
        JR Z,TRACKS
        CP 2
        JR Z,SIDES
        CP 3
        JR Z,STEPS
        LD HL,NUMMSG
        CALL NUMBER
        JP C,PHEDIT
        JR PHSAVE

INCHES: LD A,(OLDVAL)                   ; inches
        CP 5
        LD A,5
        JR NZ,PHSAVE
        LD A,8
        JR PHSAVE

SIDES:  LD A,(OLDVAL)                   ; sides
        CP 1
        LD A,1
        JR NZ,PHSAVE
        INC A
        JR PHSAVE

TRACKS: LD HL,TRKMSG                    ; tracks
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,PHEDIT
        CP 13
        JP Z,PHEDIT
        SUB 'A'
        CP 4
        JR NC,TRACKS
        LD L,A
        LD H,0
        LD DE,TRKTAB
        ADD HL,DE
        LD A,(HL)
        JR PHSAVE

STEPS:  LD HL,STEPMSG                   ; step-rate s
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,PHEDIT
        CP 13
        JP Z,PHEDIT
        SUB 'A'
        CP 4
        JR NC,STEPS

; -------------------------------------------------------------------------------
; Commit Physical Profile
; -------------------------------------------------------------------------------

PHSAVE: LD B,A                          ; save physical profile
        LD A,(FIELD)
        INC A
        LD L,A
        LD H,0
        LD DE,PHREQ
        ADD HL,DE
        LD (HL),B
        CALL PHSAFE
        JR NZ,PHERROR
        LD DE,PHREQ
        LD B,2
        CALL API
        JR NZ,PHERROR
        CALL PHCLEAN
        LD A,(PHFAIL)
        OR A
        JR Z,PHCOK
        LD HL,CD_PART
        CALL PUTS
        CALL PAUSE
        JP PHEDIT
PHCOK:  LD A,(CHECKPH)
        OR A
        JP Z,PHEDIT
        LD A,1
        LD (PHNOTICE),A
        JP PHEDIT

PHERROR:CALL ERROR                      ; physical error
        JP PHEDIT

  ; Physical configuration is authoritative. After it succeeds, detach every
  ; non-system logical binding that the new track/side limits cannot support.

; -------------------------------------------------------------------------------
; Detach Incompatible Logical Bindings
; -------------------------------------------------------------------------------

; Check proposed limits against A:'s current binding before committing them.
; Read failure is rejection. No active profile or binding has changed yet.
PHSAFE: XOR A
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        RET NZ
        LD A,(PHINDEX)
        LD HL,REQ+1
        CP (HL)
        JR NZ,PHGOOD
        LD A,(PHREQ+2)
        LD HL,REQ+17
        CP (HL)
        JR C,PHBAD
        LD A,(REQ+20)
        AND 060H
        JR Z,PHGOOD
        LD A,(PHREQ+3)
        CP 2
        JR NZ,PHBAD
PHGOOD: XOR A
        RET
PHBAD:  LD A,1
        OR A
        RET

PHCLEAN:XOR A                           ; detach incompatible logical bindings
        LD (CHECKPH),A
        LD (PHFAIL),A
        INC A
        LD (LOGIDX),A

PHCLP: LD A,(LOGIDX)                    ; physical clp
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JR NZ,PHCFAIL
        LD A,(REQ+1)
        CP 0FFH
        JR Z,PHCNEXT
        LD B,A
        LD A,(PHINDEX)
        CP B
        JR NZ,PHCNEXT
        LD A,(PHREQ+2)
        LD HL,REQ+17
        CP (HL)
        JR C,PHCDET
        LD A,(REQ+20)
        AND 060H
        JR Z,PHCNEXT
        LD A,(PHREQ+3)
        CP 2
        JR Z,PHCNEXT

PHCDET:LD A,(LOGIDX)                    ; physical cdet
        LD (REQ),A
        LD A,0FFH
        LD (REQ+1),A
        LD DE,REQ
        LD B,4
        CALL API
        JR NZ,PHCFAIL
        LD A,(LOGIDX)
        CALL RESETLOG
        LD A,1
        LD (CHECKPH),A

        JR PHCNEXT
PHCFAIL:LD A,1
        LD (PHFAIL),A

PHCNEXT:                                ; physical cnext
        LD A,(LOGIDX)
        INC A
        LD (LOGIDX),A
        CP 4
        JR C,PHCLP
        RET

; ================================================================================
; =                         Logical Drive Configuration                          =
; =                                                                              =
; = Lists logical bindings, pages through available format definitions, checks physical =
; = compatibility, and attaches a selected format to a logical drive.            =
; ================================================================================
; -------------------------------------------------------------------------------
; Logical Drive Menu
; -------------------------------------------------------------------------------

LOGMENU:LD HL,LOGHEAD                   ; open logical-drive menu
        CALL HEADER
        LD HL,LOGHELP
        CALL PUTS
        XOR A
        LD (LOGIDX),A

; -------------------------------------------------------------------------------
; Logical Drive List
; -------------------------------------------------------------------------------

LOGLIST:LD A,(LOGIDX)                   ; list logical-drive bindings
        CALL LABEL
        LD A,(LOGIDX)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,LOGERROR
        LD A,(REQ+1)
        CP 0FFH
        JR Z,LOGUNDEF
        CALL DECOUT
        LD HL,COLON
        CALL PUTS
        LD HL,REQ+1
        LD DE,CURB
        LD BC,64
        LDIR
        CALL FDBCURNAME
        JR LOGNEXT

LOGUNDEF:LD HL,UNDEF                    ; logical undef
        CALL PUTS

LOGNEXT:CALL CRLF                       ; logical next
        LD A,(LOGIDX)
        INC A
        LD (LOGIDX),A
        CP 4
        JR C,LOGLIST
        LD HL,LOGFOOT
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,MAIN
        SUB 'A'
        CP 4
        JR NC,LOGMENU
        LD (LOGIDX),A
        OR A
        JR NZ,LOGSTART
        LD HL,BOOTMSG
        CALL PUTS
        CALL PAUSE
        JP LOGMENU

LOGSTART:XOR A                          ; logical start
        LD (PAGE),A

; -------------------------------------------------------------------------------
; Format Selection Pages
; -------------------------------------------------------------------------------

PAGEVIEW:LD HL,LOGHEAD                  ; display format-selection page
        CALL HEADER
        LD HL,SELECTMSG
        CALL PUTS
        LD A,(LOGIDX)
        ADD A,'A'
        CALL PUTC
        CALL CRLF
        XOR A
        LD (ROW),A

PAGEROW:LD A,(ROW)                      ; format page row
        OR A
        JR NZ,PAGELAB
        LD HL,LBRACK
        CALL PUTS
        LD A,'A'
        CALL INVERSE
        LD HL,RBRACK
        CALL PUTS
        XOR A
        JR PAGENAME

PAGELAB:CALL LABEL                      ; format page lab

PAGENAME:                               ; format page name
        LD B,A
        LD A,(PAGE)
        ADD A,B
        CALL FDBPNAME
        CALL CRLF
        LD A,(ROW)
        INC A
        LD (ROW),A
        CP 16
        JR Z,PAGEEND
        LD B,A
        LD A,(PAGE)
        ADD A,B
        LD B,A
        LD A,(FCOUNT)
        CP B
        JR NZ,PAGEROW

PAGEEND:LD HL,PAGEHELP                  ; format page end
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,LOGMENU
        CP 13
        JR Z,PAGEDEF
        CP ','
        JR Z,PREVPG
        CP '<'
        JR Z,PREVPG
        CP '.'
        JR Z,NEXTPG
        CP '>'
        JR Z,NEXTPG
        SUB 'A'
        JR PAGEPICK

PAGEDEF:XOR A                           ; format page def

PAGEPICK:CP 16                          ; format page pick
        JP NC,PAGEVIEW
        LD B,A
        LD A,(ROW)
        CP B
        JP Z,PAGEVIEW
        JP C,PAGEVIEW
        LD A,(PAGE)
        ADD A,B
        LD (CHOSEN),A
        CALL FDBBIND
        JR C,FORMATBAD
  ; Check whether any configured drive can accommodate the geometry.
        XOR A
        LD (CHECKPH),A

; -------------------------------------------------------------------------------
; Physical Compatibility Check
; -------------------------------------------------------------------------------

HWCHECK:LD A,(CHECKPH)                  ; hwcheck
        CALL COMPAT
        JR Z,ATTACH
        LD A,(CHECKPH)
        INC A
        LD (CHECKPH),A
        CP 4
        JR C,HWCHECK
        LD HL,HWMSG
        JR PICKERR

PREVPG: LD A,(PAGE)                     ; prevpg
        OR A
        JP Z,PAGEVIEW
        SUB 16
        LD (PAGE),A
        JP PAGEVIEW

NEXTPG: LD A,(PAGE)                     ; nextpg
        ADD A,16
        LD B,A
        LD A,(FCOUNT)
        CP B
        JP C,PAGEVIEW
        JP Z,PAGEVIEW
        LD A,B
        LD (PAGE),A
        JP PAGEVIEW

FORMATBAD:LD HL,FMTBAD                  ; formatbad

PICKERR:CALL PUTS                       ; pickerr
        CALL PAUSE
        JP PAGEVIEW

; -------------------------------------------------------------------------------
; Attach Selected Format
; -------------------------------------------------------------------------------

ATTACH: LD HL,LOGHEAD                   ; attach selected logical format
        CALL HEADER
        LD HL,CHOSENMSG
        CALL PUTS
        LD A,(CHOSEN)
        CALL FDBPNAME
        CALL CRLF
        LD HL,ATTMSG
        CALL PUTS
        CALL CC_PICK
        CP 3
        JP Z,PAGEVIEW
        SUB '0'
        CP 4
        JR NC,ATTACH
        LD (PHINDEX),A
        CALL COMPAT
        JR Z,BINDIT
        LD HL,HWMSG
        CALL PUTS
        CALL PAUSE
        JR ATTACH

BINDIT: LD HL,BIND                      ; bindit
        LD DE,REQ+1
        LD BC,64
        LDIR
        LD A,(PHINDEX)
        LD (REQ+1),A
        LD A,(LOGIDX)
        LD (REQ),A
        LD DE,REQ
        LD B,4
        CALL API
        JR NZ,LOGERROR
        LD A,(LOGIDX)
        CALL RESETLOG
        LD HL,SAVED
        CALL PUTS
        CALL PAUSE
        JP LOGMENU

LOGERROR:CALL ERROR                     ; logical error
        JP LOGMENU
  ; A=physical index. Z means format geometry fits the configured drive.

; -------------------------------------------------------------------------------
; Geometry Compatibility
; -------------------------------------------------------------------------------

COMPAT: LD (PHREQ),A                    ; compatibility pat
        LD DE,PHREQ
        LD B,1
        CALL API
        RET NZ
        LD A,(PHREQ+2)
        LD B,A
        LD A,(BIND+16)
        CP B
        JR Z,COMSIDE
        JR C,COMSIDE
        JR COMBAD

COMSIDE:LD A,(BIND+19)                  ; compatibility side
        AND 040H
        LD B,1
        JR Z,COMSS
        INC B

COMSS:  LD A,(PHREQ+3)                  ; compatibility ss
        CP B
        JR C,COMBAD
        XOR A
        RET

COMBAD: LD A,1                          ; compatibility bad
        OR A
        RET

  ; WORKBENCH -- keep the pencil marks here, not in the live BIOS table.
  ; Start from a drive set up by G. Q submits the whole record at once;
  ; BREAK throws away the working copy. The BIOS remains the final judge.

; ================================================================================
; =                           Logical Format Workbench                           =
; =                                                                              =
; = Edits a private working copy of a logical DPH/binding record and submits the whole =
; = record only when the user chooses to apply it.                               =
; ================================================================================
; -------------------------------------------------------------------------------
; Workbench Entry
; -------------------------------------------------------------------------------

EDITDRIVE:LD HL,EDTITLE                 ; open logical-format workbench
        CALL HEADER
        LD HL,EDASK
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,MAIN
        SUB 'A'
        CP 1
        JR C,EDITDRIVE
        CP 4
        JR NC,EDITDRIVE
        LD (EDDRIVE),A
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,EDERROR
        LD A,(REQ+1)
        CP 4
        JP NC,EDERROR
        LD HL,REQ+1
        LD DE,EDCOPY
        LD BC,64
        LDIR

; -------------------------------------------------------------------------------
; Workbench Display
; -------------------------------------------------------------------------------

EDSHOW: LD HL,EDTITLE                   ; display workbench fields
        CALL HEADER
        XOR A
        LD (EDFIELD),A

EDROW:  LD A,(EDFIELD)                  ; workbench row
        CALL LABEL
        LD A,(EDFIELD)
        ADD A,A
        LD E,A
        LD D,0
        LD HL,EDNAMES
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL PUTS
        CALL EDADDR
        LD E,(HL)
        LD D,0
        LD A,(EDWIDTH)
        CP 2
        JR NZ,EDPRINT
        INC HL
        LD D,(HL)

EDPRINT:EX DE,HL                        ; workbench print
        CALL EDDEC
        CALL CRLF
        LD A,(EDFIELD)
        INC A
        LD (EDFIELD),A
        CP 16
        JR C,EDROW
        LD HL,EDHELP
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,MAIN
        CP 'Q'
        JR Z,EDAPPLY
        CP 'S'
        JP Z,EDSIZE
        CP 'R'
        JP Z,EDSECTOR
        SUB 'A'
        CP 16
        JR NC,EDSHOW
        LD (EDFIELD),A
        LD HL,EDVALUE
        CALL EDNUMBER
        JR C,EDSHOW
        PUSH DE
        CALL EDADDR
        POP DE
        LD A,(EDWIDTH)
        CP 2
        JR Z,EDWORD
        LD A,D
        OR A
        JR NZ,EDINVALID
        LD (HL),E
        JP EDSHOW

EDWORD: LD (HL),E                       ; workbench word
        INC HL
        LD (HL),D
        JP EDSHOW

EDADDR: LD A,(EDFIELD)                  ; workbench addr
        ADD A,A
        LD E,A
        LD D,0
        LD HL,EDOFFS
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD A,(HL)
        LD (EDWIDTH),A
        LD D,0
        LD HL,EDCOPY
        ADD HL,DE
        RET

; -------------------------------------------------------------------------------
; Apply Edited Binding
; -------------------------------------------------------------------------------

EDAPPLY:LD HL,EDCOPY                    ; apply edited logical binding
        LD DE,REQ+1
        LD BC,64
        LDIR
        LD A,(EDDRIVE)
        LD (REQ),A
        CALL EDCHECK
        JR NZ,EDINVALID
        LD DE,REQ
        LD B,4
        CALL API
        JR NZ,EDINVALID
        LD A,(EDDRIVE)
        CALL RESETLOG
        LD HL,SAVED
        CALL PUTS
        CALL PAUSE
        JP MAIN

EDERROR:CALL ERROR                      ; workbench error
        JP MAIN

EDINVALID:CALL ERROR                    ; workbench invalid
        JP EDSHOW

  ; A changed DPH cannot retain BDOS's login, allocation, checksum, or
  ; read-only state from its former format. Function 37 invalidates exactly
  ; the logical drive whose binding CONFIG just replaced.

; -------------------------------------------------------------------------------
; Invalidate Replaced Binding
; -------------------------------------------------------------------------------

RESETLOG:                               ; invalidate replaced logical drive
        CP 4
        RET NC
        LD B,A
        LD DE,1
        OR A
        JR Z,RESETGO

RESETSHIFT:                             ; reset shift
        SLA E
        RL D
        DJNZ RESETSHIFT

RESETGO:                                ; reset go
        LD C,37
        CALL BDOS
        RET

; ================================================================================
; =                         Saved Configuration Scope                            =
; =                                                                              =
; = Makes the pending-only and all-current meanings explicit. The first scope    =
; = writes only cold-boot state; it cannot capture temporary active disk state.  =
; ================================================================================

SAVEMENU:                              ; choose saved-default scope
        LD HL,SAVETITLE
        CALL HEADER
        LD HL,SAVEHELP
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,MAIN
        CP 'A'
        JR Z,STSAVE
        CP 'B'
        JR NZ,SAVEMENU
        JP SYSGEN

STSAVE:LD A,(STSTATE)                  ; save pending cold changes only
        OR A
        CALL Z,STFETCH
        LD A,(STSTATE)
        CP 2
        JP Z,STSAVEINVALID
        LD A,(STDIRTY)
        OR A
        JP Z,STSAVENONE
        LD HL,STSAVEASK
        CALL PUTS
        CALL CC_ASK
        CP 'Y'
        JP NZ,CF_CANCEL
        CALL STLOAD                    ; preserve installed BCST for rollback
        JP NZ,STSAVEIO
        LD HL,TRACKBF
        LD DE,SGOLD
        LD BC,256
        LDIR
        LD HL,STPEND                   ; validate complete proposed record
        LD DE,TRACKBF
        LD BC,256
        LDIR
        CALL STVALID
        JR NZ,STSAVEINVALID
        XOR A
        LD (SGFAILED),A
        LD A,1
        LD (SGINDEX),A
        LD HL,STPEND
        LD (SGIOBUF),HL
        CALL STSAVEONE
        JR NZ,SVROLL1
        LD A,2
        LD (SGINDEX),A
        LD HL,STPEND+128
        LD (SGIOBUF),HL
        CALL STSAVEONE
        JR NZ,SVROLL2
        XOR A
        LD (STDIRTY),A
        LD HL,STSAVED
        JR STSAVEREPORT

STSAVEONE:                             ; write and verify selected BCST record
        LD A,1
        CALL SGIO
        RET NZ
        JP SGVERIFY

SVROLL2:                               ; restore both possibly changed records
        LD A,2
        LD (SGINDEX),A
        LD HL,SGOLD+128
        LD (SGIOBUF),HL
        CALL STRESTORE
        LD (SGFAILED),A
SVROLL1:
        LD A,1
        LD (SGINDEX),A
        LD HL,SGOLD
        LD (SGIOBUF),HL
        CALL STRESTORE
        LD B,A
        LD A,(SGFAILED)
        OR B
        LD HL,SVRESTOK
        JR Z,STSAVEREPORT
        LD HL,STDAMAGED
        JR STSAVEREPORT

STRESTORE:                             ; restore and verify one original record
        LD A,1
        CALL SGIO
        RET NZ
        JP SGVERIFY

STSAVEINVALID:
        LD HL,STSAVEBAD
        JR STSAVEREPORT
STSAVENONE:
        LD HL,SVMNONE
        JR STSAVEREPORT
STSAVEIO:
        LD HL,SVMIOERR
STSAVEREPORT:
        CALL CRLF
        CALL PUTS
        LD A,(CF_MODE)
        CP 2
        JP Z,DONE
        CALL PAUSE
        CALL FDBLOAD                   ; save workspace overlays the catalogue
        JP SAVEMENU

PHPRINT:                               ; physical fields
        LD A,(FIELD)
        CALL LABEL
        LD A,(FIELD)
        ADD A,A
        LD L,A
        LD H,0
        LD DE,FLDNAMES
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL PUTS
        LD A,(FIELD)
        INC A
        LD L,A
        LD H,0
        LD DE,PHREQ
        ADD HL,DE
        LD A,(HL)
        LD (OLDVAL),A
        LD A,(FIELD)
        CP 3
        LD A,(OLDVAL)
        JR NZ,PHDEC
        LD L,A
        LD H,0
        LD DE,STEPTAB
        ADD HL,DE
        LD A,(HL)

PHDEC:  CALL DECOUT                     ; physical dec
        CALL CRLF
        RET

; ================================================================================
; =                         Saved Startup Command                                =
; =                                                                              =
; = Reads and validates the versioned command-environment startup record from    =
; = protected system records 1 and 2. A private pending copy supports editing    =
; = and clearing without changing the installed system.                          =
; ================================================================================

STARTMENU:                              ; display pending startup command
        LD HL,STTITLE
        CALL HEADER
        LD A,(STSTATE)
        OR A
        CALL Z,STFETCH
        LD A,(STSTATE)
        CP 2
        JR Z,STINVALID
STSHOW: LD A,(STDIRTY)
        OR A
        JR Z,STCLEAN
        LD HL,STPENDING
        CALL PUTS
STCLEAN:LD A,(STPEND+7)
        OR A
        JR Z,STDISABLED
        LD HL,STPREFIX
        CALL PUTS
        LD A,(STPEND+8)
        LD B,A
        LD HL,STPEND+16
STPRINT:LD A,(HL)
        CALL PUTC
        INC HL
        DJNZ STPRINT
        CALL CRLF
        JR STMENUS
STDISABLED:
        LD HL,STOFF
        CALL PUTS
        JR STMENUS
STINVALID:
        LD HL,STBAD
        CALL PUTS
STMENUS:LD HL,STHELP
        CALL PUTS
        CALL CHOICE
        CP 3
        JP Z,MAIN
        CP 'E'
        JR Z,STEDIT
        CP 'C'
        JR Z,STCLEAR
        CP 'T'
        JR Z,STTEST
        JR STARTMENU

STFETCH:CALL STLOAD                    ; establish private pending copy
        JR NZ,STFETCHBAD
        LD HL,TRACKBF
        LD DE,STPEND
        LD BC,256
        LDIR
        LD A,1
        LD (STSTATE),A
        RET
STFETCHBAD:
        CALL STDEFAULT
        LD A,2
        LD (STSTATE),A
        RET

; Shared editor admits printable ASCII only; pending state commits on Enter.
STEDIT:LD A,126
        LD HL,STEDITMSG
        CALL EDITNEW
        JP C,STARTMENU
        CALL STDEFAULT
        LD A,1
        LD (STPEND+7),A
        LD A,(STLINE+1)
        LD (STPEND+8),A
        LD C,A
        LD B,0
        LD HL,STLINE+2
        LD DE,STPEND+16
        LDIR
        CALL STCHECKSUM
        LD A,1
        LD (STSTATE),A
        LD (STDIRTY),A
        JP STARTMENU
STCLEAR:CALL STDEFAULT                 ; disable pending command
        LD A,1
        LD (STSTATE),A
        LD (STDIRTY),A
        JP STARTMENU

STTEST:LD A,(STPEND+8)                 ; submit pending command once
        OR A
        JP Z,STTESTOFF
        CP 126
        JP NC,STTESTLONG
        CALL STFCBRESET
        LD DE,STSUBFCB
        LD C,15
        CALL STA0CALL
        INC A
        JR NZ,STTESTBUSY
        CALL STFCBRESET
        LD DE,STSUBFCB
        LD C,22
        CALL STA0CALL
        INC A
        JR Z,STTESTERR
        LD HL,STSUBBUF
        LD DE,STSUBBUF+1
        LD BC,127
        LD (HL),0
        LDIR
        LD A,(STPEND+8)
        LD (STSUBBUF),A
        LD C,A
        LD B,0
        LD HL,STPEND+16
        LD DE,STSUBBUF+1
        LDIR
        LD DE,STSUBBUF
        LD C,26
        CALL BDOS
        LD DE,STSUBFCB
        LD C,21
        CALL STA0CALL
        OR A
        JR NZ,STTESTCLEAN
        LD DE,STSUBFCB
        LD C,16
        CALL STA0CALL
        INC A
        JR Z,STTESTCLEAN
        LD HL,STTESTING
        CALL PUTS
        LD DE,1                         ; relog A: before CCP reads new stream
        LD C,37
        CALL BDOS
        LD C,0
        JP BDOS
STTESTCLEAN:
        LD DE,STSUBFCB
        LD C,19
        CALL STA0CALL
STTESTERR:
        LD DE,0080H
        LD C,26
        CALL BDOS
        LD HL,STTESTBAD
        JR STTESTPAUSE
STTESTOFF:
        LD HL,STTESTNONE
        JR STTESTPAUSE
STTESTLONG:
        LD HL,STTEST126
        JR STTESTPAUSE
STTESTBUSY:
        LD DE,STSUBFCB
        LD C,16
        CALL STA0CALL
        LD HL,STTESTSUB
STTESTPAUSE:
        CALL PUTS
        CALL PAUSE
        JP STARTMENU

  ; Only the queue uses user zero. Restore context and BDOS results on every
  ; success/failure path; source lookup and submitted commands keep their user.
STA0CALL:                              ; call BDOS on the A0 command stream
        PUSH    BC
        PUSH    DE
        LD      E,0FFH
        LD      C,32
        CALL    BDOS
        LD      (STUSER),A
        LD      E,0
        LD      C,32
        CALL    BDOS
        POP     DE
        POP     BC
        CALL    BDOS
        PUSH    AF
        PUSH    BC
        PUSH    DE
        PUSH    HL
        LD      A,(STUSER)
        LD      E,A
        LD      C,32
        CALL    BDOS
        POP     HL
        POP     DE
        POP     BC
        POP     AF
        RET
STUSER:        DB      0               ; user saved for one output file call

STFCBRESET:                            ; restore reusable A0:$$$.SUB FCB
        LD HL,STSUBFCB+12
        LD DE,STSUBFCB+13
        LD BC,23
        LD (HL),0
        LDIR
        RET

STDEFAULT:                             ; construct canonical disabled record
        LD HL,STPEND
        LD DE,STPEND+1
        LD BC,255
        LD (HL),0
        LDIR
        LD HL,STHEADER
        LD DE,STPEND
        LD BC,16
        LDIR
STCHECKSUM:
        LD HL,0                        ; set negative 16-bit word sum
        LD (STPEND+12),HL
        LD IX,STPEND
        LD B,128
STCKLOOP:LD E,(IX+0)
        LD D,(IX+1)
        ADD HL,DE
        INC IX
        INC IX
        DJNZ STCKLOOP
        EX DE,HL
        LD HL,0
        OR A
        SBC HL,DE
        LD (STPEND+12),HL
        RET

STLOAD: CALL SGDISKSET                  ; load protected records 1 and 2
        RET NZ
        XOR A
        LD (SGHEAD+7),A
        INC A
        LD (SGINDEX),A
        LD HL,TRACKBF
        LD (SGIOBUF),HL
        XOR A
        CALL SGIO
        RET NZ
        LD A,2
        LD (SGINDEX),A
        LD HL,TRACKBF+128
        LD (SGIOBUF),HL
        XOR A
        CALL SGIO
        RET NZ

STVALID:                               ; validate complete BCST v1 record
        LD HL,TRACKBF
        LD DE,STMAGIC
        LD BC,7
        CALL SGCMP
        RET NZ
        LD A,(TRACKBF+7)
        CP 2
        RET NC
        LD A,(TRACKBF+8)
        CP 127
        RET NC
        LD B,A
        LD A,(TRACKBF+9)
        CP 126
        RET NZ
        LD HL,(TRACKBF+10)
        LD DE,256
        OR A
        SBC HL,DE
        RET NZ
        LD HL,(TRACKBF+14)
        LD DE,LY_SYS
        OR A
        SBC HL,DE
        RET NZ
        LD A,B
        OR A
        JR Z,STSTATE0
        LD A,(TRACKBF+7)
        CP 1
        RET NZ
        JR STSUM
STSTATE0:LD A,(TRACKBF+7)
        OR A
        RET NZ
STSUM:  LD IX,TRACKBF                  ; 16-bit little-endian word sum is zero
        LD HL,0
        LD B,128
STSUMLP:LD E,(IX+0)
        LD D,(IX+1)
        ADD HL,DE
        INC IX
        INC IX
        DJNZ STSUMLP
        LD A,H
        OR L
        RET NZ
        LD IX,TRACKBF+16
        LD A,(TRACKBF+8)
        OR A
        JR Z,STRESERVE
        LD B,A
STCHAR: LD A,(IX+0)
        CP 32
        JR C,STFAIL
        CP 127
        JR NC,STFAIL
        INC IX
        DJNZ STCHAR
STRESERVE:
        LD A,240
        LD B,A
        LD A,(TRACKBF+8)
        LD C,A
        LD A,B
        SUB C
        LD B,A
STRESLP:LD A,(IX+0)
        OR A
        JR NZ,STFAIL
        INC IX
        DJNZ STRESLP
        XOR A
        RET
STFAIL: LD A,1
        OR A
        RET
  ; The sector table is in physical order. Changing IDs changes interleave.
  ; N selects the uniform size, or maximum size for a mixed track.
  ; S records each individual length in the same physical order as the IDs.

; -------------------------------------------------------------------------------
; Sector-ID Editing
; -------------------------------------------------------------------------------

EDSECTOR:XOR A                          ; workbench sector
        LD (EDMODE),A
        JR EDSLOTIN

; -------------------------------------------------------------------------------
; Sector-Size Editing
; -------------------------------------------------------------------------------

EDSIZE: LD A,1                          ; workbench size
        LD (EDMODE),A

EDSLOTIN:LD HL,EDSLOT                   ; workbench slotin
        CALL EDNUMBER
        JP C,EDSHOW
        LD A,D
        OR A
        JP NZ,EDINVALID
        LD A,E
        OR A
        JP Z,EDINVALID
        CP 33
        JP NC,EDINVALID
        DEC A
        LD (EDSAVE),A
        LD A,(EDMODE)
        OR A
        JR NZ,EDSIZEIN
        LD HL,EDID
        CALL EDNUMBER
        JP C,EDSHOW
        LD A,D
        OR A
        JP NZ,EDINVALID
        LD B,E
        LD A,(EDSAVE)
        LD E,A
        LD D,0
        LD HL,EDCOPY+20
        ADD HL,DE
        LD (HL),B
        JP EDSHOW

EDSIZEIN:LD HL,EDSIZEQ                  ; workbench sizein
        CALL EDNUMBER
        JP C,EDSHOW
        LD A,D
        OR A
        JP NZ,EDINVALID
        LD A,E
        CP 4
        JP NC,EDINVALID
        LD (EDNEW),A
        CALL EDSIZESET
        JP EDSHOW
EDSIZESET:
  ; On the first mixed edit seed every slot from the old uniform length.
        LD A,(EDCOPY+52)
        OR A
        JR NZ,EDPACK
        LD A,(EDCOPY+18)
        AND 3
        LD B,A
        RLCA
        RLCA
        OR B
        LD B,A
        RLCA
        RLCA
        RLCA
        RLCA
        OR B
        LD HL,EDCOPY+53
        LD B,8

EDFILL: LD (HL),A                       ; workbench fill
        INC HL
        DJNZ EDFILL
        LD A,1
        LD (EDCOPY+52),A

EDPACK: LD A,(EDSAVE)                   ; workbench pack
        SRL A
        SRL A
        LD E,A
        LD D,0
        LD HL,EDCOPY+53
        ADD HL,DE
        LD A,(EDSAVE)
        AND 3
        ADD A,A
        LD B,A
        LD E,3
        LD A,(EDNEW)
        LD D,A
        LD A,B
        OR A
        JR Z,EDMERGE

EDSHIFT:SLA E                           ; workbench shift
        SLA D
        DJNZ EDSHIFT

EDMERGE:LD A,E                          ; workbench merge
        CPL
        AND (HL)
        OR D
        LD (HL),A
        RET
  ; Read a decimal word using our own console input, so BREAK is local.
  ; Re-use the FDF scanner's overflow check. ENTER alone leaves it alone.

; -------------------------------------------------------------------------------
; Numeric Field Input
; -------------------------------------------------------------------------------

NUMBER: LD A,1
        LD (CI_BYTE),A
        CALL CI_NUM
        RET NC
        LD A,(CI_LAST)
        CP 13
        SCF
        RET NZ
        LD A,(OLDVAL)
        OR A
        RET
EDNUMBER:XOR A
        LD (CI_BYTE),A
CI_NUM: LD A,5
        CALL EDITNEW
        RET C
EDVALID:LD A,(EDITLEN)
        LD B,A
        LD HL,EDITBUF
EDVDIG: LD A,(HL)
        CP '0'
        JR C,EDVBAD
        CP '9'+1
        JR NC,EDVBAD
        INC HL
        DJNZ EDVDIG
        LD (HL),','
        LD HL,EDITBUF
        LD (PARPTR),HL
        CALL PNUM
        JR C,EDVBAD
        LD A,(CI_BYTE)
        OR A
        JR Z,EDVWORD
        LD A,D
        OR A
        JR NZ,EDVBAD
EDVWORD:CALL CI_CRLF
        LD A,E
        OR A
        RET
EDVBAD: LD HL,EDNUMBAD
        CALL UIMESSAGE
        CALL WAITEDIT
        RET C
        JR EDVALID
EDNUMBAD:DB 'Invalid decimal value.',0
  ; Print HL unsigned, including directory counts beyond the old 255 limit.

EDDEC:  LD DE,10000                     ; workbench dec
        CALL EDPLACE
        LD DE,1000
        CALL EDPLACE
        LD DE,100
        CALL EDPLACE
        LD DE,10
        CALL EDPLACE
        LD A,L
        ADD A,'0'
        JP PUTC

EDPLACE:LD A,'0'-1                      ; workbench place

EDSUB:  INC A                           ; workbench sub
        OR A
        SBC HL,DE
        JR NC,EDSUB
        ADD HL,DE
        JP PUTC

; ================================================================================
; =                       Workbench Data and Field Tables                        =
; =                                                                              =
; = Defines workbench prompts, field metadata, format-name tables, and editing state. =
; ================================================================================
; -------------------------------------------------------------------------------
; Workbench Strings and Tables
; -------------------------------------------------------------------------------

EDTITLE:DB 'Disk format workbench',0    ; workbench title

EDASK:  DB 'Copy current format from logical drive [B-D] (^C returns):',13,10,0 ; workbench ask
EDHELP: DB 'A-P Edit  Q Apply to drive  R IDs  S Sizes  ^C Discard',13,10,0 ; workbench help

EDVALUE:DB 'Decimal value: ',0 ; workbench value

EDSLOT: DB 'Sector slot (1..32): ',0 ; workbench slot

EDSIZEQ:DB 'Size code (0..3): ',0 ; workbench sizeq

EDMODE: DB 0                            ; workbench mode
EDNEW:  DB 0                            ; workbench new
EDID:   DB 'Sector ID (0..255): ',0      ; workbench id
EDOFFS: DB 0,1,1,2,3,1,4,1,5,1,6,2,8,2,10,1 ; workbench offs
        DB 11,1,12,2,14,2,16,1,17,1,18,1,19,1,52,1

EDNAMES:DW ED0,ED1,ED2,ED3,ED4,ED5,ED6,ED7 ; workbench names
        DW ED8,ED9,ED10,ED11,ED12,ED13,ED14,ED15

ED0:    DB 'Physical drive: ',0         ; workbench 0
ED1:    DB '128-byte records/track (SPT): ',0 ; workbench 1
ED2:    DB 'Block shift (BSH): ',0      ; workbench 2
ED3:    DB 'Block mask (BLM): ',0       ; workbench 3
ED4:    DB 'Extent mask (EXM): ',0      ; workbench 4
ED5:    DB 'Last allocation block (DSM): ',0 ; workbench 5
ED6:    DB 'Last directory entry (DRM): ',0 ; workbench 6
ED7:    DB 'Directory allocation high (AL0): ',0 ; workbench 7
ED8:    DB 'Directory allocation low (AL1): ',0 ; workbench 8
ED9:    DB 'Directory check size (CKS): ',0 ; workbench 9
ED10:   DB 'Reserved tracks (OFF): ',0  ; workbench 10
ED11:   DB 'Cylinders: ',0              ; workbench 11
ED12:   DB 'Physical sectors/track: ',0 ; workbench 12
ED13:   DB 'Maximum size code (0=128 .. 3=1024): ',0 ; workbench 13
ED14:   DB 'Format flags (decimal): ',0 ; workbench 14
ED15:   DB 'Explicit size map (0=uniform, 1=mixed): ',0 ; workbench 15

EDDRIVE:DB 0                            ; workbench drive

EDFIELD:DB 0                            ; workbench field

EDWIDTH:DB 0                            ; workbench width

EDSAVE: DB 0                            ; workbench save
EDCOPY EQU 0AAA0H                           ; workbench copy

; ================================================================================
; =                          CONFIG Messages and State                           =
; =                                                                              =
; = Defines main-menu text, physical/logical prompts, lookup tables, and transient utility =
; = state used by CONFIG.                                                        =
; ================================================================================
; -------------------------------------------------------------------------------
; Main and Physical Menu Text
; -------------------------------------------------------------------------------

; Complete command-tail validation precedes INIT, FDB I/O or settings changes.
CF_PARSE:
        XOR A
        LD (CF_MODE),A
        LD A,(80H)
        CP 128
        JP NC,CF_BAD
        LD C,A
        LD HL,81H
        CALL CF_SKIP
        RET Z
        LD (CF_PTR),HL
        LD A,C
        LD (CF_LEFT),A
        LD DE,CF_SHOPT
        CALL CF_MATCH
        JR C,CF_TRYDEF
        CALL CF_SKIP
        JP NZ,CF_BAD
        LD A,1
        LD (CF_MODE),A
        OR A
        RET
CF_TRYDEF:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,CF_DEFOPT
        CALL CF_MATCH
        JR C,IO_PARSE
        CALL CF_SKIP
        JP NZ,CF_BAD
        LD A,7
        LD (CF_MODE),A
        OR A
        RET
; Saved IOBYTE patches one verified build-owned operand, never the live byte.
IO_PARSE:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,IO_KEY
        CALL CF_MATCH
        JP C,CF_TRYST
        CALL CD_NUM
        RET C
        LD (IO_NEW),A
        AND 3
        CP 1                           ; preserve a usable CRT console at boot
        JP NZ,CF_BAD
        CALL CF_SKIP
        JP NZ,CF_BAD
        LD A,8
        LD (CF_MODE),A
        OR A
        RET
IO_PICK:
        LD HL,IO_VALID
IO_PICKLOOP:
        LD E,(HL)
        INC HL
        LD D,(HL)
        INC HL
        LD A,D
        OR E
        JR Z,IO_NOFIELD
        PUSH HL
        LD HL,(SGSPT)
        OR A
        SBC HL,DE
        POP HL
        JR Z,IO_PICKED
        LD DE,8
        ADD HL,DE
        JR IO_PICKLOOP
IO_PICKED:
        DEC HL
        DEC HL
        LD DE,IO_DESC
        LD BC,10
        LDIR
        XOR A
        RET
IO_NOFIELD:
        LD A,1
        OR A
        RET
IO_MASK:
        CALL IO_PICK
        RET NZ
        LD HL,(IO_DESC+4)
        LD A,H
        AND L
        CP 255
        RET Z                          ; Model 4 operand is outside resident carrier
        LD DE,SGNEW
        ADD HL,DE
        LD A,(HL)
        AND 3
        CP 1
        RET NZ
        LD (HL),095H                   ; restore compiled value for fingerprint only
        XOR A
        RET
IO_READ:
        CALL SGDISKSET
        RET NZ
        CALL IO_PICK
        RET NZ
        XOR A
        LD (SGHEAD+7),A
        LD A,(IO_DESC+2)
        LD (SGINDEX),A
        LD HL,SGOLD
        LD (SGIOBUF),HL
        XOR A
        CALL SGIO
        RET NZ
        LD HL,SGOLD
        LD DE,SGNEW
        LD BC,128
        LDIR
        LD A,(IO_DESC+3)
        LD E,A
        LD D,0
        LD HL,SGNEW
        ADD HL,DE
        LD (IO_PTR),HL
        LD A,(HL)
        LD (IO_OLD),A
        AND 3
        CP 1
        RET NZ
        LD (HL),095H
        LD HL,SGNEW
        LD BC,128
        CALL SGCRC32
        LD HL,SGCRC
        LD DE,IO_DESC+6
        LD BC,4
        CALL SGCMP
        RET NZ
        RET
IO_APPLY:
        CALL IO_READ
        JP NZ,IO_BAD
        LD A,(IO_NEW)
        CP 095H
        JR Z,IO_CAPDONE                ; explicit return to compiled factory routes
        LD A,63
        CALL SGBIOS                    ; real platform capability bitmap
        LD A,(IO_OLD)
        LD D,A
        LD A,(IO_NEW)
        LD E,A
        LD C,4
IO_CAPLOOP:
        LD A,D
        XOR E
        AND 3
        JR Z,IO_CAPNEXT                ; retain unchanged compiled placeholder routes
        LD A,E
        AND 3
        LD B,A
        INC B
        LD A,1
IO_BIT: DEC B
        JR Z,IO_BITDONE
        RLCA
        JR IO_BIT
IO_BITDONE:
        AND L
        JR Z,IO_BAD
IO_CAPNEXT:
        LD A,D
        RRCA
        RRCA
        LD D,A
        LD A,E
        RRCA
        RRCA
        LD E,A
        LD B,4
IO_CAPSHIFT:
        SRL H
        RR L
        DJNZ IO_CAPSHIFT
        DEC C
        JR NZ,IO_CAPLOOP
IO_CAPDONE:
        LD HL,IO_ASK
        CALL PUTS
        CALL CC_ASK
        CP 'Y'
        JR NZ,IO_RETURN
        LD HL,SGOLD
        LD DE,SGNEW
        LD BC,128
        LDIR
        LD HL,(IO_PTR)
        LD A,(IO_NEW)
        LD (HL),A
        LD HL,SGNEW
        LD (SGIOBUF),HL
        LD A,1
        CALL SGIO
        JR NZ,IO_ROLL
        CALL SGVERIFY
        JR NZ,IO_ROLL
        LD HL,IO_OK
        JR IO_REPORT
IO_ROLL:
        LD HL,SGOLD
        LD (SGIOBUF),HL
        CALL STRESTORE
        LD HL,SVRESTOK
        JR Z,IO_REPORT
        LD HL,STDAMAGED
        JR IO_REPORT
IO_BAD: LD HL,IO_ERROR
IO_REPORT:
        CALL PUTS
IO_RETURN:
        LD A,(CF_MODE)
        OR A
        JP NZ,DONE
IO_BACK:
        CALL FDBLOAD
        JP MAIN
IO_MENU:
        CALL IO_SHOW
        LD HL,IO_PROMPT
        CALL EDNUMBER
        JR C,IO_BACK
        LD A,D
        OR A
        JR NZ,IO_MBAD
        LD A,E
        AND 3
        CP 1
        JR NZ,IO_MBAD
        LD A,E
        LD (IO_NEW),A
        JP IO_APPLY
IO_MBAD:
        CALL ERROR
        JR IO_BACK
IO_PROMPT: DB 'Disk-boot IOBYTE (decimal): ',0
IO_SHOW:
        LD HL,IO_LIVE
        CALL PUTS
        LD C,7
        CALL BDOS
        CALL DECOUT
        CALL CRLF
        CALL IO_READ
        LD HL,IO_UNKNOWN
        JP NZ,PUTS
        LD HL,IO_SAVED
        CALL PUTS
        LD A,(IO_OLD)
        CALL DECOUT
        JP CRLF
IO_LIVE: DB 'Live IOBYTE (decimal): ',0
IO_SAVED: DB 'Saved disk-boot IOBYTE (decimal): ',0
IO_UNKNOWN: DB 'Saved disk-boot IOBYTE unavailable.',13,10,0
IO_KEY: DB '/IOBYTE=',0
IO_ASK: DB 'Save disk-boot IOBYTE (Y/N)? ',0
IO_OK: DB 'Disk-boot IOBYTE saved; live unchanged.',13,10,0
IO_ERROR: DB 'Cannot save cold IOBYTE. Nothing changed.',13,10,0
IO_NEW: DB 0
IO_OLD: DB 0
IO_PTR: DW 0
IO_DESC: DS 10

CF_TRYST:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,CF_STOP
        CALL CF_MATCH
        JP C,CD_PARSE
        LD DE,CF_TEXT
        LD B,0
CF_STRING:
        LD A,C
        OR A
        JR Z,CF_BAD
        LD A,(HL)
        INC HL
        DEC C
        CP '"'
        JR Z,CF_CLOSE
        CP 32
        JR C,CF_BAD
        CP 127
        JR NC,CF_BAD
        LD (DE),A
        INC DE
        INC B
        JR CF_STRING
CF_CLOSE:
        LD A,B
        LD (CF_LEN),A
        CALL CF_SKIP
        JR NZ,CF_BAD
        LD A,2
        LD (CF_MODE),A
        OR A
        RET
CF_MATCH:
        LD A,(DE)
        OR A
        RET Z
        LD B,A
        LD A,C
        OR A
        JR Z,CF_BAD
        LD A,(HL)
        CP 'a'
        JR C,CF_CMP
        CP 'z'+1
        JR NC,CF_CMP
        AND 5FH
CF_CMP: CP B
        JR NZ,CF_BAD
        INC HL
        INC DE
        DEC C
        JR CF_MATCH
CF_SKIP:
        LD A,C
        OR A
        RET Z
        LD A,(HL)
        CP 32
        JR Z,CF_ADV
        CP 9
        RET NZ
CF_ADV: INC HL
        DEC C
        JR CF_SKIP
CF_BAD: SCF
        RET
CF_USAGE:
        LD HL,CF_BADMSG
        CALL PUTS
        JP DONE
CF_CANCEL:
        LD A,(CF_MODE)
        CP 2
        JP Z,DONE
        JP SAVEMENU
CF_START:
        CALL STFETCH
        LD A,(STSTATE)
        CP 2
        JP Z,STSAVEINVALID
        CALL STDEFAULT
        LD A,(CF_LEN)
        LD (STPEND+8),A
        OR A
        JR Z,CF_STREADY
        LD B,A
        LD A,1
        LD (STPEND+7),A
        LD HL,CF_TEXT
        LD DE,STPEND+16
CF_STCOPY:
        LD A,(HL)
        LD (DE),A
        INC HL
        INC DE
        DJNZ CF_STCOPY
CF_STREADY:
        CALL STCHECKSUM
        LD A,1
        LD (STSTATE),A
        LD (STDIRTY),A
        JP STSAVE
 ; /DEFAULT resets only the private startup domain; saving remains explicit.
CF_DEFAULT:
        CALL STDEFAULT
        LD HL,CF_DEFCMD
        LD DE,STPEND+16
        LD BC,14
        LDIR
        LD A,14
        LD (STPEND+8),A
        LD A,1
        LD (STPEND+7),A
        LD (STSTATE),A
        LD (STDIRTY),A
        CALL STCHECKSUM
        XOR A
        LD (CF_MODE),A                 ; from here, ordinary interactive behavior
        LD HL,CF_DEFMSG
        CALL PUTS
        CALL PAUSE
        JP STARTMENU
CF_DEFOPT: DB '/DEFAULT',0
CF_DEFCMD: DB 'SUBMIT STARTUP'
CF_DEFMSG: DB 'Startup default pending; drives unchanged.',13,10,0
CF_SHOW:
        CALL IO_SHOW
        CALL FDBLOAD                   ; IO_READ borrows catalogue workspace
        LD HL,TITLE
        CALL PUTS
        CALL CRLF
        LD HL,CF_ACTIVE
        CALL PUTS
        XOR A
        LD (PHINDEX),A
CF_PLOOP:
        LD A,(PHINDEX)
        LD (PHREQ),A
        CALL DECOUT
        CALL CRLF
        LD DE,PHREQ
        LD B,1
        CALL API
        JP NZ,CF_READERR
        XOR A
        LD (FIELD),A
CF_FIELDS:
        CALL PHPRINT
        LD A,(FIELD)
        INC A
        LD (FIELD),A
        CP 6
        JR C,CF_FIELDS
        LD A,(PHINDEX)
        INC A
        LD (PHINDEX),A
        CP 4
        JR C,CF_PLOOP
        LD HL,CF_LOGMSG
        CALL PUTS
        XOR A
        LD (LOGIDX),A
CF_LLOOP:
        LD A,(LOGIDX)
        ADD A,'A'
        CALL PUTC
        LD A,':'
        CALL PUTC
        LD A,32
        CALL PUTC
        LD A,(LOGIDX)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,CF_READERR
        LD A,(REQ+1)
        CP 255
        JR Z,CF_UNBOUND
        CALL DECOUT
        LD HL,COLON
        CALL PUTS
        LD HL,REQ+1
        LD DE,CURB
        LD BC,64
        LDIR
        CALL FDBCURNAME
        JR CF_LNEXT
CF_UNBOUND:
        LD HL,UNDEF
        CALL PUTS
CF_LNEXT:
        CALL CRLF
        LD A,(LOGIDX)
        INC A
        LD (LOGIDX),A
        CP 4
        JR C,CF_LLOOP
        LD HL,CF_SAVED
        CALL PUTS
        CALL STFETCH
        LD A,(STSTATE)
        CP 2
        JR Z,CF_SBAD
        LD A,(STPEND+8)
        OR A
        JR Z,CF_SOFF
        LD B,A
        LD HL,STPEND+16
CF_SPRINT:
        LD A,(HL)
        CALL PUTC
        INC HL
        DJNZ CF_SPRINT
        CALL CRLF
        JR CF_SUMMARY
CF_SOFF:
        LD HL,CF_OFFMSG
        CALL PUTS
        JR CF_SUMMARY
CF_SBAD:
        LD HL,CF_UNKNOWN
        CALL PUTS
CF_SUMMARY:
        LD HL,CF_PENDING
        CALL PUTS
        LD HL,CF_SDMSG
        CALL PUTS
        JP SYSGEN                      ; same build/geometry validation, no writes

; Snapshot only editable saved fields before restoring the format catalogue,
; which shares SGHEAD/SGOLD/SGNEW workspace. DPH pointers are never installed.
CF_SDRIVES:
        LD HL,(SGPHOFF)
        LD DE,SGNEW
        ADD HL,DE
        LD DE,CF_PHY
        LD BC,24
        LDIR
        LD HL,(SGLOFF)
        LD DE,SGNEW+16
        ADD HL,DE
        LD DE,CF_LOG
        LD A,4
CF_SCOPY:
        PUSH AF
        LD BC,64
        LDIR
        LD BC,16
        ADD HL,BC
        POP AF
        DEC A
        JR NZ,CF_SCOPY
        CALL FDBLOAD
        LD HL,CF_SPHY
        CALL PUTS
        XOR A
        LD (PHINDEX),A
        LD HL,CF_PHY
CF_SPLOOP:
        LD DE,PHREQ+1
        LD BC,6
        LDIR
        PUSH HL
        LD A,(PHINDEX)
        CALL DECOUT
        CALL CRLF
        XOR A
        LD (FIELD),A
CF_SFIELD:
        CALL PHPRINT
        LD A,(FIELD)
        INC A
        LD (FIELD),A
        CP 6
        JR C,CF_SFIELD
        POP HL
        LD A,(PHINDEX)
        INC A
        LD (PHINDEX),A
        CP 4
        JR C,CF_SPLOOP
        LD HL,CF_SLOG
        CALL PUTS
        XOR A
        LD (LOGIDX),A
        LD HL,CF_LOG
CF_SLLOOP:
        LD DE,CURB
        LD BC,64
        LDIR
        PUSH HL
        LD A,(LOGIDX)
        ADD A,'A'
        CALL PUTC
        LD HL,COLON
        CALL PUTS
        LD A,(CURB)
        CP 255
        JR Z,CF_SUNDEF
        CALL DECOUT
        LD HL,COLON
        CALL PUTS
        CALL FDBCURNAME
        JR CF_SLNEXT
CF_SUNDEF:
        LD HL,UNDEF
        CALL PUTS
CF_SLNEXT:
        CALL CRLF
        POP HL
        LD A,(LOGIDX)
        INC A
        LD (LOGIDX),A
        CP 4
        JR C,CF_SLLOOP
        JP DONE
CF_READERR:
        LD HL,CF_ERROR
        CALL PUTS
        JP DONE
CF_SHOPT: DB '/SHOW',0
CF_STOP: DB '/STARTUP="',0
CF_BADMSG: DB 'Invalid CONFIG usage.',13,10,0
CF_ACTIVE: DB 'Active physical-drive profiles:',13,10,0
CF_LOGMSG: DB 'Active logical-drive bindings:',13,10,0
CF_SAVED: DB 'Saved cold-start command: ',0
CF_OFFMSG: DB 'disabled',13,10,0
CF_UNKNOWN: DB 'unreadable or invalid',13,10,0
CF_PENDING: DB 'Pending changes: none (new invocation).',13,10
        DB 0
CF_SDMSG: DB 'Saved drive defaults (system disk A:):',13,10,0
CF_SPHY: DB 'Saved physical-drive profiles:',13,10,0
CF_SLOG: DB 'Saved logical-drive bindings:',13,10,0
CF_PHY EQU 0A980H
CF_LOG EQU 0A880H
CF_ERROR: DB 'Cannot inspect drive configuration.',13,10,0
CF_MODE: DB 0
CF_LEFT: DB 0
CF_PTR: DW 0
CF_LEN: DB 0
CF_TEXT EQU 0A800H
CE_SEEN EQU 0A800H
CE_VALS EQU 0A813H

 ; Physical CLI edits the active profile only. All tail parsing and value
 ; validation finish before INIT or any configuration/file operation.
CD_PARSE:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,CD_PHOPT
        CALL CF_MATCH
        JP C,CE_PARSE
        CALL CD_NUM
        RET C
        CP 4
        JP NC,CF_BAD
        LD (CD_DRIVE),A
        XOR A
        LD (CD_MASK),A
CD_LOOP:
        CALL CF_SKIP
        JR Z,CD_END
        LD (CD_PTR),HL
        LD A,C
        LD (CD_LEFT),A
        XOR A
        LD (CD_FIELD),A
CD_FIND:
        LD A,(CD_FIELD)
        ADD A,A
        LD L,A
        LD H,0
        LD DE,CD_NAMES
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(CD_PTR)
        LD A,(CD_LEFT)
        LD C,A
        CALL CF_MATCH
        JR NC,CD_MATCH
        LD A,(CD_FIELD)
        INC A
        LD (CD_FIELD),A
        CP 6
        JR C,CD_FIND
        JP CF_BAD
CD_MATCH:
        CALL CD_NUM
        RET C
        PUSH HL
        PUSH BC
        CALL CD_VALID
        POP BC
        POP HL
        RET C
        PUSH HL
        LD A,(CD_FIELD)
        LD L,A
        LD H,0
        LD DE,CD_BITS
        ADD HL,DE
        LD A,(CD_MASK)
        AND (HL)
        JR NZ,CD_DUP
        LD A,(CD_MASK)
        OR (HL)
        LD (CD_MASK),A
        LD A,(CD_FIELD)
        LD L,A
        LD H,0
        LD DE,CD_VALS
        ADD HL,DE
        ; CD_VALUE survives table address calculation and preserves tail BC.
        LD A,(CD_VALUE)
        LD (HL),A
        POP HL
        JR CD_LOOP
CD_DUP: POP HL
        JP CF_BAD
CD_END: LD A,(CD_MASK)
        OR A
        JP Z,CF_BAD
        LD A,3
        LD (CF_MODE),A
        OR A
        RET

; Bounded decimal byte, followed by whitespace or end of tail. No signs,
; wrapping, abbreviated values or concatenated options are accepted.
CD_NUM: LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        SUB '0'
        CP 10
        JP NC,CF_BAD
        LD D,0
CD_DIGIT:
        LD A,(HL)
        SUB '0'
        LD B,A
        LD A,D
        CP 26
        JP NC,CF_BAD
        ADD A,A
        LD E,A
        ADD A,A
        ADD A,A
        ADD A,E
        ADD A,B
        JP C,CF_BAD
        LD D,A
        INC HL
        DEC C
        JR Z,CD_NEND
        LD A,(HL)
        CP '0'
        JR C,CD_NSEP
        CP ':'
        JR C,CD_DIGIT
CD_NSEP:
        CP 32
        JR Z,CD_NEND
        CP 9
        JP NZ,CF_BAD
CD_NEND:LD A,D
        OR A
        RET

; Return the stored value (step milliseconds become backend codes 0..3).
CD_VALID:
        LD D,A
        LD (CD_VALUE),A
        LD A,(CD_FIELD)
        OR A
        JR Z,CD_TYPE
        CP 1
        JR Z,CD_TRACK
        CP 2
        JR Z,CD_SIDE
        CP 3
        JR Z,CD_STEP
        CP 4
        JR NZ,CD_VOK
        LD A,D
        CP 17
        JP NC,CF_BAD
        JR CD_VOK
CD_TYPE:LD A,D
        CP 5
        JR Z,CD_VOK
        CP 8
        JP NZ,CF_BAD
        JR CD_VOK
CD_SIDE:LD A,D
        DEC A
        CP 2
        JP NC,CF_BAD
        JR CD_VOK
CD_TRACK:
        LD HL,TRKTAB
        JR CD_TABLE
CD_STEP:LD HL,STEPTAB
CD_TABLE:
        LD B,4
        LD E,0
CD_TLOOP:
        LD A,D
        CP (HL)
        JR Z,CD_TFOUND
        INC HL
        INC E
        DJNZ CD_TLOOP
        JP CF_BAD
CD_TFOUND:
        LD A,(CD_FIELD)
        CP 3
        JR NZ,CD_VOK
        LD A,E
        LD (CD_VALUE),A
CD_VOK: LD A,(CD_VALUE)
        OR A
        RET

CD_APPLY:
        LD A,(CD_DRIVE)
        LD (PHINDEX),A
        LD (PHREQ),A
        LD DE,PHREQ
        LD B,1
        CALL API
        JR NZ,CD_ERROR
        LD A,(CD_MASK)
        LD HL,CD_VALS
        LD DE,PHREQ+1
        LD B,6
CD_MERGE:
        RRCA
        PUSH AF
        JR NC,CD_MNEXT
        LD A,(HL)
        LD (DE),A
CD_MNEXT:
        POP AF
        INC HL
        INC DE
        DJNZ CD_MERGE
        CALL PHSAFE
        JR NZ,CD_ERROR
        LD DE,PHREQ
        LD B,2
        CALL API
        JR NZ,CD_ERROR
        CALL PHCLEAN
        LD A,(PHFAIL)
        OR A
        JR Z,CD_SUCCESS
        LD HL,CD_PART
        CALL PUTS
        JP DONE
CD_SUCCESS:
        LD HL,SAVED
        CALL PUTS
        LD A,(CHECKPH)
        OR A
        JP Z,DONE
        LD HL,PHDETMSG
        CALL PUTS
        JP DONE
CD_ERROR:
        LD HL,CD_ERRMSG
        CALL PUTS
        JP DONE
CD_PHOPT:DB '/PHYSICAL=',0
CD_NAMES:DW CD_OPT0,CD_OPT1,CD_OPT2,CD_OPT3,CD_OPT4,CD_OPT5
CD_OPT0:DB '/TYPE=',0
CD_OPT1:DB '/TRACKS=',0
CD_OPT2:DB '/SIDES=',0
CD_OPT3:DB '/STEP=',0
CD_OPT4:DB '/SPINUP=',0
CD_OPT5:DB '/SETTLE=',0
CD_BITS:DB 1,2,4,8,16,32
CD_ERRMSG:DB 'Cannot safely apply drive profile. Nothing changed.',13,10,0
CD_PART:DB 'Drive profile changed; binding cleanup incomplete.',13,10,0
CD_DRIVE:DB 0
CD_FIELD:DB 0
CD_MASK:DB 0
CD_VALUE:DB 0
CD_LEFT:DB 0
CD_PTR: DW 0
CD_VALS:DS 6
PHFAIL: DB 0

CF_NOMEM:
        LD HL,CF_MEMMSG
        JR CF_FATAL
CF_MEMMSG: DB 'Not enough transient memory (43K required).',13,10,0
CF_FATAL:
        CALL PUTS
        LD A,(CF_MODE)
        OR A
        CALL Z,PAUSE
        JP DONE

; Scalar workbench CLI. Parse into private values before any backend access.
CE_PARSE:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,CE_KEY
        CALL CF_MATCH
        JP C,CL_PARSE
        LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        CALL CL_UPPER
        SUB 'A'
        CP 1
        JP C,CF_BAD
        CP 4
        JP NC,CF_BAD
        LD (CL_DRIVE),A
        INC HL
        DEC C
        CALL CL_GAP
        RET C
        PUSH HL
        PUSH BC
        LD HL,CE_SEEN
        LD DE,CE_SEEN+1
        LD BC,18
        LD (HL),0
        LDIR
        POP BC
        POP HL
CE_LOOP:
        LD (CL_PTR),HL
        LD A,C
        LD (CL_LEFT),A
        XOR A
        LD (EDFIELD),A
CE_FIND:
        LD A,(EDFIELD)
        ADD A,A
        LD E,A
        LD D,0
        LD HL,CE_NAMES
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(CL_PTR)
        LD A,(CL_LEFT)
        LD C,A
        CALL CF_MATCH
        JR NC,CE_FOUND
        LD A,(EDFIELD)
        INC A
        LD (EDFIELD),A
        CP 19
        JR C,CE_FIND
        JP CF_BAD
CE_FOUND:
        CALL CE_NUM
        RET C
        PUSH HL
        PUSH BC
        PUSH DE
        LD A,(EDFIELD)
        LD E,A
        LD D,0
        LD HL,CE_SEEN
        ADD HL,DE
        LD A,(HL)
        OR A
        JR NZ,CE_BADPOP
        INC (HL)
        LD A,(EDFIELD)
        CP 16
        JR NC,CE_BYTE
        CALL EDADDR
        POP DE
        LD A,(EDWIDTH)
        CP 2
        JR Z,CE_STORE
        LD A,D
        OR A
        JR NZ,CE_BAD2
        JR CE_STORE
CE_BYTE:
        POP DE
        LD A,D
        OR A
        JR NZ,CE_BAD2
        LD A,(EDFIELD)
        CP 16
        JR NZ,CE_CODE
        LD A,E
        DEC A
        CP 32
        JR NC,CE_BAD2
CE_CODE:
        LD A,(EDFIELD)
        CP 18
        JR NZ,CE_STORE
        LD A,E
        CP 4
        JR NC,CE_BAD2
CE_STORE:
        LD A,(EDFIELD)
        ADD A,A
        LD L,A
        LD H,0
        LD BC,CE_VALS
        ADD HL,BC
        LD (HL),E
        INC HL
        LD (HL),D
        POP BC
        POP HL
        CALL CF_SKIP
        JP NZ,CE_LOOP
        LD A,(CE_SEEN+17)
        LD B,A
        LD A,(CE_SEEN+18)
        OR B
        LD B,A
        LD A,(CE_SEEN+16)
        CP B
        JP NZ,CF_BAD                  ; slot requires ID or code, and vice versa
        LD A,6
        LD (CF_MODE),A
        OR A
        RET
CE_BADPOP:
        POP DE
CE_BAD2:
        POP BC
        POP HL
        JP CF_BAD

; Unsigned decimal word with overflow checked before every addition.
CE_NUM:
        LD DE,0
        LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        SUB '0'
        CP 10
        JP NC,CF_BAD
CE_DIGIT:
        LD A,(HL)
        SUB '0'
        PUSH HL
        PUSH BC
        PUSH DE
        EX DE,HL
        ADD HL,HL
        JR C,CE_OVER
        ADD HL,HL
        JR C,CE_OVER
        POP DE
        PUSH DE
        ADD HL,DE
        JR C,CE_OVER
        ADD HL,HL
        JR C,CE_OVER
        LD E,A
        LD D,0
        ADD HL,DE
        JR C,CE_OVER
        EX DE,HL
        POP HL
        POP BC
        POP HL
        INC HL
        DEC C
        RET Z
        LD A,(HL)
        CP '0'
        JR C,CE_SEP
        CP ':'
        JR C,CE_DIGIT
CE_SEP: CP 32
        RET Z
        CP 9
        RET Z
        JP CF_BAD
CE_OVER:
        POP DE
        POP BC
        POP HL
        JP CF_BAD

CE_APPLY:
        LD A,(CL_DRIVE)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,CL_ERROR
        LD HL,REQ+1
        LD DE,EDCOPY
        LD BC,64
        LDIR
        XOR A
        LD (EDFIELD),A
CE_MERGE:
        LD A,(EDFIELD)
        LD E,A
        LD D,0
        LD HL,CE_SEEN
        ADD HL,DE
        LD A,(HL)
        OR A
        JR Z,CE_NEXT
        CALL EDADDR
        PUSH HL
        LD A,(EDFIELD)
        ADD A,A
        LD L,A
        LD H,0
        LD DE,CE_VALS
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        POP HL
        LD (HL),E
        LD A,(EDWIDTH)
        CP 2
        JR NZ,CE_NEXT
        INC HL
        LD (HL),D
CE_NEXT:
        LD A,(EDFIELD)
        INC A
        LD (EDFIELD),A
        CP 16
        JR C,CE_MERGE
        CALL CE_MAP
        LD HL,EDCOPY
        LD DE,BIND
        LD BC,64
        LDIR
        LD A,(EDCOPY)
        CP 4
        JP NC,CL_ERROR
        CALL COMPAT
        JP NZ,CL_ERROR
        LD HL,EDCOPY
        LD DE,REQ+1
        LD BC,64
        LDIR
        CALL EDCHECK
        JP NZ,CL_ERROR
        LD A,(REQ+1)
        JP CL_COMMIT
 ; One physical-order slot per invocation; repeat commands for additional slots.
CE_MAP:
        LD A,(CE_SEEN+16)
        OR A
        RET Z
        LD A,(CE_VALS+32)
        DEC A
        LD (EDSAVE),A
        LD E,A
        LD D,0
        LD A,(CE_SEEN+17)
        OR A
        JR Z,CE_MAPSIZE
        LD HL,EDCOPY+20
        ADD HL,DE
        LD A,(CE_VALS+34)
        LD (HL),A
CE_MAPSIZE:
        LD A,(CE_SEEN+18)
        OR A
        RET Z
        LD A,(CE_VALS+36)
        LD (EDNEW),A
        JP EDSIZESET
; The legacy setter's uniform fast path clears a size map when SPT still
; matches uniform geometry. Validate explicit maps first, rather than report
; success after silently dropping a requested size edit. Shared with menu I.
EDCHECK:
        LD A,(REQ+53)
        OR A
        RET Z
        LD IX,REQ
        LD BC,002B7H
        CALL BDOS
        LD DE,04644H
        OR A
        SBC HL,DE
        RET
CE_KEY: DB '/EDIT=',0
CE_NAMES: DW CE_N0,CE_N1,CE_N2,CE_N3,CE_N4,CE_N5,CE_N6,CE_N7
        DW CE_N8,CE_N9,CE_N10,CE_N11,CE_N12,CE_N13,CE_N14,CE_N15
        DW CE_N16,CE_N17,CE_N18
; Identical option spelling shares storage with the physical CLI parser.
CE_N0 EQU CD_PHOPT
CE_N1: DB '/SPT=',0
CE_N2: DB '/BSH=',0
CE_N3: DB '/BLM=',0
CE_N4: DB '/EXM=',0
CE_N5: DB '/DSM=',0
CE_N6: DB '/DRM=',0
CE_N7: DB '/AL0=',0
CE_N8: DB '/AL1=',0
CE_N9: DB '/CKS=',0
CE_N10: DB '/OFF=',0
CE_N11: DB '/CYLINDERS=',0
CE_N12: DB '/SECTORS=',0
CE_N13: DB '/SIZE=',0
CE_N14: DB '/FLAGS=',0
CE_N15: DB '/SIZEMAP=',0
CE_N16: DB '/SLOT=',0
CE_N17: DB '/ID=',0
CE_N18: DB '/CODE=',0
; CLI parsing modes are exclusive: startup text and edit scratch never coexist.


; Named logical bindings: first validate the complete tail, then resolve a
; unique catalogue description. No catalogue row number becomes a script ABI.
CL_PARSE:
        LD HL,(CF_PTR)
        LD A,(CF_LEFT)
        LD C,A
        LD DE,CL_LKEY
        CALL CF_MATCH
        RET C
        LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        AND 05FH
        SUB 'A'
        CP 1
        JP C,CF_BAD                    ; A: is the protected boot binding
        CP 4
        JP NC,CF_BAD
        LD (CL_DRIVE),A
        INC HL
        DEC C
        CALL CL_GAP
        RET C
        LD (CL_PTR),HL
        LD A,C
        LD (CL_LEFT),A
        LD DE,CL_UKEY
        CALL CF_MATCH
        JR C,CL_TRYB
        CALL CF_SKIP
        JP NZ,CF_BAD
        LD A,5
        JR CL_MODE
CL_TRYB:
        LD HL,(CL_PTR)
        LD A,(CL_LEFT)
        LD C,A
        LD DE,CD_PHOPT
        CALL CF_MATCH
        RET C
        CALL CD_NUM
        RET C
        CP 4
        JP NC,CF_BAD
        LD (CL_PHYS),A
        CALL CF_SKIP
        LD DE,CL_FKEY
        CALL CF_MATCH
        RET C
        PUSH HL
        PUSH BC
        LD HL,CL_NAME
        LD DE,CL_NAME+1
        LD BC,31
        LD (HL),32
        LDIR
        POP BC
        POP HL
        LD DE,CL_NAME
        LD B,0
        XOR A
        LD (CL_NON),A
CL_STRING:
        LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        INC HL
        DEC C
        CP '"'
        JR Z,CL_CLOSE
        CP 32
        JP C,CF_BAD
        CP 127
        JP NC,CF_BAD
        PUSH AF
        LD A,B
        CP 32
        JR NC,CL_LONG
        POP AF
        CALL CL_UPPER
        LD (DE),A
        CP 32
        JR Z,CL_SPACE
        LD A,1
        LD (CL_NON),A
CL_SPACE:
        INC DE
        INC B
        JR CL_STRING
CL_LONG:POP AF
        JP CF_BAD
CL_CLOSE:
        LD A,(CL_NON)
        OR A
        JP Z,CF_BAD
        CALL CF_SKIP
        JP NZ,CF_BAD
        LD A,4
CL_MODE:LD (CF_MODE),A
        OR A
        RET
CL_GAP: LD A,C
        OR A
        JP Z,CF_BAD
        LD A,(HL)
        CP 32
        JR Z,CL_SKIP
        CP 9
        JP NZ,CF_BAD
CL_SKIP:CALL CF_SKIP
        OR A
        RET
CL_UPPER:
        CP 'a'
        RET C
        CP 'z'+1
        RET NC
        AND 05FH
        RET

CL_BIND:
        XOR A
        LD (CL_INDEX),A
        LD (CL_FOUND),A
CL_SCAN:
        LD A,(CL_INDEX)
        LD B,A
        LD A,(FCOUNT)
        CP B
        JR Z,CL_RESOLVE
        LD A,B
        CALL FDBNAME
        JR C,CL_FMTERR
        LD DE,CL_NAME
        LD B,32
CL_CMP: LD A,(HL)
        CALL CL_UPPER
        LD C,A
        LD A,(DE)
        CP C
        JR NZ,CL_NEXT
        INC HL
        INC DE
        DJNZ CL_CMP
        LD A,(CL_FOUND)
        OR A
        JR NZ,CL_FMTERR                ; reject duplicate exact descriptions
        INC A
        LD (CL_FOUND),A
        LD A,(CL_INDEX)
        LD (CL_CHOS),A
CL_NEXT:LD A,(CL_INDEX)
        INC A
        LD (CL_INDEX),A
        JR CL_SCAN
CL_RESOLVE:
        LD A,(CL_FOUND)
        OR A
        JR Z,CL_FMTERR
        LD A,(CL_CHOS)
        CALL FDBBIND
        JR C,CL_FMTERR
        LD A,(CL_PHYS)
        CALL COMPAT
        JR NZ,CL_ERROR
        LD HL,BIND
        LD DE,REQ+1
        LD BC,64
        LDIR
        LD A,(CL_PHYS)
        JR CL_COMMIT
CL_UNBIND:
        LD A,255
CL_COMMIT:
        LD (REQ+1),A
        LD A,(CL_DRIVE)
        LD (REQ),A
        LD DE,REQ
        LD B,4
        CALL API
        JR NZ,CL_ERROR
        LD A,(CL_DRIVE)
        CALL RESETLOG
        LD HL,SAVED
        CALL PUTS
        JP DONE
CL_FMTERR:
        LD HL,CL_BADFMT
        JR CL_REPORT
CL_ERROR:
        LD HL,CL_BADLOG
CL_REPORT:
        CALL PUTS
        JP DONE
CL_LKEY:DB '/LOGICAL=',0
CL_UKEY:DB '/UNBIND',0
CL_FKEY:DB '/FORMAT="',0
CL_BADFMT:DB 'Unknown, ambiguous, or unsupported format. Nothing changed.',13,10,0
CL_BADLOG:DB 'Cannot apply logical binding. Nothing changed.',13,10,0
CL_DRIVE:DB 0
CL_PHYS:DB 0
CL_LEFT:DB 0
CL_PTR: DW 0
CL_NON: DB 0
CL_INDEX:DB 0
CL_FOUND:DB 0
CL_CHOS:DB 0
CL_NAME:DS 32

; @utility-title CONFIG@

MAINMSG:DB 'Configuration options:',13,10,13,10 ; main-menu text
        DB '[ A ] Startup command',13,10,13,10
        DB '[ B ] Cold-boot IOBYTE',13,10,13,10
        DB '[ C ] Disk drive definitions',13,10
        DB '[ D ] Disk format definitions',13,10
        DB '[ E ] Create or edit a disk format',13,10,13,10
        DB '[ S ] Save current configuration on disk (SYSGEN)',13,10,13,10,13,10
        DB 'Select [ A - E or S ], or BREAK (^C) to exit.',13,10,0


PHYHEAD:DB 'Disk drive selections',0    ; physical yhead

PHLABEL:DB 'Physical disk drive ',0     ; physical label

PHCOUNT:DB 13,10,'Number of drives: 4',13,10,13,10 ; physical count
        DB 'Select [ A - D ], or BREAK (^C) to return.',13,10,0

PHEDITTL:DB 'Disk drive definitions',0  ; physical edittl

FLDNAMES:DW FLD0,FLD1,FLD2,FLD3,FLD4,FLD5 ; field names

FLD0:   DB 'Type of drive (inches):     ',0 ; field 0
FLD1:   DB 'Number of tracks:           ',0 ; field 1
FLD2:   DB 'Number of sides:            ',0 ; field 2
FLD3:   DB 'Step rate (ms):             ',0 ; field 3
FLD4:   DB 'Motor spin-up (1/4 sec):    ',0 ; field 4
FLD5:   DB 'Head settling time (ms):    ',0 ; field 5
PHHELP: DB 13,10,'Select [ A - F ], or BREAK (^C) to return.',13,10,0 ; physical help

PHDETMSG:DB 13,10,'Incompatible logical drive binding unconfigured; use CONFIG G.',13,10,0 ; physical-drive binding invalidation message

NUMMSG EQU EDVALUE
TRKMSG: DB 13,10,'Track choices:',13,10 ; track-count msg
        DB '[ A ] 35',13,10,'[ B ] 40',13,10,'[ C ] 77',13,10,'[ D ] 80',13,10
        DB 'ENTER keeps current; ^C cancels.',13,10,0

; WD step rates scale with the controller clock: 1 MHz for 5-inch drives
; (Model 4), 2 MHz for 8-inch drives (Model II).
        IFNDEF  SYSINCH
SYSINCH EQU     5
        ENDIF
        IF      SYSINCH EQ 8
STEPMSG:DB 13,10,'Step rate choices (ms):',13,10 ; step-rate msg
        DB '[ A ] 3',13,10,'[ B ] 6',13,10,'[ C ] 10',13,10,'[ D ] 15',13,10
        DB 'ENTER keeps current; ^C cancels.',13,10,0

STEPTAB:DB 3,6,10,15                    ; step-rate tab
        ELSE
STEPMSG:DB 13,10,'Step rate choices (ms):',13,10 ; step-rate msg
        DB '[ A ] 6',13,10,'[ B ] 12',13,10,'[ C ] 20',13,10,'[ D ] 30',13,10
        DB 'ENTER keeps current; ^C cancels.',13,10,0

STEPTAB:DB 6,12,20,30                   ; step-rate tab
        ENDIF

TRKTAB: DB 35,40,77,80                  ; track-count tab

; -------------------------------------------------------------------------------
; Logical Menu Text
; -------------------------------------------------------------------------------

LOGHEAD:DB 'Disk format definitions',0  ; logical head

LOGHELP:DB 'Choose the letter of the drive to change:',13,10 ; logical help
        DB 'Drive Physical drive & current format',13,10,0

LOGFOOT:DB 13,10,'Select [ A - D ], or BREAK (^C) to return.',13,10,0 ; logical foot

COLON:  DB ': ',0                       ; colon

SELECTMSG:DB 'Choose the format to be used for drive ',0 ; selectmsg

PAGEHELP:DB ',< Previous   .> Next   ENTER: marked choice   ^C Return',13,10,0 ; format page help

CHOSENMSG:DB 'Format selected:',13,10,0 ; chosenmsg

ATTMSG: DB 13,10,'Which physical disk drive is to be used [0-3]? ',0 ; attmsg

BOOTMSG:DB 'A: is the system drive; its binding is protected.',13,10,0 ; protected boot-drive binding message

FMTBAD: DB 'BIOS support for this definition is not implemented.',13,10,0 ; fmtbad
HWMSG:  DB 'Disk format is incompatible with this drive!',13,10,0 ; hwmsg
SAVED:  DB 13,10,'Disk configuration changed (until cold boot).',13,10,0 ; saved

STTITLE:DB 'Startup command',0
STPREFIX:DB 'Pending startup command: ',0
STOFF:  DB 'Pending startup command: disabled.',13,10,0
STBAD:  DB 'Saved startup command record is invalid.',13,10,0
STPENDING:DB 'Pending startup command has not been saved.',13,10,0
STHELP: DB 13,10,'[ E ] Edit or replace command',13,10
        DB '[ C ] Clear and disable command',13,10
        DB '[ T ] Test pending command now',13,10
        DB 'BREAK (^C) returns without saving.',13,10,0
STEDITMSG:DB 'Command: ',0
STTESTING:DB 13,10,'Testing pending startup command...',13,10,0
STTESTNONE:DB 'There is no pending startup command to test.',13,10,0
STTEST126:DB 'A 126-byte command can run at cold boot but cannot use Test now.',13,10,0
STTESTSUB:DB 'Cannot test while an A0:$$$.SUB command stream is active.',13,10,0
STTESTBAD:DB 'Unable to create the one-command test stream on A:.',13,10,0
STMAGIC:DB 'BCST',1,0,16
STHEADER:DB 'BCST',1,0,16,0,0,126,0,1,0,0
         DW LY_SYS

SAVETITLE:DB 'Save startup defaults',0
SAVEHELP:DB '[ A ] Save pending cold-boot changes only',13,10
        DB '[ B ] Save all current settings as startup defaults',13,10
        DB 'BREAK (^C) returns without saving.',13,10,0
STSAVEASK:DB 'Save pending cold-boot changes on system disk A: (Y/N)? ',0
STSAVED:DB 'Pending cold-boot changes saved and verified.',13,10,0
SVMNONE:DB 'There are no pending cold-boot changes to save.',13,10,0
STSAVEBAD:DB 'Pending startup command is invalid. Edit or clear it first.',13,10,0
SVMIOERR:DB 'Cannot read startup defaults. Nothing saved.',13,10,0
SVRESTOK:DB 'Save failed. Original startup defaults restored.',13,10,0
STDAMAGED:DB 'Save failed; restoration also failed.',13,10
        DB 'Boot disk may be damaged. Use your backup.',13,10,0

; -------------------------------------------------------------------------------
; Utility State
; -------------------------------------------------------------------------------

PHINDEX:DB 0                            ; physical index

FIELD:  DB 0                            ; field
LOGIDX: DB 0                            ; logical idx
PAGE:   DB 0                            ; format page
ROW:    DB 0                            ; row
CHOSEN: DB 0                            ; chosen

CHECKPH:DB 0                            ; checkph

PHNOTICE:DB 0                           ; physical notice
STSTATE:DB 0                            ; 0 unloaded, 1 valid, 2 invalid source
STDIRTY:DB 0                            ; pending command differs from disk
STLINE EQU 0AB60H                      ; initialized before counted-line input
STPEND EQU 0A9A0H                          ; canonical pending BCST record
STSUBFCB:DB 1,'$$$     ','SUB'          ; A: stock command stream
        DS 24
STSUBBUF EQU 0AAE0H                         ; one counted submitted command
; CONFIG uses shared basic input with local cancellation/DEL normalization.
; @config-choices@
; @config-ui@
        INCLUDE disk/sysgen.inc
        INCLUDE disk/common.inc
FDBABORT EQU CF_FATAL
        INCLUDE disk/fdbread.inc
; @utility-version CONFIG@

; Caller-owned transient input state follows the existing counted-line buffer.
EDITBUF EQU STLINE+2
EDITLEN EQU STLINE+1
EDITCUR EQU STLINE
EDITSTART EQU 0ABE0H
EDITMAX EQU 0ABE1H
EDITPROMPT EQU 0ABE2H
CI_LAST EQU 0ABE4H
CI_BYTE EQU 0ABE5H
UIREAD EQU CI_READ
UIDRAW EQU CI_DRAW
UICANCEL EQU CI_CRLF
UIMESSAGE EQU CI_MESSAGE
UILIMITMSG EQU CI_LIMIT
UI_PUT EQU CI_PUT
UI_MARK EQU CI_MARKER
UI_COLUMNS EQU 79
        IF BP_CHECKED EQ 1
P12CONFIG EQU 1
        INCLUDE private-utility.inc
        ENDIF
        END
