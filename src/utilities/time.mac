; ********************************************************************************
; *                         BetterCP/M TIME Utility                              *
; *                                                                              *
; * Hardware-independent clock utility with canonical-record SET support.       *
; * Discovers TIME ABI 1.0 through Function 182 and calls the resolved provider. *
; * formats the returned CP/M day count and clock fields for display.            *
; ********************************************************************************


BDOS            EQU     0005H

        CSEG
        .PHASE  0103H

; ================================================================================
; =                     TIME Service Discovery and Dispatch                      =
; =                                                                              =
; = Parses the requested TIME operation and resolves TIME through Function 182.  =
; = invokes the provider, and handles unavailable/error results.                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Service Lookup and Call
; -------------------------------------------------------------------------------

START:                                  ; enter TIME utility
        CALL    UV_CHECK                ; standalone utility identity
        CALL    TM_PARSE
        JP      NZ,TM_USAGE
        LD      DE,TM_LOOKUP
        LD      C,182
        CALL    BDOS
        LD      (TM_DSTAT),A
        OR      A
        JP      NZ,TM_NOCLOCK
        LD      A,H
        OR      L
        JP      Z,TM_NOCLOCK
        LD      (TM_ENTRY),HL
        LD      A,(TM_MODE)
        OR      A
        CP      1
        JP      Z,TM_PROVIDER
        LD      DE,TM_REQUEST
        LD      BC,TM_GOT
        PUSH    BC
        JP      (HL)

TM_GOT:                                 ; handle resolved TIME service
        OR      A
        JP      NZ,TM_CLOCKERR
        LD      A,(TM_MODE)
        CP      2
        JP      Z,TM_SETDONE
        LD      DE,TM_NL
        CALL    TM_PRINT
        LD      HL,(TM_REQUEST+4)
        CALL    TM_DATE
        LD      A,' '
        CALL    TM_CHAR
        LD      A,(TM_REQUEST+6)
        CALL    TM_BCD
        LD      A,':'
        CALL    TM_CHAR
        LD      A,(TM_REQUEST+7)
        CALL    TM_BCD
        LD      A,':'
        CALL    TM_CHAR
        LD      A,(TM_REQUEST+8)
        CALL    TM_BCD
        LD      DE,TM_NL
        CALL    TM_PRINT
        JP      TM_EXIT

; ================================================================================
; =                             Provider Information                             =
; =                                                                              =
; = Formats the resolved provider name and capability flags for the TIME information =
; = display.                                                                     =
; ================================================================================
; -------------------------------------------------------------------------------
; Provider Name and Capabilities
; -------------------------------------------------------------------------------

TM_PROVIDER:                            ; display provider information
        LD      A,(TM_LOOKUP+18)
        LD      (TM_RSXREQ+2),A
        LD      DE,TM_RSXREQ
        LD      C,177
        CALL    BDOS
        OR      A
        JR      Z,TM_PNONAME
        LD      DE,TM_PNAME
        CALL    TM_PRINT
        LD      HL,TM_RSXREQ+4
        LD      B,8

TM_PNLOOP:                              ; copy provider name
        LD      A,(HL)
        CP      ' '
        JR      Z,TM_PNDONE
        PUSH    HL
        PUSH    BC
        CALL    TM_CHAR
        POP     BC
        POP     HL
        INC     HL
        DJNZ    TM_PNLOOP

TM_PNDONE:                              ; finish provider-name copy
        LD      DE,TM_NL
        CALL    TM_PRINT

TM_PNONAME:                             ; handle unnamed provider
        LD      DE,TM_PHEAD
        CALL    TM_PRINT
        LD      A,(TM_LOOKUP+14)
        CALL    TM_DEC8
        LD      A,'.'
        CALL    TM_CHAR
        LD      A,(TM_LOOKUP+15)
        CALL    TM_DEC8
        LD      DE,TM_PREAD
        CALL    TM_PRINT
        LD      A,(TM_LOOKUP+16)
        AND     1
        LD      DE,TM_PSET
        JR      NZ,TM_PCAP
        LD      DE,TM_PRO

TM_PCAP:                                ; display provider capabilities
        CALL    TM_PRINT
        LD      DE,TM_PINDEX
        CALL    TM_PRINT
        LD      A,(TM_LOOKUP+18)
        CALL    TM_DEC8
        LD      DE,TM_NL
        CALL    TM_PRINT
        JP      TM_EXIT

; ================================================================================
; =                               Command Parsing                                =
; =                                                                              =
; = Parses and uppercases the transient command tail and recognizes the supported TIME =
; = display/provider operations.                                                 =
; ================================================================================
; -------------------------------------------------------------------------------
; Command-Tail Parse
; -------------------------------------------------------------------------------

TM_PARSE:                               ; parse TIME command tail
        XOR     A
        LD      (TM_MODE),A
        LD      A,(0080H)
        OR      A
        RET     Z
        LD      B,A
        LD      HL,0081H

TM_PSPACE:                              ; skip command spaces
        LD      A,(HL)
        CP      ' '
        JR      NZ,TM_PARG
        INC     HL
        DJNZ    TM_PSPACE
        XOR     A
        RET

TM_PARG:                                ; parse command argument
        LD      A,B
        CP      19                      ; hex record, or MM/DD/YY HH:MM
        JP      Z,TM_SPAR
        CP      21                      ; MM/DD/YYYY HH:MM
        JP      Z,TM_SPAR
        CP      22                      ; MM/DD/YY HH:MM:SS
        JP      Z,TM_SPAR
        CP      24                      ; MM/DD/YYYY HH:MM:SS
        JP      Z,TM_SPAR
        CP      9
        JR      NZ,TM_PBAD
        LD      DE,TM_PKWORD
        LD      B,9

TM_PCMP:                                ; compare command keyword
        LD      A,(HL)
        CP      'a'
        JR      C,TM_PUP
        CP      'z'+1
        JR      NC,TM_PUP
        AND     5FH

TM_PUP:                                 ; uppercase command character
        LD      C,A
        LD      A,(DE)
        CP      C
        JR      NZ,TM_PBAD
        INC     HL
        INC     DE
        DEC     B
        JR      NZ,TM_PCMP

TM_POK:                                 ; accept parsed command
        LD      A,1
        LD      (TM_MODE),A
        XOR     A
        RET

TM_PBAD:                                ; reject invalid command
        LD      A,1
        OR      A
        RET

  ; /SET consumes five hexadecimal bytes in canonical wire order. Validate
  ; all fields before service discovery; the provider still owns validation
  ; against its hardware date range and must reject unsupported SET itself.

TM_SPAR:                            ; parse canonical SET record
        LD      A,B
        LD      (TM_SLEN),A
        PUSH    HL
        LD      E,B
        LD      D,0
        ADD     HL,DE
        LD      (TM_SEND),HL            ; end of the command tail
        POP     HL
        LD      DE,TM_SKWORD
        LD      B,5
TM_SCMP:                                ; compare case-insensitive SET prefix
        LD      A,(HL)
        CP      'a'
        JR      C,TM_SCUP
        CP      'z'+1
        JR      NC,TM_SCUP
        AND     5FH
TM_SCUP:                                ; preserve punctuation during folding
        LD      C,A
        LD      A,(DE)
        CP      C
        JP      NZ,TM_PBAD
        INC     HL
        INC     DE
        DJNZ    TM_SCMP
        PUSH    HL                      ; MM/ starts a calendar date
        INC     HL
        INC     HL
        LD      A,(HL)
        POP     HL
        CP      '/'
        JP      Z,TM_SDATE
        LD      A,(TM_SLEN)             ; the hex record has one length
        CP      19
        JP      NZ,TM_PBAD
        LD      DE,TM_REQUEST+4
        LD      B,5
TM_SBYTE:                               ; decode one hexadecimal record byte
        CALL    TM_HEX
        JP      C,TM_PBAD
        RLCA
        RLCA
        RLCA
        RLCA
        LD      C,A
        CALL    TM_HEX
        JP      C,TM_PBAD
        OR      C
        LD      (DE),A
        INC     DE
        DEC     B
        JR      Z,TM_SVALID
        LD      A,(HL)
        CP      ' '
        JP      NZ,TM_PBAD
        INC     HL
        JR      TM_SBYTE
TM_SVALID:                              ; reject invalid packed-BCD fields
        LD      HL,TM_REQUEST+6
        LD      B,3
TM_SBCD:                                ; check decimal nibbles and clock range
        LD      A,(HL)
        AND     0FH
        CP      10
        JP      NC,TM_PBAD
        LD      A,B
        CP      3
        LD      A,(HL)
        JR      NZ,TM_SMIN
        CP      24H
        JR      TM_SRANGE
TM_SMIN:                                ; minute and second upper bounds
        CP      60H
TM_SRANGE:                              ; reject out-of-range clock fields
        JP      NC,TM_PBAD
        INC     HL
        DJNZ    TM_SBCD
        LD      A,1
        LD      (TM_REQUEST+2),A
        LD      A,2
        LD      (TM_MODE),A
        XOR     A
        RET
  ; /SET MM/DD/YY[YY] HH:MM[:SS]: convert a calendar date and local time to
  ; the canonical record, then share the hex form's BCD range checks. Two-digit
  ; years 78-99 are 1978-1999 and 00-77 are 2000-2077; four-digit years run
  ; 1978-2157, the range of the CP/M day count (day 65535 is 2157-06-05).
TM_SDATE:                               ; parse a calendar date and time
        CALL    TM_GET2                 ; month
        JP      C,TM_PBAD
        CALL    TM_BIN
        LD      (TM_SMON),A
        LD      C,'/'
        CALL    TM_SEP
        JP      NZ,TM_PBAD
        CALL    TM_GET2                 ; day
        JP      C,TM_PBAD
        CALL    TM_BIN
        LD      (TM_SDAY),A
        LD      C,'/'
        CALL    TM_SEP
        JP      NZ,TM_PBAD
        CALL    TM_GET2                 ; year, first two digits
        JP      C,TM_PBAD
        CALL    TM_BIN
        LD      E,A
        LD      D,0
        LD      A,(HL)
        CP      ' '
        JR      Z,TM_SYY2
        PUSH    DE                      ; four digits: century first
        CALL    TM_GET2
        POP     DE
        JP      C,TM_PBAD
        CALL    TM_BIN
        PUSH    HL
        LD      H,D                     ; HL = century * 100 + A
        LD      L,E
        ADD     HL,HL
        ADD     HL,HL
        ADD     HL,DE                   ; *5
        ADD     HL,HL
        ADD     HL,HL                   ; *20
        LD      D,H
        LD      E,L
        ADD     HL,HL
        ADD     HL,HL                   ; *80
        ADD     HL,DE                   ; *100
        LD      E,A
        LD      D,0
        ADD     HL,DE
        EX      DE,HL
        POP     HL
        JR      TM_SYSET
TM_SYY2:                                ; two-digit year window
        LD      A,E
        LD      DE,1900
        CP      78
        JR      NC,TM_SYADD
        LD      DE,2000
TM_SYADD:
        ADD     A,E
        LD      E,A
        JR      NC,TM_SYSET
        INC     D
TM_SYSET:
        LD      (TM_SYEAR),DE
        LD      C,' '
        CALL    TM_SEP
        JP      NZ,TM_PBAD
        CALL    TM_GET2                 ; hour (packed BCD)
        JP      C,TM_PBAD
        LD      (TM_REQUEST+6),A
        LD      C,':'
        CALL    TM_SEP
        JP      NZ,TM_PBAD
        CALL    TM_GET2                 ; minute
        JP      C,TM_PBAD
        LD      (TM_REQUEST+7),A
        XOR     A
        LD      (TM_REQUEST+8),A        ; seconds default to zero
        CALL    TM_ATEND
        JR      Z,TM_SDCNT
        LD      C,':'
        CALL    TM_SEP
        JP      NZ,TM_PBAD
        CALL    TM_GET2                 ; second
        JP      C,TM_PBAD
        LD      (TM_REQUEST+8),A
        CALL    TM_ATEND
        JP      NZ,TM_PBAD

  ; Validate the date and convert it to a day count: day 1 is 1978-01-01.
TM_SDCNT:
        LD      HL,(TM_SYEAR)
        LD      DE,1978
        OR      A
        SBC     HL,DE
        JP      C,TM_PBAD
        LD      HL,(TM_SYEAR)
        LD      DE,2158
        OR      A
        SBC     HL,DE
        JP      NC,TM_PBAD
        LD      A,(TM_SMON)
        DEC     A
        CP      12
        JP      NC,TM_PBAD
        LD      HL,1
        LD      (TM_SCNT),HL
        LD      DE,1978
TM_SDYL:                                ; add each whole year before this one
        LD      HL,(TM_SYEAR)
        OR      A
        SBC     HL,DE
        JR      Z,TM_SDYD
        CALL    TM_YDAYS
        LD      BC,(TM_SCNT)
        ADD     HL,BC
        JP      C,TM_PBAD
        LD      (TM_SCNT),HL
        INC     DE
        JR      TM_SDYL
TM_SDYD:
        LD      C,1
TM_SDML:                                ; add each whole month before this one
        LD      A,(TM_SMON)
        CP      C
        JR      Z,TM_SDMD
        PUSH    BC
        CALL    TM_MDAYS
        POP     BC
        LD      HL,(TM_SCNT)
        ADD     A,L
        LD      L,A
        JR      NC,TM_SDMN
        INC     H
        JP      Z,TM_PBAD
TM_SDMN:
        LD      (TM_SCNT),HL
        INC     C
        JR      TM_SDML
TM_SDMD:                                ; day of month: 1 .. month length
        CALL    TM_MDAYS
        LD      B,A
        LD      A,(TM_SDAY)
        OR      A
        JP      Z,TM_PBAD
        DEC     A
        CP      B
        JP      NC,TM_PBAD
        LD      E,A
        LD      D,0
        LD      HL,(TM_SCNT)
        ADD     HL,DE
        JP      C,TM_PBAD
        LD      (TM_REQUEST+4),HL
        JP      TM_SVALID

  ; Two decimal digits at HL: A = packed BCD, carry if not digits; HL advances.
TM_GET2:
        CALL    TM_GETD
        RET     C
        RLCA
        RLCA
        RLCA
        RLCA
        LD      B,A
        CALL    TM_GETD
        RET     C
        OR      B
        RET
TM_GETD:
        LD      A,(HL)
        INC     HL
        SUB     '0'
        CP      10
        CCF
        RET

  ; Packed BCD A to binary A.
TM_BIN: LD      C,A
        AND     0F0H
        RRCA                            ; tens * 8
        LD      B,A
        RRCA
        RRCA                            ; tens * 2
        ADD     A,B
        LD      B,A
        LD      A,C
        AND     0FH
        ADD     A,B
        RET

  ; Consume separator C at HL: Z if present (and not past the end).
TM_SEP: CALL    TM_ATEND
        JR      Z,TM_SEPNO
        LD      A,(HL)
        INC     HL
        CP      C
        RET
TM_SEPNO:
        OR      1
        RET

  ; Z when HL has reached the end of the command tail.
TM_ATEND:
        PUSH    DE
        PUSH    HL
        LD      DE,(TM_SEND)
        OR      A
        SBC     HL,DE
        POP     HL
        POP     DE
        RET

TM_HEX:                                 ; consume one hexadecimal digit
        LD      A,(HL)
        INC     HL
        CP      '0'
        JR      C,TM_HBAD
        CP      '9'+1
        JR      C,TM_HDEC
        AND     5FH
        CP      'A'
        JR      C,TM_HBAD
        CP      'F'+1
        JR      NC,TM_HBAD
        SUB     'A'-10
        RET
TM_HDEC:                                ; decode decimal hexadecimal digit
        SUB     '0'
        RET
TM_HBAD:                                ; signal malformed hexadecimal input
        SCF
        RET

  ; Convert CP/M day count HL to Gregorian date and print YYYY-MM-DD.

; ================================================================================
; =                             CP/M Date Conversion                             =
; =                                                                              =
; = Converts the CP/M day count to Gregorian year, month, and day and prints the result =
; = as YYYY-MM-DD.                                                               =
; ================================================================================
; -------------------------------------------------------------------------------
; Day-Count to Gregorian Date
; -------------------------------------------------------------------------------

TM_DATE:                                ; convert and print CP/M date
        LD      A,H
        OR      L
        JR      NZ,TM_DNONZERO
        LD      DE,TM_EPOCH
        JP      TM_PRINT

TM_DNONZERO:                            ; handle nonzero day count
        LD      DE,1978
        DEC     HL                      ; day 1 is 1978-01-01, make zero-based

TM_YLOOP:                               ; find Gregorian year
        PUSH    HL
        PUSH    DE
        CALL    TM_YDAYS
        EX      DE,HL
        POP     BC                      ; year in BC
        POP     HL
        OR      A
        SBC     HL,DE
        JR      C,TM_YEARFOUND
        LD      D,B
        LD      E,C
        INC     DE
        JR      TM_YLOOP

TM_YEARFOUND:                           ; finish year conversion
        ADD     HL,DE
        LD      D,B
        LD      E,C
        PUSH    HL
        EX      DE,HL
        CALL    TM_DEC4
        LD      A,'-'
        CALL    TM_CHAR
        POP     HL
        LD      A,1
        LD      (TM_MON),A

TM_MLOOP:                               ; find Gregorian month
        PUSH    HL
        PUSH    DE
        LD      A,(TM_MON)
        LD      C,A
        CALL    TM_MDAYS
        LD      C,A
        LD      B,0
        POP     DE                      ; year
        POP     HL
        OR      A
        SBC     HL,BC
        JR      C,TM_MONTHFOUND
        LD      A,(TM_MON)
        INC     A
        LD      (TM_MON),A
        JR      TM_MLOOP

TM_MONTHFOUND:                          ; finish month conversion
        ADD     HL,BC
        PUSH    HL
        LD      A,(TM_MON)
        CALL    TM_DEC2
        LD      A,'-'
        CALL    TM_CHAR
        POP     HL
        INC     HL
        LD      A,L
        JP      TM_DEC2

  ; Input DE=year, output HL=365 or 366.

; -------------------------------------------------------------------------------
; Leap-Year Calculation
; -------------------------------------------------------------------------------

TM_YDAYS:                               ; return days in year
        LD      HL,365
        LD      A,D
        CP      HIGH 2100
        JR      NZ,TM_YMOD4
        LD      A,E
        CP      LOW 2100
        RET     Z

TM_YMOD4:                               ; test leap-year divisibility
        LD      A,E
        AND     3
        RET     NZ
        INC     HL
        RET

  ; Input DE=year, C=month 1..12, output A=days.

; -------------------------------------------------------------------------------
; Month Length
; -------------------------------------------------------------------------------

TM_MDAYS:                               ; return days in month
        LD      HL,TM_MTAB-1
        LD      B,0
        ADD     HL,BC
        LD      A,(HL)
        LD      B,A
        LD      A,C
        CP      2
        LD      A,B
        RET     NZ
        PUSH    AF
        LD      A,D
        CP      HIGH 2100
        JR      NZ,TM_MMOD4
        LD      A,E
        CP      LOW 2100
        JR      NZ,TM_MMOD4
        POP     AF
        RET

TM_MMOD4:                               ; handle February leap day
        POP     AF
        LD      A,E
        AND     3
        LD      A,B
        RET     NZ
        INC     A
        RET

; ================================================================================
; =                         Time and Numeric Formatting                          =
; =                                                                              =
; = Formats packed-BCD clock values and provides fixed-width/general decimal conversion =
; = used by TIME output.                                                         =
; ================================================================================
; -------------------------------------------------------------------------------
; Packed-BCD Output
; -------------------------------------------------------------------------------

TM_BCD:                                 ; print packed BCD time
        PUSH    AF
        RRCA
        RRCA
        RRCA
        RRCA
        AND     0FH
        ADD     A,'0'
        CALL    TM_CHAR
        POP     AF
        AND     0FH
        ADD     A,'0'
        JP      TM_CHAR

; -------------------------------------------------------------------------------
; Decimal Formatting
; -------------------------------------------------------------------------------

TM_DEC2:                                ; print two-digit decimal
        LD      B,'0'

TM_D2L:                                 ; convert two-digit decimal
        CP      10
        JR      C,TM_D2D
        SUB     10
        INC     B
        JR      TM_D2L

TM_D2D:                                 ; emit decimal digit
        PUSH    AF
        LD      A,B
        CALL    TM_CHAR
        POP     AF
        ADD     A,'0'
        JP      TM_CHAR

TM_DEC8:                                ; print eight-bit decimal
        JP      TM_DEC2

TM_DEC4:                                ; print four-digit decimal
        LD      BC,1000
        CALL    TM_DIG0
        LD      BC,100
        CALL    TM_DIG0
        LD      BC,10
        CALL    TM_DIG0
        LD      A,L
        ADD     A,'0'
        JP      TM_CHAR

TM_DIGIT:                               ; emit decimal digit
        LD      A,H
        OR      A
        JR      NZ,TM_DIG0
        LD      A,L
        CP      C
        RET     C

TM_DIG0:                                ; suppress leading decimal zero
        LD      A,'0'

TM_DLOOP:                               ; convert decimal value
        OR      A
        SBC     HL,BC
        JR      C,TM_DDONE
        INC     A
        JR      TM_DLOOP

TM_DDONE:                               ; finish decimal conversion
        ADD     HL,BC
        JP      TM_CHAR

; -------------------------------------------------------------------------------
; Console Output
; -------------------------------------------------------------------------------

TM_CHAR:                                ; write console character
        PUSH    BC
        PUSH    DE
        PUSH    HL
        LD      E,A
        LD      C,2
        CALL    BDOS
        POP     HL
        POP     DE
        POP     BC
        RET

TM_PRINT:                               ; print $-terminated string
        LD      C,9
        JP      BDOS

; ================================================================================
; =                           Messages and Completion                            =
; =                                                                              =
; = Reports unavailable/provider errors or usage failures and returns through the normal =
; = transient exit path.                                                         =
; ================================================================================
; -------------------------------------------------------------------------------
; Error Reporting
; -------------------------------------------------------------------------------

TM_NOCLOCK:                             ; report unavailable clock
        LD      DE,TM_NOMSG
        CALL    TM_PRINT
        LD      A,(TM_DSTAT)
        CALL    TM_DEC8
        LD      DE,TM_NL
        JR      TM_ERROR

TM_CLOCKERR:                            ; report native TIME failure
  ; Keep ABI failures distinct; a read-only clock is not a hardware failure.
        CP      5
        LD      DE,TM_UNSET
        JR      Z,TM_ERROR
        CP      8
        LD      DE,TM_SETNO
        JR      Z,TM_ERROR
        CP      6
        LD      DE,TM_BADREC
        JR      Z,TM_ERROR
        LD      DE,TM_CERR
        JR      TM_ERROR

TM_SETDONE:                             ; report completed native clock update
        LD      DE,TM_SETOK
        JR      TM_ERROR

TM_USAGE:                               ; print TIME usage
        LD      DE,TM_UMSG

TM_ERROR:                               ; report TIME failure
        CALL    TM_PRINT

TM_EXIT:                                ; return to CCP
        LD      C,0
        JP      BDOS

; ================================================================================
; =                       TIME Requests and Working State                        =
; =                                                                              =
; = Defines Function-182 and provider request blocks, resolved entry/state,      =
; = calendar conversion data, and messages.                                      =
; = tables, provider text, messages, and the CP/M epoch constant.                =
; ================================================================================
; -------------------------------------------------------------------------------
; Requests and Provider State
; -------------------------------------------------------------------------------

TM_LOOKUP:     DB      1,20,0,0,'TIME',1,0,0,0 ; Function-182 lookup request
               DS      8

TM_RSXREQ:     DB      2,0,0,0          ; Function-177 v2 ENUMERATE request
               DB      '        '
               DW      0,0,0

TM_REQUEST:    DB      1,10,0,0         ; TIME provider request block
               DS      5
               DB      0

TM_ENTRY:      DW      0                ; resolved service entry
TM_MODE:       DB      0                ; selected TIME operation
TM_MON:        DB      0                ; current month
TM_DSTAT:      DB      0                ; date conversion state
TM_SLEN:       DB      0                ; SET command-tail length
TM_SEND:       DW      0                ; end of the SET command tail
TM_SYEAR:      DW      0                ; SET year
TM_SMON:       DB      0                ; SET month
TM_SDAY:       DB      0                ; SET day of month
TM_SCNT:       DW      0                ; SET day count being built
TM_SKWORD:     DB      '/SET '         ; canonical-record SET prefix
TM_PKWORD:     DB      '/PROVIDER'      ; packed provider word

; -------------------------------------------------------------------------------
; Calendar and Messages
; -------------------------------------------------------------------------------

TM_MTAB:       DB      31,28,31,30,31,30,31,31,30,31,30,31 ; month-length table
TM_NL:         DB      13,10,'$'        ; newline string
TM_PNAME:      DB      13,10,'Provider: $' ; provider-name buffer
TM_PHEAD:      DB      13,10,'TIME service ABI $' ; provider heading
TM_PREAD:      DB      ', GET$'         ; read capability text
TM_PSET:       DB      '/SET$'          ; set capability text
TM_PRO:        DB      ', read-only$'   ; read-only capability text
TM_PINDEX:     DB      ', provider index $' ; provider index
TM_NOMSG:      DB      13,10,'No TIME provider is loaded; service status $' ; no-clock message
TM_SETNO:      DB      13,10,'Clock provider does not support SET.',13,10,'$'
TM_BADREC:     DB      13,10,'Invalid clock record.',13,10,'$'
TM_CERR:       DB      13,10,'Clock provider error.',13,10,'$' ; clock-error message
TM_UNSET:      DB      13,10,'Clock unavailable. If it has not been set, use TIME /SET.',13,10,'$'
TM_SETOK:      DB      13,10,'Clock set.',13,10,'$'
TM_UMSG:       DB      13,10,'Usage: TIME [/PROVIDER]',13,10
               DB      '       TIME /SET MM/DD/YY[YY] HH:MM[:SS]',13,10
               DB      '       TIME /SET LL HH HR MN SC (five hex bytes)',13,10
               DB      '       Day low/high, BCD hour/minute/second.',13,10,'$' ; usage message
TM_EPOCH:      DB      '1977-12-31$'    ; CP/M epoch constant

; @utility-version TIME@

        .DEPHASE
        END
