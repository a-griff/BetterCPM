; Package records kept on a platform boot track before track 1 (see sysgen.inc).
        IFNDEF  BOOTRECS
BOOTRECS        EQU     0
        ENDIF
; Drive size (inches) of a valid system destination: 5 on Model 4, 8 on Model II.
        IFNDEF  SYSINCH
SYSINCH         EQU     5
        ENDIF
; ********************************************************************************
; *                          BetterCP/M SYSGEN Utility                           *
; *                                                                              *
; * Installs a BetterCP/M protected-system package on configured SYSTEM media.   *
; * Supports interactive A:-source, explicit source/destination drives, and      *
; * Package input and disk-to-file export; installation preserves files.        *
; ********************************************************************************

        INCLUDE layout.inc
        INCLUDE profile.inc
        ASEG
        ORG 0100H
BDOS    EQU 5
TAIL    EQU 0080H
IMAGE   EQU 04000H
BUFFER  EQU 03000H
VERIFY  EQU 03080H
PKGHEADER EQU 03100H
SYSRECS EQU 160
SYSBASE EQU LY_SYS

        CALL    UV_CHECK                ; standalone utility identity
        LD SP,03F00H
        IF BP_CHECKED EQ 1
        CALL P12CHECK
        ENDIF
        LD HL,(6)
        LD DE,IMAGE+SYSRECS*128
        OR A
        SBC HL,DE
        JP C,XLOWMEM
        CALL INIT
        LD HL,(1)                       ; page zero WBOOT jump follows the BIOS base
        DEC HL
        DEC HL
        DEC HL
        LD (BIOBASE),HL

        LD A,(TAIL)
        OR A
        JR Z,INTERACTIVE
        CALL PARSEARGS
        OR A
        JP Z,INPUTREADY
        CP 1
        JP Z,USAGEBAD
        CP 2
        JP Z,PKGBAD
        JP SOURCEBAD

; ================================================================================
; =                           SYSGEN Command Selection                           =
; =                                                                              =
; = Supports the traditional interactive A:-source workflow plus explicit source/destination =
; = drives or SYSTEM.SYS package installation without touching the destination filesystem. =
; ================================================================================
; -------------------------------------------------------------------------------
; Interactive Workflow
; -------------------------------------------------------------------------------

INTERACTIVE:                            ; enter interactive SYSGEN workflow
        XOR A
        LD (SOURCEDEV),A

AGAIN:  LD HL,TITLE                     ; again
        CALL HEADER
        LD HL,ASKDRV
        CALL PUTS
        CALL SG_DRIVE
        CP 3
        JP Z,0
        SUB 'B'
        CP 3
        JR NC,AGAIN
        INC A                           ; B..D become logical numbers 1..3
        LD (DEST),A
        CALL SHOWKEY
        CALL LOADDISK
        JP NZ,IOFAIL
        JP INPUTREADY

  ; Validate counted operands and build private FCBs for exact package names.
  ; Drive-only operands select system tracks; source-only selects export.

; ================================================================================
; =                             Command-Line Parsing                             =
; =                                                                              =
; = Parses exact package and drive operands from the counted command tail and =
; = selects package installation, disk installation, or system-track export.                               =
; ================================================================================
; -------------------------------------------------------------------------------
; Explicit Argument Forms
; -------------------------------------------------------------------------------

        INCLUDE sysgen-parse.inc

  ; Read and validate the version-1, TRS-80 SYSTEM.SYS package.

; ================================================================================
; =                           SYSTEM.SYS Package Input                           =
; =                                                                              =
; = Reads and validates the version-1 TRS-80 protected-system package before any target =
; = media is modified.                                                           =
; ================================================================================
; -------------------------------------------------------------------------------
; Package Validation
; -------------------------------------------------------------------------------

LOADFILE:                               ; load SYSTEM.SYS package
        LD DE,XARG1
        LD C,15
        CALL BDOS
        INC A
        IF BP_CHECKED EQ 1
        JP Z,LFERR
        ELSE
        JR Z,LFERR
        ENDIF
        LD DE,PKGHEADER
        LD C,26
        CALL BDOS
        LD DE,XARG1
        LD C,20
        CALL BDOS
        OR A
        IF BP_CHECKED EQ 1
        JP NZ,LFERR
        ELSE
        JR NZ,LFERR
        ENDIF
        LD HL,PKGHEADER
        LD DE,PKGMAGIC
        LD B,10

LFCMP:  LD A,(DE)                       ; lfcmp
        CP (HL)
        IF BP_CHECKED EQ 1
        JP NZ,LFERR
        ELSE
        JR NZ,LFERR
        ENDIF
        INC DE
        INC HL
        DJNZ LFCMP
        IF BP_CHECKED EQ 1
        CALL P11HCHK
        JP NZ,LFERR
        ENDIF
        LD HL,PKGHEADER+16
        LD DE,SOURCE
        LD BC,64
        LDIR
        LD HL,IMAGE
        LD B,SYSRECS

LFRD:   PUSH BC                         ; lfrd
        PUSH HL
        EX DE,HL
        LD C,26
        CALL BDOS
        LD DE,XARG1
        LD C,20
        CALL BDOS
        POP HL
        POP BC
        OR A
        IF BP_CHECKED EQ 1
        JP NZ,LFERR
        ELSE
        JR NZ,LFERR
        ENDIF
        LD DE,128
        ADD HL,DE
        DJNZ LFRD
        LD DE,XARG1
        LD C,20
        CALL BDOS
        CP 1
        IF BP_CHECKED EQ 1
        JP NZ,LFERR
        ELSE
        JR NZ,LFERR
        ENDIF
        LD DE,XARG1
        LD C,16
        CALL BDOS
        IF BP_CHECKED EQ 1
        INC A
        JP Z,LFERR
        CALL P11FCRC
        JP NZ,LFERR
        CALL P11CHECK
        JP NZ,LFERR
        ENDIF
        XOR A
        RET

LFERR:  LD A,2                          ; lferr
        OR A
        RET

  ; Buffer the canonical 160-record protected package from a bootable source.

; ================================================================================
; =                          Bootable Disk Source Input                          =
; =                                                                              =
; = Buffers the canonical protected package from a bootable source disk, beginning at =
; = record one before revisiting the boot sector.                                =
; ================================================================================
; -------------------------------------------------------------------------------
; Boot-Disk Package Buffering
; -------------------------------------------------------------------------------

LOADDISK:                               ; load package from bootable source
        LD HL,0
        LD (RECNO),HL
        LD A,(SOURCEDEV)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JR NZ,LDAPIBAD
        LD HL,REQ+1
        LD DE,SOURCE
        LD BC,64
        LDIR
        LD BC,(SOURCE+1)
        LD DE,(SOURCE+14)
        CALL RESCOUNT
        JR C,LDSIZEBAD
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JR NC,LDSIZEOK
        JR C,LDSIZEBAD

LDSIZEOK:                               ; ldsizeok
        LD A,1
        LD (NEEDREAD),A
        XOR A
        RET

READSOURCE:                             ; readsource
  ; Start at record one, matching the proven installer path.  This also gives
  ; real floppy hardware a normal sector transfer before revisiting the boot
  ; sector at record zero.
        LD HL,1
        LD (RECNO),HL

LDRD:   LD HL,(RECNO)                   ; ldrd
        LD DE,BUFFER
        XOR A
        CALL DISKIO
        JR NZ,LDIOBAD
        LD HL,(RECNO)
        CALL IMAGEPTR
        LD HL,BUFFER
        LD BC,128
        LDIR
        LD HL,(RECNO)
        INC HL
        LD (RECNO),HL
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JR C,LDRD
        LD HL,0
        LD (RECNO),HL
        LD DE,BUFFER
        XOR A
        CALL DISKIO
        JR NZ,LDIOBAD
        LD HL,(RECNO)
        CALL IMAGEPTR
        LD HL,BUFFER
        LD BC,128
        LDIR
        XOR A
        RET

LDAPIBAD:LD A,11                        ; ldapibad
        OR A
        RET

LDSIZEBAD:LD A,12                       ; ldsizebad
        OR A
        RET

LDIOBAD:ADD A,20                        ; ldiobad
        OR A
        RET

  ; BC=records/track, DE=reserved tracks. Return HL=records, carry on overflow.

; -------------------------------------------------------------------------------
; Reserved Record Count
; -------------------------------------------------------------------------------

RESCOUNT:                               ; rescount
        LD HL,0

RCLP:   LD A,D                          ; rclp
        OR E
        RET Z
        ADD HL,BC
        RET C
        DEC DE
        JR RCLP

INPUTREADY:                             ; inputready
        LD A,(XEXPORT)
        OR A
        JP NZ,XEXPORTGO
        LD A,(DEST)
        LD (REQ),A
        LD DE,REQ
        LD B,3
        CALL API
        JP NZ,APIBAD
        LD HL,REQ+1
        LD DE,TARGET
        LD BC,64
        LDIR
        LD A,(TARGET)
        OR A
        JP Z,PROTECT
        CP 4
        JP NC,APIBAD
        LD B,A
        LD A,(SOURCE)
        CP B
        JR NZ,GEOMETRY
        LD A,(FILEMODE)
        OR A
        JP Z,ALIAS

; ================================================================================
; =                       Destination Geometry Validation                        =
; =                                                                              =
; = Normalizes bootstrap-vs-runtime double-sided geometry, compares destination format, =
; = and verifies that reserved records can hold the canonical package.           =
; ================================================================================
; -------------------------------------------------------------------------------
; Geometry Normalization
; -------------------------------------------------------------------------------

GEOMETRY:                               ; validate destination geometry
  ; Bootstrap A: expresses a double-sided cylinder as one logical track.
  ; CONFIG's ordinary bindings express the same disk as two surface tracks.
  ; Make a comparison copy in the latter form, as DUP has done since 1.10.
        LD HL,SOURCE
        LD DE,EXPECT
        LD BC,64
        LDIR
        LD A,(EXPECT+19)
        BIT 5,A
        JR Z,CMPFMT
        AND 0DFH
        OR 040H
        LD (EXPECT+19),A
        LD HL,(EXPECT+1)
        SRL H
        RR L
        LD (EXPECT+1),HL
        LD HL,(EXPECT+14)
        ADD HL,HL
        LD (EXPECT+14),HL

; -------------------------------------------------------------------------------
; Format Comparison
; -------------------------------------------------------------------------------

CMPFMT:LD HL,EXPECT+16                  ; cmpfmt
        LD DE,TARGET+16
        LD B,45                         ; compare boot geometry, IDs and size map only

CMPLP:  LD A,(DE)                       ; cmplp
        CP (HL)
        JP NZ,BOOTFMT
        INC DE
        INC HL
        DJNZ CMPLP

  ; Destination reserved records = SPT * OFF and must hold the canonical
  ; payload. A larger reserved area is allowed and is left otherwise untouched.
        LD BC,(TARGET+1)
        LD DE,(TARGET+14)
        LD HL,0

COUNTLP:LD A,D                          ; countlp
        OR E
        JR Z,COUNTED
        ADD HL,BC
        JP C,NOSPACE
        DEC DE
        JR COUNTLP

COUNTED:LD A,H                          ; counted
        OR L
        JP Z,NOSPACE
        LD DE,SYSRECS
        OR A
        SBC HL,DE
        JP C,NOSPACE
        LD HL,SYSRECS
        LD (NRECS),HL
        LD HL,SUMMARY
        CALL PUTS
        LD A,(DEST)
        ADD A,'A'
        CALL PUTC
        LD HL,PHYMSG
        CALL PUTS
        LD A,(TARGET)
        CALL DECOUT
        CALL CRLF
        LD HL,RECORDMSG
        CALL PUTS
        LD HL,(NRECS)
        CALL WORDOUT
        CALL CRLF
        LD HL,WARNING
        CALL PUTS
        CALL SG_ASK
        CP 'Y'
        JP NZ,0
        CALL CRLF
        LD A,(NEEDREAD)
        OR A
        JR Z,IMAGEOK
        CALL READSOURCE
        JR Z,IMAGEOK
        LD (STATUS),A
        JP SOURCEBAD

IMAGEOK:                                ; imageok
        IF BP_CHECKED EQ 1
        CALL P11CHECK
        JP NZ,PKGBAD
        CALL P11FILES
        JP NZ,P11FBAD
        ENDIF
        CALL PATCHTARGET
        JP NZ,PKGBAD
        JP WRIMAGE

  ; Patch the package's installed physical drive zero and A: binding to the
  ; destination definition. The disk-facing binding uses one track per surface;
  ; the bootstrap binding uses one track per cylinder on a double-sided disk.

; ================================================================================
; =                         Destination Package Patching                         =
; =                                                                              =
; = Patches physical drive zero and the installed A: binding for the destination, with =
; = separate surface-track and bootstrap cylinder-track representations.         =
; ================================================================================
; -------------------------------------------------------------------------------
; Destination Binding Patch
; -------------------------------------------------------------------------------

PATCHTARGET:                            ; patch package for destination
        LD A,(TARGET)
        LD (REQ),A
        LD DE,REQ
        LD B,1
        CALL API
        RET NZ
        LD A,(REQ+1)                    ; destination must be the platform's
        CP SYSINCH                      ; system drive size (inches)
        JR NZ,PTBAD
        CALL FINDDESC
        RET NZ
        LD (DESCPTR),HL
        LD DE,8
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL ABSTOIMG
        LD DE,REQ+1
        EX DE,HL
        LD BC,6
        LDIR
        LD HL,TARGET
        LD DE,BOOTBIND
        LD BC,64
        LDIR
        XOR A
        LD (BOOTBIND),A
        LD A,(BOOTBIND+19)
        BIT 6,A
        JR Z,PTBIND
        AND 0BFH
        OR 020H
        LD (BOOTBIND+19),A
        LD HL,(BOOTBIND+1)
        ADD HL,HL
        JR C,PTBAD
        LD (BOOTBIND+1),HL
        LD HL,(BOOTBIND+14)
        BIT 0,L
        JR NZ,PTBAD
        SRL H
        RR L
        LD (BOOTBIND+14),HL

PTBIND:LD HL,(DESCPTR)                  ; ptbind
        LD DE,10
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        EX DE,HL
        CALL ABSTOIMG
        LD DE,16
        ADD HL,DE
        LD DE,BOOTBIND
        EX DE,HL
        LD BC,64
        LDIR
        XOR A
        RET

PTBAD:  LD A,1                          ; ptbad
        OR A
        RET

ABSTOIMG:                               ; abstoimg
        LD DE,SYSBASE
        OR A
        SBC HL,DE
        LD DE,IMAGE+1024
        ADD HL,DE
        RET

; -------------------------------------------------------------------------------
; Resident Descriptor Lookup
; -------------------------------------------------------------------------------

FINDDESC:                               ; finddesc
        LD HL,IMAGE+1024
        LD BC,52*128-12

FDLOOP:LD A,(HL)                        ; fdloop
        CP 'B'
        JR NZ,FDNEXT
        INC HL
        LD A,(HL)
        CP 'D'
        JR NZ,FDBACK1
        INC HL
        LD A,(HL)
        CP 'C'
        JR NZ,FDBACK2
        INC HL
        LD A,(HL)
        CP 'F'
        JR NZ,FDBACK3
        DEC HL
        DEC HL
        DEC HL
        XOR A
        RET

FDBACK3:DEC HL                          ; fdback3

FDBACK2:DEC HL                          ; fdback2

FDBACK1:DEC HL                          ; fdback1

FDNEXT: INC HL                          ; fdnext
        DEC BC
        LD A,B
        OR C
        JR NZ,FDLOOP
        LD A,1
        OR A
        RET

  ; Copy records 1 through N-1 first.  Record zero, containing stage zero,
  ; is installed only after the rest has passed immediate read-back checks.

; ================================================================================
; =                        Protected-System Installation                         =
; =                                                                              =
; = Writes records 1..N-1 first with immediate readback verification, then installs record =
; = zero only after the remainder of the package has succeeded.                  =
; ================================================================================
; -------------------------------------------------------------------------------
; Install Ordering
; -------------------------------------------------------------------------------

WRIMAGE:                                ; install protected-system image
        LD HL,1
        LD (RECNO),HL
        LD HL,0
        LD (TRACKNO),HL
        LD HL,1
        LD (NEXTTRK),HL

COPYLP: CALL BREAKCK                    ; copylp
        JP Z,STOPPED
        CALL PROGRESS
        CALL COPYREC
        JP NZ,IOFAIL
        LD HL,(RECNO)
        INC HL
        LD (RECNO),HL
        LD DE,(NRECS)
        OR A
        SBC HL,DE
        JR C,COPYLP
        LD HL,0
        LD (RECNO),HL
        CALL COPYREC
        JP NZ,IOFAIL
        LD DE,0FFFFH                    ; discard every logged-drive vector
        LD C,37
        CALL BDOS
        LD HL,COMPLETE
        CALL PUTS
        JP 0

  ; Write buffered source, read target again, and compare all 128 bytes.

; -------------------------------------------------------------------------------
; Write/Readback Verification
; -------------------------------------------------------------------------------

COPYREC:LD HL,(RECNO)                   ; copyrec
        CALL IMAGEPTR
        EX DE,HL
        LD DE,BUFFER
        LD BC,128
        LDIR
        LD A,1
        LD HL,(RECNO)
        LD DE,BUFFER
        CALL DISKIO
        RET NZ
        LD A,2
        LD HL,(RECNO)
        LD DE,VERIFY
        CALL DISKIO
        RET NZ
        LD HL,BUFFER
        LD DE,VERIFY
        LD B,128

VERIFYLP:LD A,(DE)                      ; verifylp
        CP (HL)
        JR NZ,VERIFYBAD
        INC DE
        INC HL
        DJNZ VERIFYLP
        XOR A
        RET

VERIFYBAD:LD A,0FEH                     ; verifybad
        OR A
        RET

  ; Convert a logical package record in HL to its transient address in DE.

IMAGEPTR:                               ; imageptr
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        ADD HL,HL
        LD DE,IMAGE
        ADD HL,DE
        EX DE,HL
        RET

  ; A=0 reads A:.  A=1 writes destination.  A=2 reads destination.
  ; HL is the 128-byte logical record number and DE is its transfer buffer.

; ================================================================================
; =                            Raw Package Record I/O                            =
; =                                                                              =
; = Maps package logical records to BIOS track/sector operations for source reads and =
; = destination writes/readback without using the destination filesystem.        =
; ================================================================================
; -------------------------------------------------------------------------------
; Record Mapping and Transfer
; -------------------------------------------------------------------------------

DISKIO: LD (IOMODE),A                   ; perform package record I/O
        LD (IOREC),HL
        LD (IOBUF),DE
        OR A
        JR NZ,IOTARGET
        LD A,(SOURCEDEV)
        JR IODRIVE

IOTARGET:                               ; iotarget
        LD A,(DEST)

IODRIVE:LD (IODRV),A                    ; iodrive
        LD C,A
        LD B,0
        LD E,0
        LD A,27
        CALL BCALL
        LD A,H
        OR L
        JR Z,SELECTBAD
        LD DE,10
        ADD HL,DE
        LD E,(HL)
        INC HL
        LD D,(HL)
        LD HL,(IOREC)
        LD A,(DE)                       ; DPB+0 = logical records per track
        LD C,A
        INC DE
        LD A,(DE)
        LD B,A
        IF      BOOTRECS NE 0
  ; Platforms with a boot track keep package records 0..BOOTRECS-1 there;
  ; record r beyond them is BIOS record SPT + (r - BOOTRECS). Records < 256.
        LD A,L
        CP BOOTRECS
        JR C,IOMAPX
        LD DE,-BOOTRECS
        ADD HL,DE
        ADD HL,BC
IOMAPX:
        ENDIF
        LD DE,0

DIVLP:  OR A                            ; divlp
        SBC HL,BC
        JR C,DIVDONE
        INC DE
        JR DIVLP

DIVDONE:ADD HL,BC                       ; divdone
        PUSH HL                         ; remainder is sector number
        EX DE,HL                        ; quotient is track number
        LD B,H
        LD C,L
        LD A,30
        CALL BCALL
        POP BC
        LD A,33
        CALL BCALL
        LD BC,(IOBUF)
        LD A,36
        CALL BCALL
        LD A,(IOMODE)
        CP 1
        LD A,39
        JR NZ,IOGO
        LD BC,0
        LD A,42

IOGO:   CALL BCALL                      ; iogo
        OR A
        RET

SELECTBAD:LD A,0FFH                     ; selectbad
        OR A
        RET

  ; Show progress once per A: logical track rather than scrolling 160 lines.

; -------------------------------------------------------------------------------
; Track-Level Progress
; -------------------------------------------------------------------------------

PROGRESS:LD HL,(RECNO)                  ; progress
        LD DE,(NEXTTRK)
        OR A
        SBC HL,DE
        RET NZ
        LD HL,INSTALLING
        CALL PUTS
        LD HL,(TRACKNO)
        CALL WORDOUT
        CALL CRLF
        LD HL,(TRACKNO)
        INC HL
        LD (TRACKNO),HL
        LD HL,(NEXTTRK)
        LD DE,(TARGET+1)
        ADD HL,DE
        LD (NEXTTRK),HL
        RET

BREAKCK:LD C,6                          ; breakck
        LD E,0FFH
        CALL BDOS
        CP 3
        RET

IOFAIL:LD (STATUS),A                    ; iofail
        LD HL,FAILMSG
        CALL PUTS
        LD HL,(RECNO)
        CALL WORDOUT
        LD HL,STATUSMSG
        CALL PUTS
        LD A,(STATUS)
        CALL DECOUT
        CALL CRLF
        LD HL,PARTIAL
        CALL PUTS
        JP 0

STOPPED:LD HL,STOPMSG                   ; stopped
        CALL PUTS
        JP 0

BADFMT:LD HL,FMTMSG                     ; badfmt
        JR REPORT

BOOTFMT:LD HL,BOOTMSG                   ; bootfmt
        JR REPORT

NOSPACE:LD HL,SPACEMSG                  ; nospace
        JR REPORT

PKGBAD:LD HL,PKGMSG                     ; pkgbad
        JR REPORT

SOURCEBAD:LD HL,SOURCEMSG               ; sourcebad
        CALL PUTS
        LD A,(SOURCEDEV)
        ADD A,'A'
        CALL PUTC
        LD A,':'
        CALL PUTC
        LD A,' '
        CALL PUTC
        LD HL,(RECNO)
        CALL WORDOUT
        LD HL,STATUSMSG
        CALL PUTS
        LD A,(STATUS)
        CALL DECOUT
        CALL CRLF
        JP 0

USAGEBAD:LD HL,USAGEMSG                 ; usagebad
        JR REPORT

PROTECT:LD HL,PROTMSG                   ; protect
        JR REPORT

ALIAS:  LD HL,ALIASMSG                  ; alias
        JR REPORT

APIBAD: LD HL,APIERR                    ; apibad

REPORT: CALL PUTS                       ; report
        JP 0

  ; The utility ABI keeps SYSGEN independent of the installed BIOS address.

; ================================================================================
; =                       Utility ABI and Console Services                       =
; =                                                                              =
; = Keeps SYSGEN independent of the installed BIOS address and provides portable console, =
; = numeric, and heading output through the utility ABI/BDOS.                    =
; ================================================================================
; -------------------------------------------------------------------------------
; Utility ABI Entry
; -------------------------------------------------------------------------------

API:    LD C,181                        ; call utility disk API
        CALL BDOS
        LD A,L
        OR A
        RET

; -------------------------------------------------------------------------------
; ABI Initialization
; -------------------------------------------------------------------------------

INIT:   LD B,0                          ; initialize SYSGEN ABI
        LD DE,REQ
        CALL API
        LD DE,MAGIC
        LD B,8

ABICMP: LD A,(DE)                       ; abicmp
        CP (HL)
        JP NZ,NOABI
        INC DE
        INC HL
        DJNZ ABICMP
        LD C,178
        LD E,0
        CALL BDOS
        LD (HASREV),A
        RET

NOABI:  LD HL,ABIMSG                    ; noabi
        CALL PUTS
        JP 0

BCALL:  LD HL,(BIOBASE)                 ; bcall
        PUSH DE
        LD E,A
        LD D,0
        ADD HL,DE
        POP DE
        JP (HL)

  ; Plain CP/M console service.  Strings end in zero.

; -------------------------------------------------------------------------------
; Console Output
; -------------------------------------------------------------------------------

PUTC:   PUSH AF                         ; write console character
        PUSH BC
        PUSH DE
        PUSH HL
        LD E,A
        LD C,2
        CALL BDOS
        POP HL
        POP DE
        POP BC
        POP AF
        RET

PUTS:   LD A,(HL)                       ; print zero-terminated string
        INC HL
        OR A
        RET Z
        CALL PUTC
        JR PUTS

CRLF:   LD A,13                         ; crlf
        CALL PUTC
        LD A,10
        JP PUTC

KEY:    LD C,6                          ; key
        LD E,0FFH
        CALL BDOS
        OR A
        JR Z,KEY
        CP 'a'
        RET C
        CP 'z'+1
        RET NC
        AND 05FH
        RET

SHOWKEY:PUSH AF                         ; showkey
        LD A,' '
        CALL PUTC
        POP AF
        PUSH AF
        ADD A,'A'
        CALL PUTC
        CALL CRLF
        POP AF
        RET

; -------------------------------------------------------------------------------
; Byte Decimal Output
; -------------------------------------------------------------------------------

DECOUT: LD C,0                          ; decout
        LD B,100
        CALL DECDIG
        LD B,10
        CALL DECDIG
        ADD A,'0'
        JP PUTC

DECDIG: LD D,'0'                        ; decdig

DECLP:  CP B                            ; declp
        JR C,DECDONE
        SUB B
        INC D
        JR DECLP

DECDONE:PUSH AF                         ; decdone
        LD A,D
        CP '0'
        JR NZ,DECSHOW
        LD A,C
        OR A
        JR Z,DECSKIP
        LD A,D

DECSHOW:CALL PUTC                       ; decshow
        LD C,1

DECSKIP:POP AF                          ; decskip
        RET

; -------------------------------------------------------------------------------
; Word Decimal Output
; -------------------------------------------------------------------------------

WORDOUT:LD C,0                          ; wordout
        LD DE,10000
        CALL WDIG
        LD DE,1000
        CALL WDIG
        LD DE,100
        CALL WDIG
        LD DE,10
        CALL WDIG
        LD A,L
        ADD A,'0'
        JP PUTC

WDIG:   LD B,'0'                        ; wdig

WDIGLP:OR A                             ; wdiglp
        SBC HL,DE
        JR C,WDIGDONE
        INC B
        JR WDIGLP

WDIGDONE:ADD HL,DE                      ; wdigdone
        LD A,B
        CP '0'
        JR NZ,WDIGSHOW
        LD A,C
        OR A
        RET Z
        LD A,B

WDIGSHOW:PUSH HL                        ; wdigshow
        CALL PUTC
        POP HL
        LD C,1
        RET

; -------------------------------------------------------------------------------
; Heading Output
; -------------------------------------------------------------------------------

HEADER: CALL UI_CLEAR                   ; explicit internal clear/home
        LD B,79

HEADLP: LD A,(HL)                       ; headlp
        OR A
        JR Z,HEADSP
        INC HL
        JR HEADOUT

HEADSP: LD A,' '                        ; headsp

HEADOUT:PUSH AF                         ; headout
        LD A,(HASREV)
        OR A
        JR NZ,HEADREV
        POP AF
        CALL PUTC
        JR HEADNEXT

HEADREV:POP AF                          ; headrev
        PUSH AF
        PUSH BC
        PUSH DE
        PUSH HL
        LD E,A
        LD C,178
        CALL BDOS
        POP HL
        POP DE
        POP BC
        POP AF

HEADNEXT:                               ; headnext
        DJNZ HEADLP
        CALL CRLF
        JP CRLF

; ================================================================================
; =                      SYSGEN Messages and Working State                       =
; =                                                                              =
; = Defines prompts, diagnostics, package identifiers, geometry, transfer buffers, source/ =
; = target state, and configuration request storage.                             =
; ================================================================================
; -------------------------------------------------------------------------------
; Messages and State
; -------------------------------------------------------------------------------

TITLE:  DB 'Install a BetterCP/M system (SYSGEN)',0 ; utility title
ASKDRV: DB 'Destination drive [ B - D ], or BREAK (^C) to exit: ',0 ; askdrv

SUMMARY:DB 13,10,'Install the selected BetterCP/M system on drive ',0 ; summary

PHYMSG: DB ':, physical drive ',0       ; phymsg

RECORDMSG:DB 'Reserved system records to copy and verify: ',0 ; recordmsg

WARNING:DB 13,10,'The destination system area will be replaced.',13,10 ; warning
        DB 'Files outside the reserved system tracks will be preserved.',13,10
        DB 'Proceed (Y/N)? ',0

INSTALLING:DB 'Installing system track ',0 ; installing

COMPLETE:DB 13,10,'System installed and verified. The destination is bootable.',13,10,0 ; complete

FMTMSG: DB 13,10,'The selected system format is invalid.',13,10,0 ; fmtmsg

BOOTMSG:DB 13,10,'Destination bootstrap geometry is not supported by this system package.',13,10,0 ; bootmsg

SPACEMSG:DB 13,10,'Destination reserved system area is too small (160 records required).',13,10,0 ; spacemsg

PKGMSG:DB 13,10,'The system package is invalid or cannot represent the destination.',13,10,0 ; pkgmsg

SOURCEMSG:DB 13,10,'Source system read failed at logical record ',0 ; sourcemsg

USAGEMSG:DB 13,10,'Usage: SYSGEN | A: B: | package B: | A: package | /VER',13,10,0 ; usagemsg

PROTMSG:DB 13,10,'Physical drive 0 is protected as the running system disk.',13,10,0 ; protmsg

ALIASMSG:DB 13,10,'Source and destination refer to the same physical drive.',13,10,0 ; aliasmsg

APIERR: DB 13,10,'The selected drive is undefined or unavailable.',13,10,0 ; apierr

FAILMSG:DB 13,10,'System installation failed at logical record ',0 ; failmsg

STATUSMSG:DB '; status ',0              ; status prefix

PARTIAL:DB 'The destination may not boot. Its file area was not changed.',13,10,0 ; partial

STOPMSG:DB 13,10,'Installation stopped. The destination may not boot.',13,10 ; stopmsg
        DB 'Its file area was not changed.',13,10,0

ABIMSG:DB 'SYSGEN requires BetterCP/M disk BIOS ABI 5.',13,10,0 ; abimsg

MAGIC:  DB 'BDCF',5,4,4,64              ; magic

        IF BP_CHECKED EQ 1
PKGMAGIC:DB 'BCSY',2,2,160,0
        ELSE
PKGMAGIC:DB 'BCSY',1,1,160,0
        ENDIF             ; pkgmagic
         DW LY_SYS

DEST:   DB 0                            ; dest

SOURCEDEV:DB 0                          ; sourcedev

FILEMODE:DB 0                           ; filemode

NEEDREAD:DB 0                           ; needread

STATUS: DB 0                            ; status
IOMODE: DB 0                            ; iomode
IODRV:  DB 0                            ; iodrv
HASREV: DB 0                            ; hasrev

BIOBASE:DW 0                            ; biobase

NRECS:  DW 0                            ; nrecs
RECNO:  DW 0                            ; recno
IOREC:  DW 0                            ; iorec
IOBUF:  DW 0                            ; 128-byte transfer buffer

TRACKNO:DW 0                            ; trackno

NEXTTRK:DW 0                            ; nexttrk

DESCPTR:DW 0                            ; descptr

SOURCE: DS 64                           ; source
TARGET: DS 64                           ; target
EXPECT: DS 64                           ; expect

BOOTBIND:DS 64                          ; bootbind

REQ:    DS 80                           ; configuration API request
        INCLUDE sysgen-export.inc
; @checked-package-guard@
; @utility-version SYSGEN@

; @sysgen-choice@
; @monitor-console@
        IF BP_CHECKED EQ 1
P12CONFIG EQU 0
        INCLUDE private-utility.inc
        ENDIF
        END
