; MD5SUM 1.0: ordinary CP/M 2.2 transient. Prepared by tools/build_md5sum.py.
        CSEG
        .PHASE 0103H
ENTRY:
        LD (OLDSP),SP
        LD SP,STACK
        LD HL,STATE
        LD BC,STATEEND-STATE
        CALL ZERO
        CALL TOKENIZE
        JP C,BADCOMMA
        CALL QUERIES
        JP NZ,RETURN
        LD C,25
        CALL BDOS
        LD (ORIGDRIV),A
        LD E,255
        LD C,32
        CALL BDOS
        LD (ORIGUSER),A
        CALL COMMAND
        JP C,BADCOMMA
        CALL COLLIDE
        JP C,BADCOMMA
        CALL RUN
        CALL TOTALS
RESTORE:
        LD A,(ORIGDRIV)
        LD E,A
        LD C,14
        CALL BDOS
        LD A,(ORIGUSER)
        LD E,A
        LD C,32
        CALL BDOS
        LD DE,0080H
        LD C,26
        CALL BDOS
RETURN:
        LD SP,(OLDSP)
        RET
BADCOMMA:
        LD HL,MSGCOMMA
        CALL TEXT
        JP RETURN
; @command@
; @traverse@
; @render@
; @lists@
; @output@
; @algorithms@
; @support@
; @selectors@
; @identity@
OLDSP: DW 0
STATE:
ORIGDRIV: DB 0
ORIGUSER: DB 0
DRIVE: DB 0
USER: DB 0
CURDU: DW 0
CHECK: DB 0
NARROW: DB 0
CONSCOL: DB 0
CANCEL: DB 0
INCOMPLE: DB 0
ALLYES: DB 0
TOKCOUNT: DB 0
TOKINDEX: DB 0
TOKENS: DS 192
TAIL: DS 128
TOKENPTR: DW 0
TOKENLEN: DB 0
OPERCOUN: DB 0
OPERPTR: DW 0
OPERANDS: DS 4864
DUSEEN: DS 64
DUCOUNT: DW 0
DUINDEX: DW 0
DUORDER: DS 1024
ACTIVECO: DB 0
ACTIVE: DS 768
MASTER: DS 38
LOCAL: DS 36
REFNAME: DS 36
MASTSET: DB 0
LOCALSET: DB 0
REFSET: DB 0
LASTNAME: DS 11
BESTNAME: DS 11
CANDNAME: DS 11
CANDATTR: DB 0
BESTSET: DB 0
DIRFCB: DS 36
DIRDMA: DS 128
FILEFCB: DS 36
FILEOPEN: DB 0
FILEDMA: DS 128
RECS: DS 4
EXPECTED: DS 4
FILES: DS 4
COUNTERS EQU FILES
VERIFIED: DS 4
FAILED: DS 4
MISSING: DS 4
UNLISTED: DS 4
SKIPPED: DS 4
LISTERRO: DS 4
DUERRORS: DS 4
OUTDONE: DS 4
OUTDECLI: DS 4
OUTERROR: DS 4
SKIPENTS: DS 4
COUNTEND:
NUMVALUE: DS 4
LINEPTR: DW 0
; MD5 rows/diagnostics are at most 128 bytes; reference text has its own buffer.
LINE: DS 128
NUMCOPY: DS 4
NUMBUF: DS 11
NUMPTR: DW 0
NUMWIDTH: DB 0
SAVEDHL: DW 0
SAVEDBC: DW 0
STATEEND:
        DS 512
STACK:
        .DEPHASE
        END ENTRY
