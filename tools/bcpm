#!/usr/bin/env bash
#
# bcpm - BetterCP/M control utility
#
# Possible workflow:
#
# 1. Create disk image with bcpm mkdisk
# 2. Copy files onto disk image with bcpm cp
# 3. Mount images as drives A-D with bcpm mount
# 4. Launch those images with bcpm z /usecurrent, or use bcpm z for built media
#

set -euo pipefail

repo="$HOME/projects/git/BetterCPM"
z80packloc="$repo/build/z80pack-daily"
distribution_builder="$repo/tools/build_distribution.py"
cpmsim_distribution="$repo/build/z80pack/disks/library/BetterCPM-Distribution-z80pack-332K.dsk"
disksloc="$z80packloc/disks"
trs80_distribution="$repo/build/trs80/BetterCPM-Distribution-trs80gp-80T-DS-System.dmk"
utilitiesloc="$repo/build/utilities-disks"
cpmsim_utilities="$utilitiesloc/BetterCPM-Utilities-z80pack-332K.dsk"
cpmsim_companion="$utilitiesloc/BetterCPM-NOAH-z80pack-332K.dsk"
trs80_companion="$utilitiesloc/BetterCPM-NOAH-trs80gp-80T-DS-800K.dmk"
trs80_utilities="$utilitiesloc/BetterCPM-Utilities-trs80gp-80T-DS-800K.dmk"
trs80gp_exe="$HOME/trs80/trs80gp-2/mac/trs80gp.app/Contents/MacOS/trs80gp"
prog="$(basename "$0")"

usage()
{
    cat <<EOF2
Usage: $prog COMMAND [arguments]

BetterCP/M control utility.

Commands:
  build               Build z80pack and trs80gp distribution images
  z [/usecurrent]     Launch cpmsim; /usecurrent preserves mounted A-D media
  t                   Launch trs80gp with the TRS-80 distribution disk
  cp                  Copy files to a CP/M disk image
  dir                 List files in a CP/M disk image
  mkdisk              Create a blank CP/M disk image
  mount               Attach a disk image to drive A, B, C, or D (cpmsim only)
  convert             Convert 332K/800K raw disk images to/from DMK

Use "$prog COMMAND -h" for help with a command.
EOF2
}

cp_usage()
{
    cat <<EOF2
Usage: $prog cp disk.img file [file ...]
       $prog cp -h

Copy files to a CP/M disk image.

The disk format is determined automatically from the image size.

Recognized formats:
  180k    184320 bytes    bettercpm-mm-standard-system
  200k    204800 bytes    bettercpm-ampro-little-board
  332k    368640 bytes    bettercpm-default
  400k    409600 bytes    bettercpm-ampro-little-board-ds
  800k    819200 bytes    bettercpm-mm-80t-ds-data

Options:
  -h      Display this help
EOF2
}

dir_usage()
{
    cat <<EOF2
Usage: $prog dir disk.img
       $prog dir -h

List files in a CP/M disk image and report remaining free space.

The disk format is determined automatically from the image size.
DMK images are not supported by cpmtools; convert them to raw .dsk first.

Recognized formats:
  180k    184320 bytes    bettercpm-mm-standard-system
  200k    204800 bytes    bettercpm-ampro-little-board
  332k    368640 bytes    bettercpm-default
  400k    409600 bytes    bettercpm-ampro-little-board-ds
  800k    819200 bytes    bettercpm-mm-80t-ds-data

Options:
  -h      Display this help
EOF2
}

mkdisk_usage()
{
    cat <<EOF2
Usage: $prog mkdisk -f FORMAT disk.img
       $prog mkdisk -h

Create a blank CP/M disk image.

Formats:
  180k    bettercpm-mm-standard-system
  200k    bettercpm-ampro-little-board
  332k    bettercpm-default
  400k    bettercpm-ampro-little-board-ds
  800k    bettercpm-mm-80t-ds-data

Options:
  -f FORMAT   Select disk format
  -h          Display this help
EOF2
}

mount_usage()
{
    cat <<EOF2
Usage: $prog mount {a|b|c|d} disk.img
       $prog mount -h

Attach a raw disk image to a BetterCP/M z80pack drive.

Drives:
  a, b, c, d (either case; an optional colon is accepted, e.g. A:)

Use "$prog z /usecurrent" to launch with these assignments unchanged.
Plain "$prog z" automatically selects the built A:, B: and C: images.

Options:
  -h      Display this help
EOF2
}

convert_usage()
{
    cat <<EOF2
Usage: $prog convert input.dsk output.dmk
       $prog convert input.dmk output.dsk
       $prog convert -h

Convert BetterCP/M disk images between raw and DMK formats.
The conversion direction and disk format are determined automatically.

Supported formats:
  332k    California Computer Systems (40T, DS, DD, 332K)
          raw image size: 368640 bytes
  800k    Montezuma Micro 80T DS DATA (80T, DS, DD, 800K)
          raw image size: 819200 bytes

Options:
  -h      Display this help
EOF2
}

ensure_diskdefs()
{
    if [ ! -e diskdefs ] && [ ! -L diskdefs ]; then
        ln -s "$z80packloc/diskdefs" diskdefs
    fi
}

build_usage()
{
    cat <<EOF2
Usage: $prog build
       $prog build -h

Build fresh System and provisional Utilities images for both emulators.
Mount primary Utilities as B: and companion Utilities as C:.
EOF2
}

z_usage()
{
    cat <<EOF2
Usage: $prog z [/usecurrent]
       $prog z -h

Launch cpmsim.

By default, mount the built System image as A:, primary Utilities as B:,
and companion Utilities as C:. D: keeps its current assignment.
Run "$prog build" first to generate those images.

Options:
  /usecurrent   Use the current A:-D: assignments without changing any mounts.
                Built distribution images are not required in this mode.
  -h            Display this help

Example:
  $prog mount a /path/to/system.dsk
  $prog z /usecurrent
EOF2
}

t_usage()
{
    cat <<EOF2
Usage: $prog t
       $prog t -h

Launch trs80gp with System A:, primary Utilities B:, companion C:, work D:.
EOF2
}

mount_utilities_b()
{
    if [ ! -f "$cpmsim_utilities" ]; then
        echo "$prog: Utilities disk not found; run '$prog build' first" >&2
        return 1
    fi
    mkdir -p "$disksloc"
    local driveb="$disksloc/driveb.dsk"
    if [ -e "$driveb" ] && [ ! -L "$driveb" ]; then
        echo "$prog: refusing to replace non-symlink drive B: $driveb" >&2
        return 1
    fi
    ln -sfn "$cpmsim_utilities" "$driveb"
    printf 'driveb.dsk -> %s\n' "$cpmsim_utilities"
}

mount_utilities_c()
{
    if [ ! -f "$cpmsim_companion" ]; then
        echo "$prog: companion Utilities disk not found; run '$prog build' first" >&2
        return 1
    fi
    local drivec="$disksloc/drivec.dsk"
    if [ -e "$drivec" ] && [ ! -L "$drivec" ]; then
        echo "$prog: refusing to replace non-symlink drive C: $drivec" >&2
        return 1
    fi
    ln -sfn "$cpmsim_companion" "$drivec"
    printf 'drivec.dsk -> %s\n' "$cpmsim_companion"
}

