    # Physical host keys from trs80gp Keyboard help; Ctrl punctuation from
    # src/platform/trs80m4/m4cons.inc (BetterCP/M editor-key mapping).
    cat <<'KEYBOARD_HELP'
+--------------------------------------------------------+
| TRS80GP Keyboard Cheat Sheet                           |
|                                                        |
| Set Keyboard -> Physical Layout                        |
| Mac keyboard / BetterCP/M Model 4                      |
|                                                        |
| Character   Press          Character   Press           |
| :           -              =           Shift+=         |
| -           =              *           Shift+-         |
