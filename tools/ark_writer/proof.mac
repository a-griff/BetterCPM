; Isolated ARC stored-member writer CP/M qualification. Not a shipping utility.
 ORG 100H
 JP START
; @definitions@
START:
 LD HL,(6)
 LD DE,IMAGE_END
 OR A
 SBC HL,DE
 JP C,LOW_MEMORY
 LD (OLDSP),SP
 LD SP,STACK_TOP
 LD HL,PAYLOAD
 LD (READ_BASE),HL
 LD HL,OUTPUT
 LD (WRITE_BASE),HL
 LD HL,CONTEXT
 LD DE,CONTEXT+1
 LD BC,AS_CONTEXT_SIZE-1
 LD (HL),0
 LDIR
 LD IX,CONTEXT
 LD (IX+AS_ABI),AS_ABI_VERSION
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,READ_CB
 LD (IX+AS_READ),L
 LD (IX+AS_READ+1),H
 LD HL,BUFFER
 LD (IX+AS_BUFFER),L
 LD (IX+AS_BUFFER+1),H
 LD HL,MEMBER
 LD (IX+AS_ENTRY),L
 LD (IX+AS_ENTRY+1),H
 LD HL,WRITE_CB
 LD (IX+AS_MEMBER+AM_WRITE_CB),L
 LD (IX+AS_MEMBER+AM_WRITE_CB+1),H
 LD HL,NAME
 LD DE,CONTEXT+AS_MEMBER+AM_NAME
 LD BC,11
 LDIR
 LD IX,CONTEXT
 LD A,10
 LD (IX+AS_MEMBER+AM_STORED),A
 LD (IX+AS_MEMBER+AM_LENGTH),A
 LD A,2
 LD (IX+AS_MEMBER+AM_STORED+1),A
 LD (IX+AS_MEMBER+AM_LENGTH+1),A
 LD A,(CRC_VALUE)
 LD (IX+AS_MEMBER+AM_CRC),A
 LD A,(CRC_VALUE+1)
 LD (IX+AS_MEMBER+AM_CRC+1),A
 LD A,2
 LD (IX+AS_MEMBER+AM_METHOD),A
 LD HL,OUTPUT
 LD DE,OUTPUT+1
 LD BC,639
 LD (HL),26
 LDIR
 LD A,1
 LD (FAIL_STAGE),A
 CALL ARK_WRITE_MEMBER
 JP C,FAIL
 LD A,2
 LD (FAIL_STAGE),A
 CALL ARK_WRITE_END
 JP C,FAIL
 LD A,3
 LD (FAIL_STAGE),A
 LD HL,OUT_FCB+12
 LD DE,OUT_FCB+13
 LD BC,23
 LD (HL),0
 LDIR
 LD DE,OUT_FCB
 LD C,22
 CALL 5
 CP 255
 JP Z,FAIL
 LD HL,OUTPUT
 LD (DMA_PTR),HL
 LD A,5
 LD (RECORDS_LEFT),A
WRITE_LOOP:
 LD DE,(DMA_PTR)
 LD C,26
 CALL 5
 LD DE,OUT_FCB
 LD A,4
 LD (FAIL_STAGE),A
 LD C,21
 CALL 5
 OR A
 JP NZ,FAIL
 LD HL,(DMA_PTR)
 LD DE,128
 ADD HL,DE
 LD (DMA_PTR),HL
 LD A,(RECORDS_LEFT)
 DEC A
 LD (RECORDS_LEFT),A
 JR NZ,WRITE_LOOP
 LD A,5
 LD (FAIL_STAGE),A
 LD DE,OUT_FCB
 LD C,16
 CALL 5
 CP 255
 JP Z,FAIL
 ; Native CP/M execution of the production retained-member copy entry.
 LD A,6
 LD (FAIL_STAGE),A
 LD HL,COPY_SOURCE
 LD (READ_BASE),HL
 LD HL,COPY_OUTPUT
 LD (WRITE_BASE),HL
 LD HL,COPY_CONTEXT
 LD DE,COPY_CONTEXT+1
 LD BC,AS_CONTEXT_SIZE-1
 LD (HL),0
 LDIR
 LD IX,COPY_CONTEXT
 LD (IX+AS_ABI),AS_ABI_VERSION
 LD (IX+AS_SIZE),AS_CONTEXT_SIZE
 LD HL,READ_CB
 LD (IX+AS_READ),L
 LD (IX+AS_READ+1),H
 LD HL,COPY_LENGTH
 LD (IX+AS_FILE_SIZE),L
 LD (IX+AS_FILE_SIZE+1),H
 XOR A
 LD (IX+AS_FILE_SIZE+2),A
 LD (IX+AS_FILE_SIZE+3),A
 LD HL,BUFFER
 LD (IX+AS_BUFFER),L
 LD (IX+AS_BUFFER+1),H
 CALL ARK_OPEN
 JP C,FAIL
 LD A,7
 LD (FAIL_STAGE),A
 CALL ARK_NEXT
 JP C,FAIL
 LD HL,BUFFER
 LD (IX+AS_BUFFER),L
 LD (IX+AS_BUFFER+1),H
 LD A,(IX+AS_MEMBER+AM_METHOD)
 CP 9
 JP NZ,FAIL
 LD HL,WRITE_CB
 LD (IX+AS_MEMBER+AM_WRITE_CB),L
 LD (IX+AS_MEMBER+AM_WRITE_CB+1),H
 LD A,8
 LD (FAIL_STAGE),A
 CALL ARK_COPY_MEMBER
 JP C,FAIL
 LD A,9
 LD (FAIL_STAGE),A
 CALL ARK_WRITE_END
 JP C,FAIL
 LD A,10
 LD (FAIL_STAGE),A
 LD HL,COPY_SOURCE
 LD DE,COPY_OUTPUT
 LD BC,COPY_LENGTH
COPY_COMPARE:
 LD A,(DE)
 CP (HL)
 JP NZ,FAIL
 INC DE
 INC HL
 DEC BC
 LD A,B
 OR C
 JR NZ,COPY_COMPARE
 LD IX,CONTEXT
 LD DE,PASS_TEXT
 LD C,9
 CALL 5
 JR RETURN
FAIL:
 LD (FAIL_STATUS),A
 LD DE,FAIL_TEXT
 LD C,9
 CALL 5
 LD A,(FAIL_STAGE)
 CALL HEX
 LD A,(FAIL_STATUS)
 CALL HEX
 LD DE,NL
 LD C,9
 CALL 5
RETURN:
 LD DE,80H
 LD C,26
 CALL 5
 LD SP,(OLDSP)
 RET
LOW_MEMORY:
 LD DE,LOW_TEXT
 LD C,9
 JP 5

; Read the exact callback byte range from the selected in-image source.
READ_CB:
 PUSH IX
 PUSH IY
 PUSH BC
 PUSH DE
 PUSH HL
 LD L,(IX+AS_OFFSET)
 LD H,(IX+AS_OFFSET+1)
 LD DE,(READ_BASE)
 ADD HL,DE
 LD E,(IX+AS_BUFFER)
 LD D,(IX+AS_BUFFER+1)
 LD C,(IX+AS_COUNT)
 LD B,(IX+AS_COUNT+1)
 PUSH BC
 LDIR
 POP BC
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 POP HL
 POP DE
 POP BC
 POP IY
 POP IX
 OR A
 RET

; Append the callback byte range at the writer-supplied output offset.
WRITE_CB:
 PUSH IX
 PUSH IY
 PUSH BC
 PUSH DE
 PUSH HL
 LD L,(IX+AS_MEMBER+AM_OUTPUT_OFFSET)
 LD H,(IX+AS_MEMBER+AM_OUTPUT_OFFSET+1)
 LD DE,(WRITE_BASE)
 ADD HL,DE
 EX DE,HL
 LD L,(IX+AS_BUFFER)
 LD H,(IX+AS_BUFFER+1)
 LD C,(IX+AS_COUNT)
 LD B,(IX+AS_COUNT+1)
 PUSH BC
 LDIR
 POP BC
 LD (IX+AS_ACTUAL),C
 LD (IX+AS_ACTUAL+1),B
 POP HL
 POP DE
 POP BC
 POP IY
 POP IX
 OR A
 RET

HEX:
 PUSH AF
 RRCA
 RRCA
 RRCA
 RRCA
 CALL NIBBLE
 POP AF
NIBBLE:
 AND 15
 ADD A,'0'
 CP '9'+1
 JR C,DIGIT
 ADD A,7
DIGIT:
 LD E,A
 LD C,2
 JP 5

; @code@
PASS_TEXT: DB 'ARK WRITER PASS',13,10,'$'
FAIL_TEXT: DB 'ARK WRITER FAIL ','$'
LOW_TEXT: DB 'ARK WRITER LOW MEMORY',13,10,'$'
NL: DB 13,10,'$'
NAME: DB 'STREAM  BIN'
OUT_FCB: DB 0,'OUT     ','ARC'
 DS 24
CRC_VALUE: DW @CRC@
FAIL_STAGE: DB 0
FAIL_STATUS: DB 0
RECORDS_LEFT: DB 0
READ_POS: DW 0
DMA_PTR: DW 0
OLDSP: DW 0
CONTEXT: DS AS_CONTEXT_SIZE
MEMBER: DS 32
BUFFER: DS 128
PAYLOAD:
@PAYLOAD@
OUTPUT: DS 640
COPY_SOURCE:
@COPY_SOURCE@
COPY_LENGTH EQU @COPY_LENGTH@
COPY_OUTPUT: DS COPY_LENGTH
COPY_CONTEXT: DS AS_CONTEXT_SIZE
READ_BASE: DW 0
WRITE_BASE: DW 0
STACK: DS 512
STACK_TOP:
IMAGE_END:
 END
